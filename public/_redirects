# Canonical trailing-slash redirects (prevents duplicate content)
/jewelry    /jewelry/    301
/studio     /studio/     301
/blog       /blog/       301
/contact    /contact/    301
/glossary   /glossary/   301
/about      /about/      301
/warranty   /warranty/   301
/returns    /returns/    301
/shipping   /shipping/   301
/privacy    /privacy/    301
/reviews    /reviews/    301

# Dropdown-only navbar entries. These have no route of their own, so without
# a rule here they fall through to the SPA catch-all and return the NotFound
# page with HTTP 200 (soft 404, flagged by Search Console as "noindex").
/gallery      /jewelry/    301
/gallery/     /jewelry/    301
/resources    /blog/       301
/resources/   /blog/       301

# Legacy blog slugs. Handled client-side by <Navigate> until now, which
# Googlebot reads as a soft redirect instead of a real 301.
/blog/grawerowanie-laserowe          /blog/grawerowanie-laserowe-przewodnik/          301
/blog/grawerowanie-laserowe/         /blog/grawerowanie-laserowe-przewodnik/          301
/blog/pierscionek-zareczynowy        /blog/pierscionek-zareczynowy-na-zamowienie/     301
/blog/pierscionek-zareczynowy/       /blog/pierscionek-zareczynowy-na-zamowienie/     301

# No SPA catch-all. Every route is prerendered to its own index.html, so
# Cloudflare Pages resolves real pages as static assets and falls through to
# dist/404.html (with a real HTTP 404) for everything else. A catch-all here
# would instead answer dead URLs with HTTP 200, which Google treats as a soft
# 404. scripts/prerender.mjs fails the build if a declared route is missing
# from the prerender list, so this cannot silently drop a live page.
