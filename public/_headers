# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Security headers (all pages)
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # `connect-src` wymienia adresy z nazwy. Wczesniej stalo tu `*.up.railway.app`,
  # czyli zgoda na rozmowe z DOWOLNA aplikacja na Railway, takze cudza. Przy
  # wstrzyknietym skrypcie to gotowa droga wyjscia dla danych.
  # UWAGA: przy wpisywaniu adresow z nazwy zgubil sie `primary-fhhi-production`,
  # pod ktorym stoi przeplyw newslettera, i zapisy przestaly dzialac. Adresy
  # przychodza tu ze zmiennych srodowiskowych Cloudflare (VITE_*), wiec nie widac
  # ich w repozytorium. Dokladajac endpoint, dopisz go TAKZE tutaj.
  # Domeny autopay.eu w form-action i img-src sa konieczne, zeby przegladarka
  # wpuscila formularz platnosci i logotypy kanalow. Bez nich blokuje je po
  # cichu, bez komunikatu, a przycisk platnosci wisi w nieskonczonosc.
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://images.autopay.eu https://testimages.autopay.eu; connect-src 'self' https://aejaca-analytics.aejaca.workers.dev https://cloudflareinsights.com https://primary-production-634f2.up.railway.app https://primary-fhhi-production.up.railway.app https://aejacachatapi-production.up.railway.app; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' mailto: https://pay.autopay.eu https://testpay.autopay.eu
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache immutable hashed assets aggressively (Vite adds content hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Images — cache 30 days + stale-while-revalidate for instant loads during refresh
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Fonts — cache 1 year (woff2 from self-hosted or CDN fallback)
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML — no cache (SPA shell must be fresh for route changes)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
