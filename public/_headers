# Cloudflare Pages custom headers
# https://developers.cloudflare.com/pages/configuration/headers/

# Security headers (all pages)
/*
  # HTML musi byc ODSWIEZANY, i to dotyczy wszystkich stron, nie tylko glownej.
  #
  # Naglowki bezpieczenstwa, w tym polityka CSP, przychodza RAZEM z dokumentem.
  # Gdy dokument siedzi w cache, siedzi tam takze stara polityka, i poprawka
  # wdrozona na serwerze nie dociera do nikogo, kto strone juz odwiedzil.
  # Wczesniej regule mial wylacznie `/index.html`, czyli jedna z dziewiecdziesieciu
  # siedmiu prerenderowanych stron. Zasoby z `/assets`, obrazy i fonty maja
  # wlasne reguly NIZEJ w tym pliku i one wygrywaja, wiec nic nie traci na cache.
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  # `connect-src` wymienia adresy z nazwy. Wczesniej stalo tu `*.up.railway.app`,
  # czyli zgoda na rozmowe z DOWOLNA aplikacja na Railway, takze cudza. Przy
  # wstrzyknietym skrypcie to gotowa droga wyjscia dla danych.
  # UWAGA: przy wpisywaniu adresow z nazwy zgubil sie `primary-fhhi-production`,
  # pod ktorym stoi przeplyw newslettera, i zapisy przestaly dzialac. Adresy
  # przychodza tu ze zmiennych srodowiskowych Cloudflare (VITE_*), wiec nie widac
  # ich w repozytorium. Dokladajac endpoint, dopisz go TAKZE tutaj.
  # Domeny autopay.eu w form-action i img-src sa konieczne, zeby przegladarka
  # wpuscila formularz platnosci i logotypy kanalow. Bez nich blokuje je po
  # cichu, bez komunikatu, a przycisk platnosci wisi w nieskonczonosc.
  #
  # `wasm-unsafe-eval` jest konieczne, bo serwis uruchamia WebAssembly:
  # `occt-import-js` czyta pliki STEP wgrywane przez klienta, a `manifold-3d`
  # buduje bryly w kreatorze. Bez tej dyrektywy przegladarka odmawia
  # kompilacji modulu i oba narzedzia przestaja dzialac. Lokalny serwer
  # statyczny nie stosuje tego pliku, wiec widac to dopiero na produkcji.
  #
  # `unsafe-eval` stoi TUTAJ, w regule ogolnej, i to jest decyzja przemyslana,
  # nie kapitulacja. Dwa poprzednie wdrozenia probowaly poluzowac polityke
  # w wezszej sekcji, raz dla `/assets/*`, raz dla strony kreatora, i oba razy
  # bez skutku, bo Cloudflare stosuje WSZYSTKIE pasujace reguly naraz.
  # Przegladarka dostaje wtedy dwie polityki i egzekwuje ich CZESC WSPOLNA,
  # czyli ostrzejsza. Wezsza regula moze wiec polityke tylko ZAWEZIC.
  # Nigdy poszerzyc. Lokalny serwer naglowek nadpisywal, przez co wygladalo
  # to poprawnie na komputerze i przewracalo sie na produkcji.
  #
  # Dyrektywy potrzebuje szeroki kawalek serwisu, nie jedna strona: kalkulator
  # druku, sprawdzarka drukowalnosci, konfigurator uslugi w sklepie i kreator
  # pierscionkow. Wszedzie tam embind laczy WebAssembly z JavaScriptem przez
  # `new Function`, na co samo `wasm-unsafe-eval` nie wystarcza.
  #
  # Strony platnicze zostaja przy polityce BEZ `unsafe-eval`, w sekcjach nizej.
  # One polityke ogolna zawezaja, wiec dzialaja niezaleznie od tego, jak
  # Cloudflare laczy reguly.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://images.autopay.eu https://testimages.autopay.eu; connect-src 'self' https://aejaca-analytics.aejaca.workers.dev https://cloudflareinsights.com https://primary-production-634f2.up.railway.app https://primary-fhhi-production.up.railway.app https://aejacachatapi-production.up.railway.app; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' mailto: https://pay.autopay.eu https://testpay.autopay.eu
  Cross-Origin-Opener-Policy: same-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Strony platnicze: polityka OSTRZEJSZA niz ogolna, bez `unsafe-eval`.
#
# To sa jedyne adresy, na ktorych klient podaje dane i placi, i zadne z nich
# nie czyta plikow ani nie liczy geometrii, wiec `eval` nie jest tam do niczego
# potrzebny. Reguly ZAWEZAJA polityke ogolna, a nie poszerzaja, wiec dzialaja
# niezaleznie od tego, czy Cloudflare reguly laczy, czy nadpisuje: przy laczeniu
# przegladarka egzekwuje czesc wspolna, czyli te ostrzejsza, a przy nadpisaniu
# wygrywa regula wezsza, czyli znowu ta ostrzejsza.
#
# Reszta dyrektyw musi byc IDENTYCZNA jak w regule ogolnej. Przy laczeniu polityk
# brakujacy adres nie jest pominiety, tylko zabroniony, wiec zgubienie domen
# autopay.eu w `form-action` zatrzymaloby platnosc bez zadnego komunikatu.
/cart*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: blob: https://images.autopay.eu https://testimages.autopay.eu; connect-src 'self' https://aejaca-analytics.aejaca.workers.dev https://cloudflareinsights.com https://primary-production-634f2.up.railway.app https://primary-fhhi-production.up.railway.app https://aejacachatapi-production.up.railway.app; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self' mailto: https://pay.autopay.eu https://testpay.autopay.eu

