# Cache immutable hashed assets aggressively (Vite adds content hash)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
  # CELOWO nie ma tu wlasnej polityki bezpieczenstwa.
  #
  # Watek roboczy bierze polityke z naglowkow WLASNEGO pliku, wiec sekcja
  # wygladala na wlasciwe miejsce. Rzecz w tym, ze do `/assets/*` pasuje
  # takze regula `/*`, a Cloudflare wysyla wtedy OBIE polityki i przegladarka
  # egzekwuje ich czesc wspolna. Polityka pisana tutaj jako szersza dzialala
  # wiec jak wezsza i blokowala dokladnie to, co miala przepuscic.
  #
  # Watek dostaje teraz polityke ogolna, ktora `unsafe-eval` dopuszcza.
  #
  # ZMIENIAJAC POLITYKE, podbij `WORKER_VERSION` w src/workers/*.worker.js.
  # Odpowiedzi spod `/assets/*` leza w cache BRZEGOWYM razem z naglowkami,
  # a nazwa pliku to skrot jego tresci. Plik o niezmienionej tresci wychodzi
  # wiec spod starej nazwy, ze starymi naglowkami, i nowa polityka do niego
  # nie dociera. Nie pomoze ani twarde odswiezenie, ani inna przegladarka,
  # bo cache nie jest po stronie klienta. Kosztowalo nas to jedno wdrozenie.

# Images - cache 30 days + stale-while-revalidate for instant loads during refresh
/*.jpg
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
/*.webp
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400

# Kroje pisma. Od 27 sierpnia 2026 leza u nas, w /fonts, i nazwa pliku niesie
# wersje z Google Fonts, wiec `immutable` na rok jest bezpieczne: aktualizacja
# kroju zmienia nazwe. Regula /fonts/* jest jawna, zeby nie zalezec od tego,
# czy gwiazdka w /*.woff2 przechodzi przez ukosnik.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# HTML - no cache (SPA shell must be fresh for route changes)
/index.html
  Cache-Control: public, max-age=0, must-revalidate
