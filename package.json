{
  "name": "aejaca-site",
  "version": "1.0.0",
  "description": "AEJaCA - Artisan Elegance Jewelry and Crafted Art",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/sync-pricing.mjs --check && node scripts/check-undefined-calls.mjs && node scripts/check-light-theme.mjs && node admin/check-styles.mjs && node scripts/check-shop-images.mjs && node scripts/test-payment-groups.mjs && node scripts/test-customer-fields.mjs && node scripts/test-mesh-formats.mjs && node scripts/derive-service-prices.mjs --check && node scripts/sync-sitemap-shop.mjs --check && node scripts/copy-occt-wasm.mjs && vite build && vite build --ssr src/entry-server.jsx --outDir dist/server && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "vite preview",
    "db:seed-laser-matrix": "node scripts/import-laser-matrix.mjs",
    "db:seed-filaments": "node scripts/seed-filament-types.mjs",
    "db:schema-filaments": "psql $DATABASE_URL -f scripts/filament-schema.sql",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "sync:pricing": "node scripts/sync-pricing.mjs",
    "check:backend": "node scripts/check-undefined-calls.mjs",
    "test:mesh": "node scripts/test-mesh-formats.mjs",
    "prices:derive": "node scripts/derive-service-prices.mjs",
    "sitemap:shop": "node scripts/sync-sitemap-shop.mjs",
    "check:light": "node scripts/check-light-theme.mjs",
    "check:images": "node scripts/check-shop-images.mjs",
    "products:pull": "node scripts/pull-products.mjs",
    "products:seed": "node scripts/seed-products.mjs",
    "db:schema-products": "psql $DATABASE_URL -f scripts/products-schema.sql",
    "db:schema-discounts": "psql $DATABASE_URL -f scripts/discounts-schema.sql"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lucide-react": "^0.536.0",
    "occt-import-js": "^0.0.23",
    "pg": "^8.13.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.18.2",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.11",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "sharp": "^0.34.5",
    "tailwindcss": "^4.1.11",
    "vite": "^6.1.0",
    "xlsx": "^0.18.5"
  }
}
