<%- include('partials/header', { user: user, title: 'Leads', active: 'leads' }) %>

  <main class="max-w-7xl mx-auto px-6 py-8">
    <% if (typeof msg !== "undefined" && msg) { %>
      <div class="mb-4 rounded-xl border border-emerald-700/50 bg-emerald-950/30 px-4 py-3 text-sm text-emerald-200"><%= msg %></div>
    <% } %>
    <% if (typeof err !== "undefined" && err) { %>
      <div class="mb-4 rounded-xl border border-rose-700/50 bg-rose-950/30 px-4 py-3 text-sm text-rose-200"><%= err %></div>
    <% } %>

    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
      <h2 class="text-xl font-semibold text-white">Leads</h2>
      <div class="flex items-center gap-3">
        <form method="POST" action="/leads/bulk-delete" onsubmit="return confirmBulkDeleteLeads(this)">
          <div class="flex items-center gap-1.5">
            <select name="older_than_days" class="bg-neutral-800 border border-white/10 text-neutral-400 text-xs rounded px-2 py-1.5">
              <option value="3">starsze niż 3d</option>
              <option value="30">starsze niż 30d</option>
              <option value="90" selected>starsze niż 90d</option>
              <option value="180">starsze niż 180d</option>
              <option value="365">starsze niż rok</option>
              <option value="all">⚠ wyczyść wszystko</option>
            </select>
            <button data-dymek="Usuń zgłoszenia starsze niż wybrany okres, bez możliwości cofnięcia" type="submit" class="dymek px-2 py-1.5 bg-red-950 border border-red-900/50 text-red-400 hover:text-red-300 text-xs rounded transition-colors">Usuń stare</button>
          </div>
        </form>
        <a href="/export/leads" class="inline-flex items-center gap-2 px-4 py-2 bg-amber-500 hover:bg-amber-400 text-neutral-950 text-sm font-medium rounded-lg transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/>
          </svg>
          Export CSV
        </a>
      </div>
    </div>

    <%
      // Kazdy kafelek jest ODNOSNIKIEM, nie ozdoba: klikniecie zawezá liste do
      // tego, co kafelek liczy. Adres sklada sie tutaj, zeby filtr, kalkulator
      // i kolejnosc nie gubily sie nawzajem przy kazdym kliknieciu.
      const adresListy = (zmiany) => {
        const stan = { filtr, kalkulator, sort, ...zmiany };
        const p = [];
        if (stan.filtr && stan.filtr !== "wszystkie") p.push("filtr=" + encodeURIComponent(stan.filtr));
        if (stan.kalkulator) p.push("kalkulator=" + encodeURIComponent(stan.kalkulator));
        if (stan.sort && stan.sort !== "najnowsze") p.push("sort=" + encodeURIComponent(stan.sort));
        return p.length ? "/leads?" + p.join("&") : "/leads";
      };
      const wybrany = (czy) => czy
        ? "border-white/35 bg-white/[0.06]"
        : "border-white/10 hover:border-white/25";
      const KAFELKI = [
        { klucz: "wszystkie", label: "Wszystkie", ile: wszystkieCount, kolor: "text-amber-400" },
        // "Bez reakcji" to zgloszenia, w ktorych nikt sie nie odezwal i nie ma
        // jeszcze oferty. To one gina najlatwiej, wiec stoja wysoko.
        { klucz: "bez_reakcji", label: "Bez reakcji", ile: bezReakcjiCount, kolor: "text-red-400" },
        { klucz: "nowe", label: "Nowych", ile: newCount, kolor: "text-blue-400" },
        { klucz: "skontaktowane", label: "Skontaktowano", ile: contactedCount, kolor: "text-emerald-400" },
        { klucz: "wycenione", label: "Z ofertą", ile: wycenioneCount, kolor: "text-neutral-300" },
      ];
      const SORTY_LISTY = [
        { id: "najnowsze", label: "Najnowsze" },
        { id: "najstarsze", label: "Najstarsze" },
        { id: "email", label: "Adres" },
        { id: "kalkulator", label: "Źródło" },
      ];
    %>

    <!-- Stats summary -->
    <div class="flex flex-wrap gap-3 mb-3">
      <% KAFELKI.forEach(function (k) { %>
        <a href="<%= adresListy({ filtr: k.klucz }) %>"
           class="bg-neutral-900 border rounded-xl px-4 py-3 flex items-center gap-2 transition-colors <%= wybrany(filtr === k.klucz) %>">
          <span class="text-xs text-neutral-500 uppercase"><%= k.label %></span>
          <span class="text-lg font-semibold <%= k.kolor %>"><%= k.ile %></span>
        </a>
      <% }); %>
    </div>

    <%# Zrodlo zgloszenia jest DRUGIM wymiarem, nie tym samym co stan, wiec
        stoi w osobnym rzedzie i da sie je laczyc: "email" plus "bez reakcji"
        odpowiada na pytanie, na ktore maile jeszcze nie odpisalismy. %>
    <% if (byCalc && byCalc.length > 0) { %>
      <div class="flex flex-wrap gap-2 mb-6 items-center">
        <span class="text-neutral-600 text-[10px] uppercase tracking-wide mr-1">Źródło</span>
        <a href="<%= adresListy({ kalkulator: "" }) %>"
           class="px-2.5 py-1 rounded-lg border text-[11px] transition-colors <%= kalkulator ? 'border-white/10 text-neutral-500 hover:border-white/25' : 'border-white/35 text-white bg-white/5' %>">
          wszystkie
        </a>
        <% byCalc.forEach(function(item) { %>
          <a href="<%= adresListy({ kalkulator: item.calculator === kalkulator ? "" : item.calculator }) %>"
             class="px-2.5 py-1 rounded-lg border text-[11px] transition-colors <%= item.calculator === kalkulator ? 'border-amber-400/40 text-amber-300 bg-amber-400/10' : 'border-white/10 text-neutral-400 hover:border-white/25' %>">
            <%= item.calculator || "bez źródła" %> <span class="text-neutral-500"><%= item.count %></span>
          </a>
        <% }); %>
      </div>
    <% } %>

    <div class="flex flex-wrap gap-2 mb-5 items-center">
      <span class="text-neutral-600 text-[10px] uppercase tracking-wide mr-1">Kolejność</span>
      <% SORTY_LISTY.forEach(function (o) { %>
        <a href="<%= adresListy({ sort: o.id }) %>"
           class="px-2.5 py-1 rounded-lg border text-[11px] transition-colors <%= sort === o.id ? 'border-amber-400/40 text-amber-300 bg-amber-400/10' : 'border-white/10 text-neutral-500 hover:border-white/25' %>">
          <%= o.label %>
        </a>
      <% }); %>
      <%# Ile wierszy widac PO filtrze. Bez tego kafelek mowi 62, lista pokazuje
          36 i nie wiadomo, ktora liczba klamie. %>
      <span class="ml-auto text-neutral-500 text-[11px]">
        widocznych: <strong class="text-neutral-300"><%= total %></strong>
      </span>
    </div>

    <!-- Table -->
    <div class="bg-neutral-900 border border-white/10 rounded-xl overflow-hidden mb-6">
      <div class="overflow-x-auto">
        <table class="w-full text-sm tabela-akcje">
          <thead>
            <tr class="border-b border-white/10 text-neutral-500 text-xs uppercase tracking-wider">
              <th class="px-4 py-3 text-left whitespace-nowrap">Data</th>
              <%# Numer sprawy istnial w bazie od poczatku i nie byl widoczny
                  nigdzie: ani tutaj, ani w potwierdzeniu do klienta. Bez niego
                  nie da sie odpisac na zgloszenie tak, zeby obie strony wiedzialy,
                  o ktorej sprawie mowia. %>
              <th class="px-4 py-3 text-left whitespace-nowrap">Numer</th>
              <th class="px-4 py-3 text-left">Email</th>
              <th class="px-4 py-3 text-left">Źródło</th>
              <th class="px-4 py-3 text-left">Temat</th>
              <th class="px-4 py-3 text-left">Stan</th>
              <th class="px-4 py-3 text-right">Akcje</th>
            </tr>
          </thead>
          <tbody>
            <% if (leads && leads.length > 0) { %>
              <% leads.forEach(function(lead, i) { %>
              <%
                // Tresc zapytania w jednej linijce. Pelna stoi w rozwinieciu:
                // wpisana do komorki rozpychala wiersz na pol ekranu i lista
                // przestawala byc lista.
                var opis = String(lead.description || lead.params || "").replace(/\s+/g, " ").trim();
                var temat = (lead.params_json && lead.params_json.subject) || opis || "";
                var stanEtykiety = { new: "nowe", contacted: "skontaktowano", quoted: "wyceniane", closed: "zamknięte", spam: "spam" };
              %>
              <tr data-wiersz="<%= lead.id %>" data-otworz="<%= lead.id %>"
                  class="border-b border-white/5 hover:bg-white/[0.03] transition-colors cursor-pointer <%= i % 2 === 1 ? 'bg-white/[0.015]' : '' %>">
                <td class="px-4 py-3 text-neutral-400 whitespace-nowrap text-xs"><%= fmtDate(lead.created_at) %></td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <% if (lead.quote_ref) { %>
                    <span class="font-mono text-[11px] text-amber-300"><%= lead.quote_ref %></span>
                  <% } else { %>
                    <span class="text-neutral-600 text-[11px]">bez numeru</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-neutral-200 max-w-[200px] truncate"><%= lead.email %></td>
                <td class="px-4 py-3">
                  <span class="px-2 py-0.5 bg-amber-950 text-amber-300 rounded text-xs font-medium whitespace-nowrap">
                    <%= lead.calculator || "?" %>
                  </span>
                  <span class="text-neutral-600 text-[10px] uppercase ml-1"><%= lead.lang || "" %></span>
                </td>
                <td class="px-4 py-3 text-neutral-400 text-xs max-w-[280px] truncate" title="<%= temat %>"><%= temat %></td>
                <td class="px-4 py-3">
                  <% var stanKlasy = { new: 'bg-blue-950 text-blue-300', contacted: 'bg-amber-950 text-amber-300', quoted: 'bg-emerald-950 text-emerald-300', closed: 'bg-neutral-800 text-neutral-400', spam: 'bg-neutral-800 text-neutral-500' }; %>
                  <span class="px-2 py-0.5 rounded text-xs font-medium <%= stanKlasy[lead.status] || 'bg-neutral-800 text-neutral-400' %>">
                    <%= stanEtykiety[lead.status] || lead.status || "nowe" %>
                  </span>
                  <% if (lead.odrzucony) { %>
                    <span class="ml-1 text-[10px] text-neutral-500">nie lead</span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-right whitespace-nowrap">
                  <%# Jeden znak w wierszu: olowek otwiera. Wszystkie dzialania
                      na tym zgloszeniu stoja w rozwinieciu, wiec lista zostaje
                      lista, a nie tablica przyciskow. %>
                  <button data-dymek="Otwórz zgłoszenie: pełna treść i wszystkie działania" class="dymek" type="button" data-otworz="<%= lead.id %>"
                          class="text-neutral-500 hover:text-white transition-colors"
                          title="Otwórz zgłoszenie">
                    <%- IKONY.olowek %>
                  </button>
                </td>
              </tr>

              <%# ROZWINIECIE. Tresc od klienta do czytania, reszta do zmiany.
                  Zielony fistaszek zapisuje, zawinieta strzalka wycofuje sie
                  bez zmian: te same znaki co w kolejce pracowni, bo znacza to
                  samo. %>
              <tr data-edycja="<%= lead.id %>" class="hidden border-b border-white/10 bg-neutral-950/60">
                <td colspan="7" class="px-4 py-4">
                  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">

                    <div>
                      <h3 class="text-white text-xs font-semibold mb-2">Treść zapytania</h3>
                      <%# Tego pola NIE da sie edytowac i to jest decyzja: zapis
                          tego, co powiedzial klient, poprawiony przez nas
                          przestaje byc dowodem, czego zapytanie dotyczylo. %>
                      <div class="rounded-lg border border-white/10 bg-white/[0.02] px-3 py-2 max-h-64 overflow-y-auto whitespace-pre-wrap text-neutral-300 text-xs leading-relaxed">
<%= lead.description || lead.params || "Bez treści." %>
                      </div>
                      <% if (lead.params_json && typeof lead.params_json === "object") { %>
                        <p class="text-neutral-500 text-[10px] mt-2">
                          <% Object.entries(lead.params_json).forEach(function (e) { %>
                            <span class="mr-2"><%= e[0] %>: <%= e[1] %></span>
                          <% }); %>
                        </p>
                      <% } %>
                      <% if (lead.price_min_pln != null || lead.price_max_pln != null) { %>
                        <p class="text-neutral-500 text-[11px] mt-2">
                          Widełki z kalkulatora: <%= lead.price_min_pln %> - <%= lead.price_max_pln %> PLN
                        </p>
                      <% } %>
                    </div>

                    <div class="space-y-4">
                      <form method="POST" action="/leads/<%= lead.id %>/edit" class="space-y-2">
                        <input type="hidden" name="back" value="<%= adresListy({}) %>" />
                        <div class="grid grid-cols-2 gap-2">
                          <label class="block">
                            <span class="text-neutral-500 text-[10px] block mb-1">Stan</span>
                            <select name="status" class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white">
                              <% ["new", "contacted", "quoted", "closed", "spam"].forEach(function (st) { %>
                                <option value="<%= st %>" <%= (lead.status || "new") === st ? "selected" : "" %>><%= stanEtykiety[st] %></option>
                              <% }); %>
                            </select>
                          </label>
                          <label class="block">
                            <span class="text-neutral-500 text-[10px] block mb-1">Skontaktowano dnia</span>
                            <input type="date" name="contactedAt"
                                   value="<%= lead.contacted_at ? String(fmtDateShort(lead.contacted_at)).slice(0, 10) : '' %>"
                                   class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white" />
                          </label>
                        </div>
                        <label class="block">
                          <span class="text-neutral-500 text-[10px] block mb-1">Notatka, dla nas</span>
                          <textarea name="contactNote" rows="3"
                                    class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-neutral-200"><%= lead.contact_note || "" %></textarea>
                        </label>
                        <div class="flex items-center gap-2">
                          <button data-dymek="Zapisz stan, datę kontaktu i notatkę" class="dymek flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 text-[11px] hover:bg-emerald-400/10 transition-colors">
                            <%- IKONY.fistaszek %> Zapisz
                          </button>
                          <button data-dymek="Zamknij bez zapisywania, pola wracają do zapisanych wartości" class="dymek" type="button" data-zamknij="<%= lead.id %>"
                                  class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-amber-400/40 text-amber-300 text-[11px] hover:bg-amber-400/10 transition-colors">
                            <%- IKONY.cofnij %> Wycofaj
                          </button>
                        </div>
                      </form>

                      <%# Decyzja "lead czy nie lead" wraz z podpowiedzia
                          automatu. Stoi tylko przy zgloszeniach z poczty:
                          formularz ze strony JEST zapytaniem i nie ma tu czego
                          rozstrzygac. %>
                      <% if (lead.watek_id) { %>
                        <div class="rounded-lg border border-white/10 bg-white/[0.02] px-3 py-2">
                          <p class="text-neutral-400 text-[11px] mb-1.5">
                            Wątek mailowy:
                            <strong class="text-neutral-200"><%= lead.watek_tag === "lead" ? "zapytanie" : lead.watek_tag === "spam" ? "spam" : lead.watek_tag === "not_lead" ? "nie zapytanie" : "bez decyzji" %></strong>
                            <% if (lead.watek_tag === "unclassified" && lead.watek_sugestia) { %>
                              <span class="text-neutral-500">, automat typuje: <%= lead.watek_sugestia === "lead" ? "zapytanie" : lead.watek_sugestia === "spam" ? "spam" : "nie zapytanie" %></span>
                            <% } %>
                          </p>
                          <div class="flex flex-wrap gap-1.5">
                            <% [
                              ["lead", "To zapytanie", "Sprawa dostaje numer, a klient potwierdzenie odbioru. Z takiego zgłoszenia robi się ofertę"],
                              ["not_lead", "Nie zapytanie", "Oferty z tego nie zrobimy. Sprawa zostaje w historii, numer też"],
                              ["spam", "Spam", "Znika z domyślnych widoków i nie liczy się jako nieobsłużone"],
                            ].forEach(function (w) { %>
                              <form method="POST" action="/leads/<%= lead.id %>/watek-tag" class="inline-block">
                                <input type="hidden" name="back" value="<%= adresListy({}) %>" />
                                <input type="hidden" name="watekId" value="<%= lead.watek_id %>" />
                                <input type="hidden" name="tag" value="<%= w[0] %>" />
                                <button data-dymek="<%= w[2] %>"
                                        class="dymek px-2.5 py-1 rounded-lg border text-[10px] transition-colors <%= lead.watek_tag === w[0] ? 'border-white/35 text-white bg-white/5' : 'border-white/10 text-neutral-400 hover:border-white/25' %>">
                                  <%= w[1] %>
                                </button>
                              </form>
                            <% }); %>
                          </div>
                        </div>
                      <% } %>

                      <div class="flex items-center gap-2">
                        <% if (lead.odrzucony) { %>
                          <span class="text-[11px] text-neutral-500">Wątek oznaczony jako nie zapytanie, oferty z niego nie robimy.</span>
                        <% } else if (!lead.ma_wycene) { %>
                          <form method="POST" action="/leads/<%= lead.id %>/do-wyceny">
                            <input type="hidden" name="back" value="<%= adresListy({}) %>" />
                            <button data-dymek="Załóż ofertę pod numerem tego zgłoszenia i przepisz do niej treść" class="dymek px-3 py-1.5 rounded-lg border border-amber-700 text-amber-400 text-[11px] hover:bg-amber-950 transition-colors">
                              Zrób wycenę
                            </button>
                          </form>
                        <% } else { %>
                          <span class="text-[11px] text-neutral-500">Oferta pod tym numerem już istnieje.</span>
                        <% } %>
                        <form method="POST" action="/leads/<%= lead.id %>/delete" class="ml-auto"
                              onsubmit="return confirm('Usunąć zgłoszenie <%= lead.quote_ref || lead.id %>? Tego się nie cofa.')">
                          <input type="hidden" name="back" value="<%= adresListy({}) %>" />
                          <button data-dymek="Usuń zgłoszenie na stałe, razem z treścią i numerem sprawy" class="dymek flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-red-400/30 text-red-400 text-[11px] hover:bg-red-400/10 transition-colors">
                            <%- IKONY.krzyzyk %> Usuń
                          </button>
                        </form>
                      </div>
                    </div>

                  </div>
                </td>
              </tr>
              <% }); %>
            <% } else { %>
              <tr>
                <td colspan="7" class="px-4 py-12 text-center text-neutral-600">
                  Nic tu nie ma. Zmień filtr albo poczekaj na zgłoszenie.
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if (pages > 1) { %>
    <div class="flex items-center justify-between">
      <span class="text-sm text-neutral-500">Page <%= page %> of <%= pages %></span>
      <div class="flex gap-2">
        <% if (page > 1) { %>
        <a href="<%= adresListy({}) %><%= adresListy({}).includes("?") ? "&" : "?" %>page=<%= page - 1 %>" class="px-4 py-2 bg-neutral-900 border border-white/10 rounded-lg text-sm text-neutral-300 hover:text-white hover:border-white/20 transition-colors">
          &larr; Prev
        </a>
        <% } else { %>
        <span class="px-4 py-2 bg-neutral-900 border border-white/5 rounded-lg text-sm text-neutral-700 cursor-not-allowed">
          &larr; Prev
        </span>
        <% } %>

        <% if (page < pages) { %>
        <a href="<%= adresListy({}) %><%= adresListy({}).includes("?") ? "&" : "?" %>page=<%= page + 1 %>" class="px-4 py-2 bg-neutral-900 border border-white/10 rounded-lg text-sm text-neutral-300 hover:text-white hover:border-white/20 transition-colors">
          Next &rarr;
        </a>
        <% } else { %>
        <span class="px-4 py-2 bg-neutral-900 border border-white/5 rounded-lg text-sm text-neutral-700 cursor-not-allowed">
          Next &rarr;
        </span>
        <% } %>
      </div>
    </div>
    <% } %>

  </main>

  <script>
    // Rozwijanie wiersza. Wszystko na gotowym drzewie: kazdy formularz stoi
    // w HTML od poczatku, wiec przy wylaczonym skrypcie widac cala liste,
    // a nie pusta strone.
    (function () {
      var pokaz = function (id, czy) {
        var wiersz = document.querySelector('[data-edycja="' + id + '"]');
        if (wiersz) wiersz.classList.toggle("hidden", !czy);
        return wiersz;
      };

      // Po kazdym zapisie wracamy do tego samego wiersza, otwartego. Numer
      // przychodzi w adresie, bo serwer wie, czego dotyczyla akcja, a strona
      // po przeladowaniu juz nie.
      var doOtwarcia = new URLSearchParams(location.search).get("otwarte");
      if (doOtwarcia) {
        pokaz(doOtwarcia, true);
        var kotwica = document.querySelector('[data-wiersz="' + doOtwarcia + '"]');
        if (kotwica) kotwica.scrollIntoView({ block: "center" });
      }

      document.addEventListener("click", function (e) {
        // Zawinieta strzalka: zostaw, jak bylo. Formularz wraca do wartosci
        // z bazy, zamiast zostawac z polowicznie wpisana zmiana.
        var zamknij = e.target.closest("[data-zamknij]");
        if (zamknij) {
          var id = zamknij.getAttribute("data-zamknij");
          var formularz = zamknij.closest("form");
          if (formularz) formularz.reset();
          pokaz(id, false);
          return;
        }
        var otworz = e.target.closest("[data-otworz]");
        if (!otworz) return;
        // Klikniecie w odnosnik albo w przycisk w srodku wiersza ma robic to,
        // po co tam stoi, a nie zwijac wiersz pod palcem.
        if (e.target.closest("a, button[type=submit], form")) return;
        var id = otworz.getAttribute("data-otworz");
        var wiersz = document.querySelector('[data-edycja="' + id + '"]');
        if (wiersz) pokaz(id, wiersz.classList.contains("hidden"));
      });
    })();

    function confirmBulkDeleteLeads(form) {
      const val = form.querySelector('[name="older_than_days"]').value;
      if (val === 'all') return confirm('UWAGA: Usunąć WSZYSTKIE zgłoszenia?\n\nTej operacji nie można cofnąć.');
      return confirm('Usunąć zgłoszenia starsze niż ' + val + ' dni?');
    }
  </script>

</body>
