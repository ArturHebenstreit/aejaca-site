<%- include('partials/header', { user: user, title: 'Dashboard', active: 'dashboard' }) %>

  <main class="max-w-7xl mx-auto px-6 py-8">

    <h2 class="text-xl font-semibold text-white mb-6">Overview</h2>

    <!-- Stats cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">

      <!-- Leads total -->
      <div class="bg-neutral-900 border border-white/10 rounded-xl px-5 py-4">
        <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Total Leads</p>
        <p class="text-3xl font-bold text-amber-400"><%= leadStats.total %></p>
      </div>

      <!-- Leads today / week -->
      <div class="bg-neutral-900 border border-white/10 rounded-xl px-5 py-4">
        <p class="text-xs text-neutral-500 uppercase tracking-wider mb-2">Leads - Recent</p>
        <div class="flex gap-4">
          <div>
            <p class="text-xl font-bold text-white"><%= leadStats.today %></p>
            <p class="text-xs text-neutral-500 mt-0.5">Today</p>
          </div>
          <div class="border-l border-white/10 pl-4">
            <p class="text-xl font-bold text-white"><%= leadStats.week %></p>
            <p class="text-xs text-neutral-500 mt-0.5">This week</p>
          </div>
        </div>
      </div>

      <!-- Subscribers total -->
      <div class="bg-neutral-900 border border-white/10 rounded-xl px-5 py-4">
        <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Total Subscribers</p>
        <p class="text-3xl font-bold text-blue-400"><%= subStats.total %></p>
      </div>

      <!-- Subscribers today / week -->
      <div class="bg-neutral-900 border border-white/10 rounded-xl px-5 py-4">
        <p class="text-xs text-neutral-500 uppercase tracking-wider mb-2">Subscribers - Recent</p>
        <div class="flex gap-4">
          <div>
            <p class="text-xl font-bold text-white"><%= subStats.today %></p>
            <p class="text-xs text-neutral-500 mt-0.5">Today</p>
          </div>
          <div class="border-l border-white/10 pl-4">
            <p class="text-xl font-bold text-white"><%= subStats.week %></p>
            <p class="text-xs text-neutral-500 mt-0.5">This week</p>
          </div>
        </div>
      </div>

      <!-- Laser Matrix -->
      <div class="bg-neutral-900 border border-white/10 rounded-xl px-5 py-4">
        <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Laser Matrix</p>
        <p class="text-3xl font-bold text-cyan-400"><%= laserMatrixCount %></p>
        <a href="/laser-matrix" class="text-xs text-neutral-500 hover:text-cyan-400 transition-colors mt-1 inline-block">wierszy &rarr;</a>
      </div>

      <!-- Gemstone Prices -->
      <div class="bg-neutral-900 border border-white/10 rounded-xl px-5 py-4">
        <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Gemstone Prices</p>
        <p class="text-3xl font-bold text-amber-400"><%= gemstoneCount %></p>
        <a href="/gemstone-prices" class="text-xs text-neutral-500 hover:text-amber-400 transition-colors mt-1 inline-block">kamieni &rarr;</a>
      </div>

      <!-- Filamenty -->
      <div class="bg-neutral-900 border border-white/10 rounded-xl px-5 py-4">
        <div class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Filamenty</div>
        <div class="text-2xl font-bold text-white"><%= filamentCount %></div>
        <div class="text-xs text-neutral-400 mt-1">typów w bazie</div>
        <% if (pendingContributions > 0) { %>
          <div class="mt-2 text-xs text-amber-400">&#9889; <%= pendingContributions %> oczekuje weryfikacji</div>
        <% } %>
        <a href="/filaments" class="block mt-3 text-xs text-blue-400 hover:text-blue-300">Zarządzaj &rarr;</a>
      </div>

    </div>

    <!-- Analytics snapshot -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base font-semibold text-white">Analytics - 7 dni</h3>
        <a href="/analytics" class="text-xs text-emerald-400 hover:text-emerald-300 transition-colors">Pełna analityka &rarr;</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3">
        <div class="bg-neutral-900 border border-white/10 rounded-xl px-4 py-3">
          <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Odwiedziny dziś</p>
          <p class="text-2xl font-bold text-emerald-400"><%= analyticsKpi.visitors_today || 0 %></p>
        </div>
        <div class="bg-neutral-900 border border-white/10 rounded-xl px-4 py-3">
          <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Odwiedziny 7d</p>
          <p class="text-2xl font-bold text-emerald-400"><%= analyticsKpi.visitors_week || 0 %></p>
        </div>
        <div class="bg-neutral-900 border border-white/10 rounded-xl px-4 py-3">
          <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Pageviews dziś</p>
          <p class="text-2xl font-bold text-white"><%= analyticsKpi.pageviews_today || 0 %></p>
        </div>
        <div class="bg-neutral-900 border border-white/10 rounded-xl px-4 py-3">
          <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Pageviews 7d</p>
          <p class="text-2xl font-bold text-white"><%= analyticsKpi.pageviews_week || 0 %></p>
        </div>
        <div class="bg-neutral-900 border border-white/10 rounded-xl px-4 py-3">
          <p class="text-xs text-neutral-500 uppercase tracking-wider mb-1">Zapytania 7d</p>
          <p class="text-2xl font-bold text-amber-400"><%= analyticsKpi.inquiries_week || 0 %></p>
          <% if (analyticsKpi.top_page_today) { %>
          <p class="text-xs text-neutral-600 mt-1 truncate" title="<%= analyticsKpi.top_page_today %>">Top: <%= analyticsKpi.top_page_today %></p>
          <% } %>
        </div>
      </div>
    </section>

    <!-- Moj wlasny ruch -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base font-semibold text-white">Mój ruch na stronie</h3>
        <a href="/analytics" class="text-xs text-emerald-400 hover:text-emerald-300 transition-colors">Analityka &rarr;</a>
      </div>
      <div class="bg-neutral-900 border border-white/10 rounded-xl px-5 py-4">
        <div class="flex items-start gap-3">
          <span class="mt-1.5 w-2.5 h-2.5 rounded-full shrink-0 <%= wlasnyRuch.ostatnie ? 'bg-emerald-400' : 'bg-neutral-600' %>"></span>
          <div class="flex-1">
            <% if (wlasnyRuch.ostatnie) { %>
              <p class="text-sm text-neutral-200">
                Znacznik działa: w ciągu 7 dni przyszło <strong class="text-white"><%= wlasnyRuch.zdarzenia_7d || 0 %></strong>
                zdarzeń z <strong class="text-white"><%= wlasnyRuch.wizyty_7d || 0 %></strong> Twoich wizyt.
              </p>
              <p class="text-xs text-neutral-500 mt-1">
                Ostatnie oznaczone wejście: <%= fmtDate(wlasnyRuch.ostatnie) %><% if (wlasnyRuch.ostatnie_urzadzenie) { %>, urządzenie: <%= wlasnyRuch.ostatnie_urzadzenie %><% } %>.
                Analityka tego ruchu nie liczy.
              </p>
            <% } else { %>
              <p class="text-sm text-neutral-200">Żadne wejście nie jest jeszcze oznaczone jako Twoje.</p>
              <p class="text-xs text-neutral-500 mt-1">
                Dopóki nie oznaczysz swoich przeglądarek, Twoje wizyty liczą się jako ruch klientów.
              </p>
            <% } %>

            <div class="mt-3">
              <a href="<%= SITE_URL %>/?nolicz=stan" target="_blank" rel="noopener"
                 class="inline-block px-4 py-2 rounded-lg bg-emerald-400/10 border border-emerald-400/30 text-emerald-300 text-xs font-medium hover:bg-emerald-400/20 transition-colors">
                Mój ruch: sprawdź i przełącz &rarr;
              </a>
            </div>

            <p class="text-xs text-neutral-500 mt-3 leading-relaxed">
              Przycisk otwiera stronę i pokazuje na niej jeden klawisz: zielony, gdy ten ruch jest liczony,
              czerwony, gdy nie jest. Kliknięcie go przestawia. Odpowiedź i przełącznik to ta sama rzecz,
              więc nie da się ich rozjechać. Przycisk prowadzi na stronę, bo znacznik siedzi w pamięci przeglądarki pod adresem
              aejaca.com, a panel stoi pod innym adresem i tej pamięci nie odczyta.
              Ustawia się go osobno w każdej przeglądarce i na każdym urządzeniu:
              Mac Studio, iPhone i Dell to trzy osobne ustawienia. Tryb prywatny kasuje znacznik razem z oknem.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- Recent Leads -->
    <section class="mb-10">
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base font-semibold text-white">Recent Leads</h3>
        <a href="/leads" class="text-xs text-amber-400 hover:text-amber-300 transition-colors">View all &rarr;</a>
      </div>
      <div class="bg-neutral-900 border border-white/10 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/10 text-neutral-500 text-xs uppercase tracking-wider">
                <th class="px-4 py-3 text-left">Date</th>
                <th class="px-4 py-3 text-left">Email</th>
                <th class="px-4 py-3 text-left">Calculator</th>
                <th class="px-4 py-3 text-left">Params</th>
                <th class="px-4 py-3 text-right">Price (PLN)</th>
                <th class="px-4 py-3 text-left">Status</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentLeads && recentLeads.length > 0) { %>
                <% recentLeads.forEach(function(lead) { %>
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                  <td class="px-4 py-3 text-neutral-400 whitespace-nowrap">
                    <%= fmtDate(lead.created_at) %>
                  </td>
                  <td class="px-4 py-3 text-neutral-200 max-w-[180px] truncate">
                    <%= lead.email %>
                  </td>
                  <td class="px-4 py-3">
                    <span class="px-2 py-0.5 bg-amber-950 text-amber-300 rounded text-xs font-medium">
                      <%= lead.calculator %>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-neutral-400 text-xs max-w-[200px]">
                    <% if (lead.params) { %>
                      <% try { %>
                        <% var p = typeof lead.params === 'string' ? JSON.parse(lead.params) : lead.params; %>
                        <span class="truncate block"><%= Object.entries(p).map(function(e){ return e[0]+': '+e[1]; }).join(', ') %></span>
                      <% } catch(e) { %>
                        <%= lead.params %>
                      <% } %>
                    <% } else { %>
                      <span class="text-neutral-600"> - </span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3 text-right text-neutral-200 whitespace-nowrap">
                    <% if (lead.price_min_pln && lead.price_max_pln) { %>
                      <%= lead.price_min_pln %>–<%= lead.price_max_pln %>
                    <% } else { %>
                      <span class="text-neutral-600"> - </span>
                    <% } %>
                  </td>
                  <td class="px-4 py-3">
                    <% var statusMap = { new: 'bg-blue-950 text-blue-300', contacted: 'bg-amber-950 text-amber-300', closed: 'bg-emerald-950 text-emerald-300', spam: 'bg-neutral-800 text-neutral-500' }; %>
                    <% var statusClass = statusMap[lead.status] || 'bg-neutral-800 text-neutral-400'; %>
                    <span class="px-2 py-0.5 rounded text-xs font-medium <%= statusClass %>">
                      <%= lead.status || 'new' %>
                    </span>
                  </td>
                </tr>
                <% }); %>
              <% } else { %>
              <tr>
                <td colspan="6" class="px-4 py-8 text-center text-neutral-600">No leads yet.</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- Recent Subscribers -->
    <section>
      <div class="flex items-center justify-between mb-3">
        <h3 class="text-base font-semibold text-white">Recent Subscribers</h3>
        <a href="/subscribers" class="text-xs text-blue-400 hover:text-blue-300 transition-colors">View all &rarr;</a>
      </div>
      <div class="bg-neutral-900 border border-white/10 rounded-xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full text-sm">
            <thead>
              <tr class="border-b border-white/10 text-neutral-500 text-xs uppercase tracking-wider">
                <th class="px-4 py-3 text-left">Date</th>
                <th class="px-4 py-3 text-left">Email</th>
                <th class="px-4 py-3 text-left">Lang</th>
                <th class="px-4 py-3 text-left">Source</th>
                <th class="px-4 py-3 text-left">Code</th>
              </tr>
            </thead>
            <tbody>
              <% if (recentSubs && recentSubs.length > 0) { %>
                <% recentSubs.forEach(function(sub) { %>
                <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                  <td class="px-4 py-3 text-neutral-400 whitespace-nowrap">
                    <%= fmtDate(sub.subscribed_at) %>
                  </td>
                  <td class="px-4 py-3 text-neutral-200 max-w-[220px] truncate">
                    <%= sub.email %>
                  </td>
                  <td class="px-4 py-3">
                    <span class="px-2 py-0.5 bg-blue-950 text-blue-300 rounded text-xs font-medium uppercase">
                      <%= sub.lang || ' - ' %>
                    </span>
                  </td>
                  <td class="px-4 py-3 text-neutral-400 text-xs"><%= sub.source || ' - ' %></td>
                  <td class="px-4 py-3 text-neutral-500 font-mono text-xs"><%= sub.discount_code || ' - ' %></td>
                </tr>
                <% }); %>
              <% } else { %>
              <tr>
                <td colspan="5" class="px-4 py-8 text-center text-neutral-600">No subscribers yet.</td>
              </tr>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>
    </section>

  </main>

  <script>
    function fmtDate(d) {
      if (!d) return ' - ';
      const dt = new Date(d);
      return dt.toLocaleDateString('pl-PL') + ' ' + dt.toLocaleTimeString('pl-PL', { hour: '2-digit', minute: '2-digit' });
    }
    // Re-render dates client-side for correct local timezone display
    document.querySelectorAll('[data-date]').forEach(function(el) {
      el.textContent = fmtDate(el.dataset.date);
    });
  </script>

</body>
</html>
