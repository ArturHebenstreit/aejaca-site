<%- include('partials/header', { user: user, title: material ? `Materiał: ${ material.name_pl }` : 'Nowy materiał', active: 'materials' }) %>

  <main class="max-w-2xl mx-auto px-6 py-8">

    <div class="flex items-center gap-3 mb-6">
      <a href="/materials" class="text-neutral-500 hover:text-white transition-colors text-sm">&larr; Wróć do listy</a>
    </div>

    <h2 class="text-xl font-semibold text-white mb-2">
      <%= material ? 'Edytuj materiał' : 'Nowy materiał' %>
    </h2>
    <% if (material) { %>
      <p class="text-xs text-neutral-500 mb-6 font-mono">material_id: <span class="text-amber-400"><%= material.material_id %></span></p>
    <% } else { %>
      <p class="text-xs text-neutral-500 mb-6 leading-relaxed">
        Identyfikator musi zgadzać się z pozycją w cenniku lasera (np. <span class="font-mono text-amber-400">acr5</span>,
        <span class="font-mono text-amber-400">ply3</span>), inaczej wycena nie znajdzie stawki i policzy domyślne 100 zł/m².
      </p>
    <% } %>

    <form method="POST" action="<%= material ? `/materials/${material.id}/update` : '/materials/create' %>" class="space-y-5">

      <% if (!material) { %>
        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-wider mb-1.5">Identyfikator (material_id)</label>
          <input type="text" name="material_id" required placeholder="np. acr5"
            class="w-full bg-neutral-800 border border-white/10 rounded-lg px-3 py-2 text-sm text-white font-mono focus:outline-none focus:border-amber-400/50 transition-colors" />
        </div>
      <% } %>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-wider mb-1.5">Nazwa (PL)</label>
          <input type="text" name="name_pl" value="<%= material ? material.name_pl : '' %>" required
            class="w-full bg-neutral-800 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50 transition-colors" />
        </div>
        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-wider mb-1.5">Nazwa (EN)</label>
          <input type="text" name="name_en" value="<%= material ? material.name_en : '' %>"
            class="w-full bg-neutral-800 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50 transition-colors" />
        </div>
        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-wider mb-1.5">Nazwa (DE)</label>
          <input type="text" name="name_de" value="<%= material ? material.name_de : '' %>"
            class="w-full bg-neutral-800 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50 transition-colors" />
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-wider mb-1.5">Cena za m² (PLN)</label>
          <input type="number" step="0.01" min="0" name="pln_per_m2"
            value="<%= material ? parseFloat(material.pln_per_m2) : 100 %>" required
            class="w-full bg-neutral-800 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50 transition-colors" />
          <p class="text-[11px] text-neutral-600 mt-2 leading-relaxed">
            Wycena liczy: pole wyrobu &times; 1,15 (zapas na odpad) &times; ta stawka. Doliczana tylko wtedy,
            gdy materiał pochodzi z naszego magazynu.
          </p>
        </div>
        <div>
          <label class="block text-xs text-neutral-400 uppercase tracking-wider mb-1.5">Grubość (mm, opcjonalnie)</label>
          <input type="number" step="0.1" min="0" name="thickness_mm"
            value="<%= material && material.thickness_mm != null ? parseFloat(material.thickness_mm) : '' %>"
            class="w-full bg-neutral-800 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50 transition-colors" />
        </div>
      </div>

      <div>
        <label class="flex items-center gap-2 text-sm text-neutral-300">
          <input type="checkbox" name="in_stock" <%= !material || material.in_stock ? 'checked' : '' %>
            class="rounded border-white/20 bg-neutral-800" />
          Mamy na stanie
        </label>
      </div>

      <div>
        <label class="block text-xs text-neutral-400 uppercase tracking-wider mb-1.5">Notatka</label>
        <textarea name="notes" rows="3"
          class="w-full bg-neutral-800 border border-white/10 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-amber-400/50 transition-colors"><%= material ? (material.notes || '') : '' %></textarea>
      </div>

      <div class="flex items-center gap-3 pt-2">
        <button type="submit" class="px-4 py-2 rounded-lg bg-blue-500 hover:bg-blue-400 text-white text-sm transition-colors">
          <%= material ? 'Zapisz' : 'Dodaj' %>
        </button>
        <a href="/materials" class="text-neutral-500 hover:text-white text-sm transition-colors">Anuluj</a>
      </div>

    </form>

  </main>

</body>
</html>
