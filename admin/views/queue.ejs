<%- include('partials/header', { user: user, title: 'Kolejka', active: 'queue' }) %>

<%
  const STAN = {
    paid: { label: "Do zrobienia", klasa: "text-amber-300 border-amber-400/30 bg-amber-400/10" },
    // Zaplacone, ale zegar STOI: czekamy na ustalenia z klientem. Ten etap
    // nie ma terminu, wiec bez wlasnego miejsca w kolejce nie odezwalby sie
    // znikad i to on gubilby zlecenia najlatwiej.
    details: { label: "Ustalanie szczegółów", klasa: "text-purple-300 border-white/15 bg-white/5" },
    in_production: { label: "W robocie", klasa: "text-sky-300 border-sky-400/30 bg-sky-400/10" },
    ready: { label: "Zrealizowane", klasa: "text-emerald-300 border-emerald-400/30 bg-emerald-400/10" },
    shipped: { label: "Wysłane", klasa: "text-indigo-300 border-indigo-400/30 bg-indigo-400/10" },
    completed: { label: "Zakończone", klasa: "text-emerald-300 border-emerald-400/30 bg-emerald-400/10" },
    cancelled: { label: "Anulowane", klasa: "text-neutral-400 border-white/15 bg-white/5" },
  };
  // Adres powrotu niosa wszystkie formularze, zeby po zapisie nie wypasc
  // z filtra na domyslna liste i nie szukac wiersza od nowa.
  const POWROT = stan ? "/queue?status=" + encodeURIComponent(stan) : "/queue";
  const FILTRY = [
    { stan: "", label: "W toku" },
    { stan: "completed", label: "Zakończone" },
    { stan: "cancelled", label: "Anulowane" },
    { stan: "paid,details,in_production,ready,shipped,completed,cancelled", label: "Wszystko" },
  ];
  const DOSTAWA = {
    pickup: "Odbiór osobisty",
    inpost_locker: "Paczkomat InPost",
    courier: "Kurier",
    digital: "Plik do pobrania",
  };
  // Kolejnosc grup od pracy do zamkniecia. Wewnatrz kazdej kolejnosc daje
  // serwer, po dacie zaplaty, i widok jej nie rusza.
  const GRUPY = ["details", "paid", "in_production", "ready", "shipped", "completed", "cancelled"];
%>

  <main class="max-w-5xl mx-auto px-6 py-8">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-white mb-2">Kolejka pracowni</h1>
      <p class="text-neutral-500 text-xs leading-relaxed max-w-3xl">
        Wszystko, co opłacone i jeszcze nieskończone, w kolejności wpłat: kto pierwszy zapłacił, ten pierwszy
        dostaje. Zamówienia ze sklepu i z ofert ustalonych mailem albo telefonicznie stoją tu razem, bo dla
        warsztatu niczym się nie różnią. Etap zmienia się tylko do przodu i tylko z dozwolonego stanu.
        Pomyłkę poprawia się osobno, w sekcji „Popraw wiersz", która potrafi też cofnąć etap.
      </p>
    </div>

    <div class="flex flex-wrap gap-2 mb-5">
      <% FILTRY.forEach(function (f) { %>
        <a href="<%= f.stan ? '/queue?status=' + encodeURIComponent(f.stan) : '/queue' %>"
           class="px-3 py-1.5 rounded-lg border text-xs transition-colors <%= stan === f.stan ? 'border-white/35 text-white bg-white/5' : 'border-white/10 text-neutral-400 hover:border-white/25' %>">
          <%= f.label %>
        </a>
      <% }); %>
    </div>

    <% if (err) { %>
      <div class="rounded-lg border border-red-400/30 bg-red-400/10 p-3 mb-5 text-red-300 text-xs leading-relaxed"><%= err %></div>
    <% } %>
    <% if (msg) { %>
      <div class="rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-3 mb-5 text-emerald-300 text-xs"><%= msg %></div>
    <% } %>

    <% if (!orders.length) { %>
      <div class="rounded-xl border border-dashed border-white/15 bg-white/[0.02] px-6 py-10 text-center text-neutral-500 text-sm">
        Nic nie czeka. Wszystko opłacone jest zrobione i zamknięte.
      </div>
    <% } %>

    <% GRUPY.forEach(function (grupa) { %>
      <% const wGrupie = orders.filter(function (o) { return o.status === grupa; }); %>
      <% if (wGrupie.length) { %>
        <section class="mb-8">
          <h2 class="text-sm font-semibold text-white mb-3">
            <%= STAN[grupa].label %> <span class="text-neutral-600 font-normal">(<%= wGrupie.length %>)</span>
          </h2>

          <div class="space-y-3">
            <% wGrupie.forEach(function (o) { %>
              <div class="rounded-xl border border-white/10 bg-white/[0.02] p-5">

                <div class="flex flex-wrap items-start justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                      <span class="font-mono text-sm text-white"><%= o.orderRef %></span>
                      <% if (o.quoteRef) { %>
                        <a href="/quotes/<%= encodeURIComponent(o.quoteRef) %>" class="font-mono text-[11px] text-amber-300 hover:text-amber-200"><%= o.quoteRef %></a>
                      <% } %>
                      <span class="px-2 py-0.5 rounded border text-[10px] <%= STAN[o.status].klasa %>"><%= STAN[o.status].label %></span>
                    </div>
                    <div class="text-neutral-500 text-xs mt-1">
                      <%= o.name || "(brak nazwiska)" %> &middot; <%= o.email || "brak adresu" %><% if (o.phone) { %> &middot; <%= o.phone %><% } %>
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <div class="text-white font-semibold text-sm"><%= o.totalPLN %> PLN</div>
                    <div class="text-neutral-600 text-[10px]">
                      opłacone <%= fmtDateShort(o.paidAt) %><% if (o.waitingDays != null) { %>, czeka <%= o.waitingDays %> dni<% } %>
                    </div>
                  </div>
                </div>

                <ul class="mt-4 space-y-2">
                  <% o.items.forEach(function (it) { %>
                    <li class="rounded-lg border border-white/10 bg-neutral-950 px-4 py-3">
                      <div class="text-sm text-neutral-200"><%= it.qty %> &times; <%= it.title %></div>
                      <div class="text-neutral-600 text-[10px] mt-0.5">
                        <%= it.calculator || "pozycja bez kalkulatora" %>
                        <% if (it.fileName) { %>
                          &middot;
                          <% if (it.fileUrl) { %>
                            <a href="<%= it.fileUrl %>" target="_blank" rel="noopener" class="text-amber-300 hover:text-amber-200"><%= it.fileName %></a>
                          <% } else { %><%= it.fileName %><% } %>
                        <% } %>
                      </div>
                      <% if (it.description) { %>
                        <p class="text-neutral-400 text-xs mt-2 whitespace-pre-wrap"><%= it.description %></p>
                      <% } %>
                    </li>
                  <% }); %>
                </ul>

                <div class="mt-4 text-xs text-neutral-400">
                  <span class="text-neutral-600">Dostawa:</span>
                  <%= DOSTAWA[o.delivery.method] || o.delivery.method || "nie wybrano" %>
                  <% if (o.delivery.point) { %> &middot; <span class="font-mono"><%= o.delivery.point %></span><% } %>
                  <% if (o.delivery.addressLine1) { %>
                    &middot; <%= o.delivery.addressLine1 %><% if (o.delivery.addressLine2) { %>, <%= o.delivery.addressLine2 %><% } %>,
                    <%= o.delivery.postalCode %> <%= o.delivery.city %>, <%= o.delivery.country %>
                  <% } %>
                  <% if (o.trackingNumber) { %>
                    <span class="block mt-1"><span class="text-neutral-600">List przewozowy:</span> <span class="font-mono text-neutral-300"><%= o.trackingNumber %></span></span>
                  <% } %>
                  <% if (o.productionNote) { %>
                    <span class="block mt-1 text-neutral-500">Notatka: <%= o.productionNote %></span>
                  <% } %>
                </div>

                <%# TERMIN REALIZACJI. Zegar biegnie WYLACZNIE w etapie
                    "Zlecenie w realizacji": w ustalaniu szczegolow czekamy na
                    klienta, a nie on na nas. %>
                <% if (o.deadlineAt || o.leadDays) { %>
                  <div class="mt-3 text-xs">
                    <% if (o.status === "details") { %>
                      <span class="text-sky-300">Ustalanie szczegółów</span>
                      <span class="text-neutral-500">
                        &middot; zegar stoi<% if (o.leadDays) { %>, po ustaleniach ruszy <%= o.leadDays %> dni<% } %>
                      </span>
                    <% } else if (o.deadlineAt) { %>
                      <span class="text-neutral-600">Termin:</span>
                      <span class="font-mono text-neutral-300"><%= String(o.deadlineAt).slice(0, 10) %></span>
                      <% if (o.daysLeft != null && o.status !== "shipped" && o.status !== "completed") { %>
                        <span class="<%= o.daysLeft < 0 ? 'text-red-300' : o.daysLeft <= 3 ? 'text-amber-300' : 'text-neutral-500' %>">
                          &middot; <%= o.daysLeft < 0 ? Math.abs(o.daysLeft) + " dni po terminie"
                                    : o.daysLeft === 0 ? "dzisiaj" : "za " + o.daysLeft + " dni" %>
                        </span>
                      <% } %>
                    <% } %>
                  </div>
                <% } %>

                <div class="mt-4 flex flex-wrap items-end gap-3">
                  <% if (o.status === "details") { %>
                    <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage" class="flex items-end gap-2">
                      <input type="hidden" name="back" value="<%= POWROT %>" />
                      <input type="hidden" name="stage" value="in_production" />
                      <input name="note" placeholder="co ustalone (opcjonalnie)"
                             class="w-64 rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                      <button class="px-4 py-2 rounded-lg bg-amber-400 text-neutral-950 text-sm font-medium hover:bg-amber-300 transition-colors">
                        Szczegóły ustalone, startuj termin
                      </button>
                    </form>
                  <% } %>

                  <% if (o.status === "paid") { %>
                    <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage" class="flex items-end gap-2">
                      <input type="hidden" name="back" value="<%= POWROT %>" />
                      <input type="hidden" name="stage" value="in_production" />
                      <input name="note" placeholder="notatka do pracowni (opcjonalnie)"
                             class="w-64 rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                      <button class="px-4 py-2 rounded-lg bg-amber-400 text-neutral-950 text-sm font-medium hover:bg-amber-300 transition-colors">
                        Biorę do roboty
                      </button>
                    </form>
                  <% } %>

                  <% if (o.status === "in_production") { %>
                    <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage">
                      <input type="hidden" name="back" value="<%= POWROT %>" />
                      <input type="hidden" name="stage" value="ready" />
                      <button class="px-4 py-2 rounded-lg border border-emerald-400/30 text-emerald-300 text-sm hover:border-emerald-400/60 transition-colors">
                        Zrealizowane
                      </button>
                    </form>
                  <% } %>

                  <% if (["paid", "details", "in_production", "ready"].includes(o.status)) { %>
                    <%# Odbior osobisty konczy sie przekazaniem, a nie wysylka:
                        wtedy nie ma listu przewozowego i nie ma go czego pytac. %>
                    <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage" class="flex items-end gap-2">
                      <input type="hidden" name="back" value="<%= POWROT %>" />
                      <input type="hidden" name="stage" value="shipped" />
                      <% if (o.delivery.method !== "pickup") { %>
                        <label class="block">
                          <span class="text-neutral-500 text-[10px] block mb-1">List przewozowy</span>
                          <input name="trackingNumber" placeholder="numer przesyłki"
                                 class="w-48 rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white font-mono" />
                        </label>
                      <% } %>
                      <label class="block">
                        <span class="text-neutral-500 text-[10px] block mb-1">Data<%= o.delivery.method === "pickup" ? " przekazania" : " nadania" %></span>
                        <%# Puste pole znaczy "dzisiaj". Paczka bywa nadana wczoraj,
                            a zaznaczona dzisiaj, i wtedy termin wygladalby na
                            przekroczony o dzien. %>
                        <input name="shippedOn" type="date"
                               class="w-48 rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                      </label>
                      <button class="px-4 py-2 rounded-lg border border-white/15 text-neutral-200 text-sm hover:border-white/35 transition-colors">
                        <%= o.delivery.method === "pickup" ? "Przekazane" : "Wysłane" %>
                      </button>
                    </form>
                  <% } %>

                  <% if (o.status === "in_production" || o.status === "ready" || o.status === "shipped") { %>
                    <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage">
                      <input type="hidden" name="back" value="<%= POWROT %>" />
                      <input type="hidden" name="stage" value="completed" />
                      <button class="px-4 py-2 rounded-lg border border-emerald-400/30 text-emerald-300 text-sm hover:border-emerald-400/60 transition-colors">
                        Zamknij
                      </button>
                    </form>
                  <% } %>
                </div>

                <details class="mt-4 border-t border-white/10 pt-3">
                  <summary class="text-neutral-500 text-xs cursor-pointer hover:text-neutral-300">Popraw wiersz</summary>

                  <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/edit"
                        class="mt-3 flex flex-wrap items-end gap-3">
                    <input type="hidden" name="back" value="<%= POWROT %>" />
                    <label class="block">
                      <span class="text-neutral-500 text-[10px] block mb-1">Etap</span>
                      <select name="stage" class="rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white">
                        <option value="">bez zmiany</option>
                        <% ["paid", "details", "in_production", "ready", "shipped", "completed"].forEach(function (e) { %>
                          <% if (e !== o.status) { %><option value="<%= e %>"><%= STAN[e].label %></option><% } %>
                        <% }); %>
                      </select>
                    </label>
                    <label class="block">
                      <span class="text-neutral-500 text-[10px] block mb-1">List przewozowy</span>
                      <input name="trackingNumber" value="<%= o.trackingNumber || '' %>" placeholder="puste pole kasuje"
                             class="w-48 rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white font-mono" />
                    </label>
                    <label class="block flex-1 min-w-[16rem]">
                      <span class="text-neutral-500 text-[10px] block mb-1">Notatka do pracowni</span>
                      <input name="note" value="<%= o.productionNote || '' %>" placeholder="puste pole kasuje"
                             class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                    </label>
                    <button class="px-4 py-2 rounded-lg border border-white/15 text-neutral-200 text-sm hover:border-white/35 transition-colors">
                      Zapisz
                    </button>
                  </form>

                  <p class="text-neutral-600 text-[10px] leading-relaxed mt-2">
                    Cofnięcie etapu kasuje stemple tego, co się nie wydarzyło: zamówienie wycofane z „Wysłane"
                    traci datę wysyłki i list przewozowy, bo nic nie wyjechało. Data rozpoczęcia pracy zostaje.
                  </p>

                  <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/delete"
                        class="mt-4 flex flex-wrap items-end gap-3 border-t border-red-400/15 pt-3">
                    <input type="hidden" name="back" value="<%= POWROT %>" />
                    <label class="block">
                      <span class="text-red-300/80 text-[10px] block mb-1">Usuń trwale: przepisz numer</span>
                      <input name="confirmRef" placeholder="<%= o.orderRef %>" autocomplete="off"
                             class="w-56 rounded-lg bg-neutral-900 border border-red-400/25 px-3 py-2 text-xs text-white font-mono" />
                    </label>
                    <button class="px-4 py-2 rounded-lg border border-red-400/30 text-red-300 text-sm hover:border-red-400/60 transition-colors">
                      Usuń zamówienie
                    </button>
                    <p class="text-neutral-600 text-[10px] leading-relaxed w-full">
                      Bez cofnięcia. Znikają pozycje, pliki do pobrania i rezerwacje, wycena wraca do stanu sprzed
                      konwersji, a jednorazowy kod rabatowy wraca do puli. Podpisane komunikaty płatnicze zostają,
                      bo wiążą się z numerem, nie z wierszem. Towar nie wraca na stan.
                    </p>
                  </form>
                </details>

              </div>
            <% }); %>
          </div>
        </section>
      <% } %>
    <% }); %>

  </main>
</body>
</html>
