<%- include('partials/header', { user: user, title: 'Kolejka', active: 'queue' }) %>

<%
  // Etap pracy JEST statusem zamowienia (ADR-0013), wiec ta mapa jest jedynym
  // miejscem, w ktorym stan z bazy dostaje nazwe po polsku. Kolor niesie
  // informacje: bursztyn znaczy "czeka na nas", blekit "robimy", zielen
  // "zrobione", szarosc "juz nie nasze".
  const STAN = {
    // Czekanie na pieniadze JEST czescia kolejki (decyzja wlasciciela,
    // 2026-08-30). Zamowienie w euro stalo dotad na osobnej stronie i w tej
    // tabeli nie bylo go wcale, wiec pierwszy krok zlecenia dzial sie gdzie
    // indziej niz reszta.
    awaiting_transfer: { label: "Czeka na wpłatę", klasa: "text-orange-300 border-orange-400/30 bg-orange-400/10" },
    payment_review: { label: "Płatność do sprawdzenia", klasa: "text-red-300 border-red-400/30 bg-red-400/10" },
    paid: { label: "Zapłacone", klasa: "text-amber-300 border-amber-400/30 bg-amber-400/10" },
    // Zaplacone, ale zegar STOI: czekamy na ustalenia z klientem. Ten etap
    // nie ma terminu, wiec bez wlasnego miejsca w kolejce nie odezwalby sie
    // znikad i to on gubilby zlecenia najlatwiej.
    details: { label: "Ustalanie szczegółów", klasa: "text-purple-300 border-purple-400/30 bg-purple-400/10" },
    // Ustalenia domkniete, praca jeszcze nie ruszyla, ZEGAR JUZ BIEGNIE.
    queued: { label: "Gotowe do pobrania", klasa: "text-amber-300 border-amber-400/30 bg-amber-400/10" },
    in_production: { label: "W realizacji", klasa: "text-sky-300 border-sky-400/30 bg-sky-400/10" },
    ready: { label: "Gotowe", klasa: "text-emerald-300 border-emerald-400/30 bg-emerald-400/10" },
    // Jedna nazwa robocza dla obu drog wydania. Klient na stronie zamowienia
    // czyta dalej "Wysłane" przy kurierze i "Przekazane" przy odbiorze
    // osobistym: to nie sa dwie nazwy jednego stanu, tylko jedna nazwa
    // w pracowni i dwa sposoby powiedzenia tego samego komus, kto czeka.
    shipped: { label: "Przekazane", klasa: "text-indigo-300 border-indigo-400/30 bg-indigo-400/10" },
    completed: { label: "Odebrane", klasa: "text-neutral-300 border-white/15 bg-white/5" },
    cancelled: { label: "Anulowane", klasa: "text-neutral-400 border-white/15 bg-white/5" },
    expired: { label: "Wygasłe", klasa: "text-neutral-400 border-white/15 bg-white/5" },
  };
  // Stany, w ktorych czekamy na pieniadze, a nie na prace. Zegar nie biegnie,
  // termin nie istnieje, a jedyna akcja to potwierdzenie wplaty.
  const PRZED_ZAPLATA = ["awaiting_transfer", "payment_review"];
  // Adres powrotu niosa wszystkie formularze, zeby po zapisie nie wypasc
  // z filtra i z sortowania na domyslna liste i nie szukac wiersza od nowa.
  const PYTANIE = [stan ? "status=" + encodeURIComponent(stan) : "", sort && sort !== "newest" ? "sort=" + encodeURIComponent(sort) : ""].filter(Boolean).join("&");
  const POWROT = PYTANIE ? "/queue?" + PYTANIE : "/queue";
  const adres = (nowyStan, nowySort) => {
    const p = [nowyStan ? "status=" + encodeURIComponent(nowyStan) : "", nowySort && nowySort !== "newest" ? "sort=" + encodeURIComponent(nowySort) : ""].filter(Boolean).join("&");
    return p ? "/queue?" + p : "/queue";
  };
  const FILTRY = [
    { stan: "", label: "W toku" },
    { stan: "awaiting_transfer,payment_review", label: "Czeka na wpłatę" },
    { stan: "shipped", label: "Przekazane" },
    { stan: "completed", label: "Odebrane" },
    // Do 31 sierpnia 2026 filtr nazywal sie "Zamkniete bez zaplaty", bo
    // anulowac dalo sie wylacznie przed wplata. Teraz sprawa wychodzi czterema
    // drogami i na kazdym etapie, wiec stara nazwa mowilaby nieprawde
    // o polowie wierszy.
    { stan: "cancelled,expired", label: "Zamknięte" },
    { stan: "awaiting_transfer,payment_review,paid,details,queued,in_production,ready,shipped,completed,cancelled,expired", label: "Wszystko" },
  ];
  const SORTY = [
    { id: "newest", label: "Najnowsze" },
    { id: "deadline", label: "Po terminie" },
    { id: "oldest", label: "Najstarsze" },
    { id: "amount", label: "Kwota" },
    { id: "name", label: "Nazwisko" },
  ];
  const DOSTAWA = {
    pickup: "Odbiór osobisty",
    inpost_locker: "Paczkomat InPost",
    courier: "Kurier",
    digital: "Plik do pobrania",
  };
  // W wierszu krocej, bo dziewiec kolumn i tak nie miesci sie na laptopie,
  // a przypieta kolumna akcji przykrywa wtedy ostatnia z nich.
  const DOSTAWA_KROTKO = { pickup: "Odbiór", inpost_locker: "Paczkomat", courier: "Kurier", digital: "Plik" };
  // Etapy, w ktorych termin juz biegnie. Ta sama lista co w `productionQueue.js`,
  // bo panel i przypomnienia musza uwazac za spozniona te sama robote.
  const Z_ZEGAREM = ["queued", "in_production", "ready"];
  // POPRZEDNI ETAP, czyli dokad wraca omylkowe klikniecie. Cofanie ma lustrzane
  // odbicie w tym, co doprowadzilo do etapu: te ponizej wynikaja z przyciskow,
  // wiec cofa je przycisk. Wejscie w "gotowe do pobrania" wynika z odhaczenia
  // ustalen, wiec cofa je odznaczenie pozycji, a nie osobna strzalka. Dwa
  // sposoby na to samo rozjechalyby sie przy pierwszej pozycji.
  const COFNIJ_DO = {
    in_production: "queued",
    ready: "in_production",
    shipped: "ready",
    completed: "shipped",
  };
  const zostalo = (o) => {
    if (o.daysLeft == null || !Z_ZEGAREM.includes(o.status)) return null;
    if (o.daysLeft < 0) return { tekst: Math.abs(o.daysLeft) + " dni po terminie", klasa: "text-red-300" };
    if (o.daysLeft === 0) return { tekst: "dzisiaj", klasa: "text-amber-300" };
    return { tekst: "za " + o.daysLeft + " dni", klasa: o.daysLeft <= 3 ? "text-amber-300" : "text-neutral-400" };
  };
%>

  <main class="max-w-7xl mx-auto px-6 py-8">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-white mb-2">Kolejka pracowni</h1>
      <p class="text-neutral-500 text-xs leading-relaxed max-w-3xl">
        Wszystko, co opłacone i jeszcze niezamknięte, jeden wiersz na zlecenie. Ołówek rozwija wiersz do edycji,
        zielony znak zatwierdza, zawinięta strzałka wycofuje bez zmian, krzyżyk usuwa. Termin realizacji zaczyna
        biec w chwili, w której zlecenie staje się „gotowe do pobrania”: zaraz po zapłacie albo po domknięciu
        ustaleń. Wzięcie zlecenia do ręki terminu już nie przesuwa, bo klient dostał datę wcześniej.
      </p>
    </div>

    <%# Pieniadze do oddania. Sprawa zamknieta nie stoi w domyslnym widoku,
        wiec bez tego paska zobowiazanie znikaloby z ekranu razem z wierszem,
        a jest to jedyne miejsce w panelu, w ktorym w ogole je widac. %>
    <% if ((doZwrotu || {}).ile > 0) { %>
      <a href="<%= adres("cancelled,expired", sort) %>"
         class="flex items-center gap-2 mb-4 rounded-xl border border-red-400/40 bg-red-400/10 px-4 py-2.5 text-red-200 text-xs hover:bg-red-400/15 transition-colors">
        <span class="font-semibold">Do zwrotu: <%= (doZwrotu.grosze / 100).toFixed(2) %> PLN</span>
        <span class="text-red-200/70"><%= doZwrotu.ile %> <%= doZwrotu.ile === 1 ? "sprawa zamknięta" : "spraw zamkniętych" %> bez oddanych pieniędzy</span>
      </a>
    <% } %>

    <div class="flex flex-wrap items-center gap-2 mb-3">
      <% FILTRY.forEach(function (f) { %>
        <a href="<%= adres(f.stan, sort) %>"
           class="px-3 py-1.5 rounded-lg border text-xs transition-colors <%= stan === f.stan ? 'border-white/35 text-white bg-white/5' : 'border-white/10 text-neutral-400 hover:border-white/25' %>">
          <%= f.label %>
        </a>
      <% }); %>
    </div>

    <div class="flex flex-wrap items-center gap-2 mb-5">
      <span class="text-neutral-600 text-[10px] uppercase tracking-wide">Kolejność</span>
      <% SORTY.forEach(function (s) { %>
        <a href="<%= adres(stan, s.id) %>"
           class="px-2.5 py-1 rounded-lg border text-[11px] transition-colors <%= sort === s.id ? 'border-amber-400/40 text-amber-300 bg-amber-400/10' : 'border-white/10 text-neutral-500 hover:border-white/25' %>">
          <%= s.label %>
        </a>
      <% }); %>
      <label class="ml-auto block">
        <span class="sr-only">Szukaj w kolejce</span>
        <input id="szukaj" type="search" placeholder="numer, nazwisko, email"
               class="w-56 rounded-lg bg-neutral-900 border border-white/10 px-3 py-1.5 text-xs text-white" />
      </label>
    </div>

    <%# Komunikat przykleja sie do gory ekranu. Wiersz kolejki rozwija sie na
        kilkaset pikseli, wiec bledu wypisanego nad tabela nie widac stamtad,
        gdzie sie kliknelo: wyglada to jak cisza, a nie jak odmowa. %>
    <% if (err) { %>
      <div class="sticky top-2 z-30 rounded-lg border border-red-400/40 bg-red-950 p-3 mb-5 text-red-200 text-xs leading-relaxed shadow-lg"><%= err %></div>
    <% } %>
    <% if (msg) { %>
      <div class="rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-3 mb-5 text-emerald-300 text-xs"><%= msg %></div>
    <% } %>

    <% if (!orders.length) { %>
      <div class="rounded-xl border border-dashed border-white/15 bg-white/[0.02] px-6 py-10 text-center text-neutral-500 text-sm">
        Nic nie czeka. Wszystko opłacone jest zrobione i zamknięte.
      </div>
    <% } else { %>

    <div class="overflow-x-auto rounded-xl border border-white/10">
      <table class="w-full text-sm tabela-akcje">
        <thead>
          <tr class="text-neutral-500 text-[10px] uppercase tracking-wide border-b border-white/10">
            <th class="text-left font-medium px-3 py-2.5">Numer</th>
            <th class="text-left font-medium px-3 py-2.5">Klient</th>
            <th class="text-left font-medium px-3 py-2.5">Status</th>
            <th class="text-left font-medium px-3 py-2.5">Termin</th>
            <th class="text-left font-medium px-3 py-2.5">Na kiedy</th>
            <th class="text-left font-medium px-3 py-2.5">Zostało</th>
            <th class="text-right font-medium px-3 py-2.5">Kwota</th>
            <th class="text-right font-medium px-3 py-2.5">Akcje</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function (o) { %>
            <% const kiedy = zostalo(o); const bieg = Z_ZEGAREM.includes(o.status); %>
            <tr class="border-b border-white/5 hover:bg-white/[0.02]"
                data-wiersz="<%= o.orderRef %>"
                data-szukaj="<%= [o.orderRef, o.quoteRef, o.name, o.email].filter(Boolean).join(' ').toLowerCase() %>">
              <td class="px-3 py-2.5 whitespace-nowrap">
                <span class="font-mono text-xs text-white"><%= o.orderRef %></span>
                <% if (o.quoteRef) { %>
                  <a href="/quotes/<%= encodeURIComponent(o.quoteRef) %>" class="ml-2 font-mono text-[10px] text-amber-300 hover:text-amber-200" title="Oferta, z ktorej powstalo to zlecenie"><%= o.quoteRef %></a>
                <% } %>
              </td>
              <td class="px-3 py-2.5 text-neutral-300 text-xs max-w-[11rem] truncate" title="<%= o.email || '' %>">
                <%= o.name || "(brak nazwiska)" %>
              </td>
              <td class="px-3 py-2.5 whitespace-nowrap">
                <span class="px-2 py-0.5 rounded border text-[10px] <%= STAN[o.status].klasa %>"><%= STAN[o.status].label %></span>
              </td>
              <td class="px-3 py-2.5 text-neutral-400 text-xs whitespace-nowrap">
                <%= o.leadDays ? o.leadDays + " dni" : "-" %>
              </td>
              <td class="px-3 py-2.5 text-xs whitespace-nowrap font-mono <%= o.deadlineAt ? 'text-neutral-300' : 'text-neutral-600' %>">
                <%# Zlecenie w ustalaniu nie ma daty i nie ma jej skad wziac:
                    zegar stoi, bo czekamy na klienta. %>
                <%= o.deadlineAt || (o.status === "details" ? "po ustaleniach" : "-") %>
              </td>
              <td class="px-3 py-2.5 text-xs whitespace-nowrap <%= kiedy ? kiedy.klasa : 'text-neutral-600' %>">
                <%= kiedy ? kiedy.tekst : (o.status === "details" ? "zegar stoi" : "-") %>
              </td>
              <td class="px-3 py-2.5 text-right text-white text-xs whitespace-nowrap"><%= o.totalPLN %> PLN</td>
              <td class="px-3 py-2.5">
                <div class="flex items-center justify-end gap-1">
                  <%# Zapis i wycofanie stoja PRZY WIERSZU, a nie na dole
                      rozwinietego panelu: przy dlugim zleceniu trzeba bylo do
                      nich przewijac, a wracalo sie do wiersza, ktory wyszedl
                      juz poza ekran. Atrybut `form` wiaze je z formularzem
                      edycji nizej, wiec dzialaja bez skryptu.
                      Pokazuja sie dopiero po otwarciu wiersza, bo "zapisz"
                      przy wierszu zamknietym nie ma czego zapisac. %>
                  <button form="edycja-<%= o.orderRef %>" data-akcja-edycji="<%= o.orderRef %>"
                          class="hidden dymek p-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 hover:bg-emerald-400/10 transition-colors"
                          data-dymek="Zapisz zmiany" title="Zapisz zmiany"
                          aria-label="Zapisz zmiany w <%= o.orderRef %>">
                    <%- IKONY.fistaszek %>
                  </button>
                  <button type="reset" form="edycja-<%= o.orderRef %>"
                          data-akcja-edycji="<%= o.orderRef %>" data-zamknij="<%= o.orderRef %>"
                          class="hidden dymek p-1.5 rounded-lg border border-amber-400/40 text-amber-300 hover:bg-amber-400/10 transition-colors"
                          data-dymek="Zostaw bez zmian" title="Zostaw bez zmian"
                          aria-label="Zamknij edycję <%= o.orderRef %> bez zmian">
                    <%- IKONY.cofnij %>
                  </button>
                  <button type="button" data-otworz="<%= o.orderRef %>"
                          class="dymek p-1.5 rounded-lg border border-white/10 text-neutral-300 hover:border-white/35 hover:text-white transition-colors"
                          data-dymek="Otwórz do edycji" title="Otwórz do edycji"
                          aria-label="Edytuj <%= o.orderRef %>">
                    <%- IKONY.olowek %>
                  </button>
                  <button type="button" data-usun="<%= o.orderRef %>"
                          class="dymek p-1.5 rounded-lg border border-red-400/25 text-red-300 hover:border-red-400/60 transition-colors"
                          data-dymek="Usuń zlecenie" title="Usuń zlecenie"
                          aria-label="Usuń <%= o.orderRef %>">
                    <%- IKONY.krzyzyk %>
                  </button>
                </div>
              </td>
            </tr>

            <%# WIERSZ ROZWINIETY. Stoi w drzewie od poczatku, a nie doklada sie
                skryptem: panel ma dzialac tak samo przy wolnym laczu, a formularz
                dorysowany po fakcie gubi wpisana tresc przy kazdym odswiezeniu. %>
            <tr class="hidden border-b border-white/10 bg-neutral-950" data-edycja="<%= o.orderRef %>">
              <td colspan="8" class="px-4 py-5">

                <div class="mb-5">
                  <h3 class="text-white text-xs font-semibold mb-3">Postęp</h3>

                    <%
                      // OS CZASU. Etap pracy jest statusem zamowienia (ADR-0013),
                      // wiec ta lista nie jest osobnym zapisem, tylko sposobem
                      // pokazania jednej wartosci razem ze stemplami, ktore
                      // przy niej stoja. Ustalanie szczegolow pojawia sie tylko
                      // tam, gdzie bylo wymagane: pusty przystanek na kazdej
                      // osi uczylby, ze zawsze cos pomijamy.
                      const wysylkowy = "Przekazane";
                      // Dopoki wplata nie jest zaksiegowana, przystanek nazywa
                      // sie "Zapłata" i nie ma stempla. "Zapłacone" bez daty
                      // przy zamowieniu czekajacym na przelew byloby zdaniem
                      // nieprawdziwym, a to wlasnie ten wiersz ma o tym mowic.
                      const KROKI = [{ id: "paid", label: o.paidAt ? "Zapłacone" : "Zapłata", data: o.paidAt }];
                      if (o.requiresDetails) KROKI.push({ id: "details", label: "Ustalanie szczegółów", data: o.detailsAt });
                      KROKI.push({ id: "queued", label: "Gotowe do pobrania", data: o.queuedAt });
                      KROKI.push({ id: "in_production", label: "W realizacji", data: o.productionStartedAt });
                      KROKI.push({ id: "ready", label: "Gotowe", data: o.readyAt });
                      KROKI.push({ id: "shipped", label: wysylkowy, data: o.shippedAt });
                      // Doreczenie to OSOBNY przystanek, ten sam co u klienta.
                      // Bez niego panel i strona zamowienia pokazywalyby dwie
                      // rozne drogi, a klient pytajacy "czy doszlo" nie mialby
                      // gdzie tego zobaczyc. Id celowo nie rowna sie zadnemu
                      // statusowi: przystanek ma zzieleniec po potwierdzeniu,
                      // a nie swiecic na bursztynowo jako "trwa".
                      KROKI.push({ id: "delivered", label: "Odebrane", data: o.completedAt });
                      // Termin domyka os, bo jest tym, do czego ona zmierza.
                      // Pojawia sie sam, w chwili gdy zegar rusza: przy zaplacie
                      // albo po domknieciu ustalen.
                      KROKI.push({ id: "termin", label: "Termin", data: o.deadlineAt, termin: true });
                    %>

                    <div class="flex flex-wrap gap-y-5 mb-4">
                      <% KROKI.forEach(function (k, i) { %>
                        <%
                          const zrobiony = k.termin ? Boolean(o.deadlineAt) : Boolean(k.data);
                          // Zamowienie czekajace na pieniadze stoi na PIERWSZYM
                          // przystanku, choc zaden stan nie nazywa sie "paid".
                          const teraz = !k.termin && (k.id === o.status
                            || (k.id === "paid" && PRZED_ZAPLATA.includes(o.status)));
                          const kropka = teraz ? "border-amber-400 bg-amber-400/20"
                                       : zrobiony ? (k.termin ? "border-amber-400 bg-amber-400" : "border-emerald-400 bg-emerald-400")
                                       : "border-white/20 bg-transparent";
                          const napis = teraz ? "text-amber-300 font-semibold" : zrobiony ? "text-neutral-300" : "text-neutral-600";
                        %>
                        <div class="flex-1 min-w-[8.5rem] pr-3">
                          <div class="flex items-center">
                            <span class="w-3 h-3 shrink-0 rounded-full border-2 <%= kropka %>"></span>
                            <% if (i < KROKI.length - 1) { %>
                              <span class="flex-1 h-px <%= zrobiony ? 'bg-emerald-400/40' : 'bg-white/10' %>"></span>
                            <% } %>
                          </div>
                          <div class="mt-2 text-[11px] leading-tight <%= napis %>"><%= k.label %></div>
                          <div class="text-neutral-600 text-[10px] font-mono">
                            <% if (k.termin) { %>
                              <%= o.deadlineAt || (o.requiresDetails ? "po ustaleniach" : "brak") %>
                            <% } else if (k.data) { %>
                              <%= fmtDateShort(k.data) %>
                            <% } else { %>&nbsp;<% } %>
                          </div>

                          <%# Przycisk stoi pod przystankiem, NA KTORYM zlecenie
                              teraz stoi, i mowi, co z tego miejsca mozna zrobic
                              (decyzja wlasciciela, 2026-08-30). Wczesniej stal
                              pod przystankiem docelowym, co czytalo sie jako
                              "co juz sie stalo", a nie "co zrobic teraz". %>
                          <div class="mt-2">
                            <%# Pierwszy krok kolejki: potwierdzenie wplaty.
                                Stoi POD przystankiem "Zapłata", tak samo jak
                                kazda inna akcja, zamiast na osobnej stronie.
                                Potwierdzenie robi doslownie to samo, co udana
                                platnosc bramka: wpuszcza zlecenie do kolejki,
                                wydaje pliki, zdejmuje towar ze stanu i wysyla
                                klientowi potwierdzenie. %>
                            <% if (k.id === "paid" && o.status === "awaiting_transfer") { %>
                              <form method="post" action="/transfers/<%= encodeURIComponent(o.orderRef) %>/confirm" class="space-y-2">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <%# Po prosbie o doplate na koncie leza JUZ jakies pieniadze, wiec
                                    pole pyta o kwote LACZNA, a nie o sama doplate. Jedna liczba,
                                    jedno znaczenie: dwie kwoty w jednym polu konczylyby sie
                                    zamowieniem oplaconym na papierze i nieoplaconym w banku. %>
                                <% if (o.transferAskedAt) { %>
                                  <p class="text-orange-300 text-[10px] leading-tight mb-2">
                                    Poproszono o dopłatę <%= fmtDateShort(o.transferAskedAt) %>.
                                    Wpłynęło dotąd <%= ((o.transferReceivedCents || 0) / 100).toFixed(2) %> EUR.
                                    <span class="text-neutral-500 block">Wpisz kwotę ŁĄCZNĄ, razem z pierwszą wpłatą.</span>
                                  </p>
                                <% } %>
                                <label class="block">
                                  <span class="text-neutral-500 text-[10px] block mb-1">
                                    <%= o.transferAskedAt ? "Wpłynęło łącznie" : "Wpłynęło" %><% if (o.amountEurCents != null) { %>, oczekujemy <%= (o.amountEurCents / 100).toFixed(2) %> EUR<% } %>
                                  </span>
                                  <input type="number" step="0.01" name="receivedEur"
                                         placeholder="<%= o.amountEurCents != null ? (o.amountEurCents / 100).toFixed(2) : 'kwota w EUR' %>"
                                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white" />
                                </label>
                                <button name="force" value="false"
                                        class="w-full px-2.5 py-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 text-[11px] hover:bg-emerald-400/10 transition-colors">
                                  Potwierdzam wpływ
                                </button>
                                <%# Drobna roznica (do 5 EUR albo 2%, co mniejsze) przechodzi sama:
                                    prowizja banku posredniczacego nie jest wina klienta. Wieksza
                                    wymaga decyzji, i to sa te dwa przyciski nizej. %>
                                <button name="force" value="true"
                                        class="w-full px-2.5 py-1.5 rounded-lg border border-amber-400/40 text-amber-300 text-[10px] hover:bg-amber-400/10 transition-colors">
                                  Potwierdzam mimo różnicy
                                </button>
                                <%# Trzecia droga: wplynelo za malo i prosimy klienta o doplate.
                                    Zamowienie zostaje na tym przystanku, dostaje trzy dni, a po
                                    nich wygasa samo razem z mailem do klienta.

                                    Przycisk siedzi w TYM SAMYM formularzu i zmienia tylko adres
                                    (`formaction`). Drugie pole na te sama kwote byloby dwoma
                                    miejscami na jedna liczbe, a wpisanie jej nie w to okienko
                                    konczyloby sie prosba o doplate na przypadkowa kwote. %>
                                <button class="dymek w-full mt-1 px-2.5 py-1.5 rounded-lg border border-orange-400/40 text-orange-300 text-[10px] hover:bg-orange-400/10 transition-colors" data-dymek="Wyślij prośbę o brakującą kwotę z terminem trzech dni" formaction="/transfers/<%= encodeURIComponent(o.orderRef) %>/shortfall">
                                  Napisz o dopłatę, 3 dni
                                </button>
                              </form>
                              <%# Rezygnacja stoi osobno od potwierdzenia, bo to ruch w druga strone
                                  i nie ma prawa wyjsc z omylkowego klikniecia obok. %>
                              <form method="post" action="/transfers/<%= encodeURIComponent(o.orderRef) %>/cancel" class="mt-2 pt-2 border-t border-white/5"
                                    onsubmit="return confirm('Zrezygnować z <%= o.orderRef %>? Towar i kod rabatowy wrócą do sprzedaży, zamówienie zostanie w historii.')">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <input type="text" name="reason" maxlength="200" placeholder="Powód (opcjonalnie)"
                                       class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[10px] text-neutral-300 mb-1" />
                                <button data-dymek="Zamknij zamówienie przed wpłatą. Towar i kod rabatowy wracają do sprzedaży" class="dymek w-full px-2.5 py-1.5 rounded-lg border border-white/15 text-neutral-400 text-[10px] hover:border-white/35 transition-colors">
                                  Rezygnacja, zwolnij towar
                                </button>
                              </form>
                            <% } %>

                            <%# Platnosc do recznej decyzji nie ma tu przycisku i to jest celowe:
                                pieniadze pobrano, ale zlecenia nie uruchomiono, wiec najpierw
                                sprawdza sie platnosc i stan magazynu, a dopiero potem decyduje. %>
                            <% if (k.id === "paid" && o.status === "payment_review") { %>
                              <p class="text-[11px] text-red-300 leading-tight">
                                Pobrano pieniądze, zlecenie nie ruszyło.
                                <% if (o.paymentReviewReason) { %>
                                  <span class="text-neutral-500 block">Powód: <%= o.paymentReviewReason %></span>
                                <% } %>
                                <span class="text-neutral-500 block">Sprawdź płatność i stan magazynu, zanim ruszysz dalej.</span>
                              </p>
                            <% } %>

                            <% if (k.id === "details" && o.status === "details") { %>
                              <p class="text-[11px] text-purple-300 leading-tight">
                                <%= o.items.filter(function (i) { return i.requiresDetails && !i.detailsSettledAt; }).length %>
                                <span class="text-neutral-500">poz. do ustalenia, odhacz je niżej</span>
                              </p>
                            <% } %>

                            <% if (k.id === "queued" && (o.status === "queued" || o.status === "paid")) { %>
                              <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <input type="hidden" name="stage" value="in_production" />
                                <%# Pytamy przy KAZDEJ zmianie etapu, zamiast wysylac z automatu:
                                    mail przy kazdym ruchu zamienilby skrzynke klienta w dziennik
                                    naszej pracy. Przy cofaniu pole jest puste, bo prostujemy
                                    wtedy wlasna pomylke, o ktorej klient nie zdazyl sie dowiedziec. %>
                                <label class="flex items-center gap-2 cursor-pointer mb-2">
                                  <input type="checkbox" name="notify" value="1" checked
                                         class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                                  <span class="text-neutral-400 text-[10px]">Powiadom klienta mailem</span>
                                </label>
                                <button class="px-2.5 py-1.5 rounded-lg bg-amber-400 text-neutral-950 text-[11px] font-medium hover:bg-amber-300 transition-colors">
                                  Biorę do realizacji
                                </button>
                              </form>
                            <% } %>

                            <% if (k.id === "in_production" && o.status === "in_production") { %>
                              <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <input type="hidden" name="stage" value="ready" />
                                <%# Pytamy przy KAZDEJ zmianie etapu, zamiast wysylac z automatu:
                                    mail przy kazdym ruchu zamienilby skrzynke klienta w dziennik
                                    naszej pracy. Przy cofaniu pole jest puste, bo prostujemy
                                    wtedy wlasna pomylke, o ktorej klient nie zdazyl sie dowiedziec. %>
                                <label class="flex items-center gap-2 cursor-pointer mb-2">
                                  <input type="checkbox" name="notify" value="1" checked
                                         class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                                  <span class="text-neutral-400 text-[10px]">Powiadom klienta mailem</span>
                                </label>
                                <button data-dymek="Praca skończona, rzecz czeka na wydanie. Klient zobaczy etap „Gotowe”" class="dymek flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 text-[11px] hover:bg-emerald-400/10 transition-colors">
                                  <%- IKONY.fistaszek %> Prace zakończone
                                </button>
                              </form>
                            <% } %>

                            <%# Pola wysylki pojawiaja sie DOPIERO w "gotowe do
                                wysylki", bo dopiero wtedy jest co nadawac.
                                Zaznaczenie "przekazane osobiscie" chowa numer
                                przesylki: kurier wtedy nie jechal i nie ma
                                czego sledzic. Sposob dostawy z zamowienia
                                ustawia tylko stan poczatkowy tego pola. %>
                            <% if (k.id === "ready" && o.status === "ready") { %>
                              <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage" class="space-y-2">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <input type="hidden" name="stage" value="shipped" />
                                <%# Pytamy przy KAZDEJ zmianie etapu, zamiast wysylac z automatu:
                                    mail przy kazdym ruchu zamienilby skrzynke klienta w dziennik
                                    naszej pracy. Przy cofaniu pole jest puste, bo prostujemy
                                    wtedy wlasna pomylke, o ktorej klient nie zdazyl sie dowiedziec. %>
                                <label class="flex items-center gap-2 cursor-pointer mb-2">
                                  <input type="checkbox" name="notify" value="1" checked
                                         class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                                  <span class="text-neutral-400 text-[10px]">Powiadom klienta mailem</span>
                                </label>
                                <label class="flex items-center gap-2 cursor-pointer">
                                  <input type="checkbox" data-osobiscie="<%= o.orderRef %>" <%= o.delivery.method === "pickup" ? "checked" : "" %>
                                         class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                                  <span class="text-neutral-400 text-[11px]">Przekazane osobiście</span>
                                </label>
                                <label class="block" data-przesylka="<%= o.orderRef %>">
                                  <span class="text-neutral-500 text-[10px] block mb-1">List przewozowy</span>
                                  <input name="trackingNumber" placeholder="numer przesyłki"
                                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white font-mono" />
                                </label>
                                <%# Przewoznik idzie do klienta z nazwy i buduje odnosnik do
                                    sledzenia, wiec jest wyborem z listy, a nie polem tekstowym.
                                    Lista przychodzi z API razem z kolejka: druga kopia tutaj
                                    rozjechalaby sie przy pierwszym nowym przewozniku. Strefa
                                    podpowiada, kto zwykle wozi w tamta strone, ale strefy
                                    swiatowe nosza dwie nazwy naraz, a paczka jedzie jedna. %>
                                <% if ((przewoznicy || []).length) { %>
                                  <label class="block" data-przesylka="<%= o.orderRef %>">
                                    <span class="text-neutral-500 text-[10px] block mb-1">Przewoźnik</span>
                                    <select name="carrier"
                                            class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white">
                                      <option value="">nie podaję</option>
                                      <% przewoznicy.forEach(function (kto) { %>
                                        <option value="<%= kto %>" <%= (o.carrier || o.carrierHint) === kto ? "selected" : "" %>><%= kto %></option>
                                      <% }); %>
                                    </select>
                                  </label>
                                <% } %>
                                <label class="block">
                                  <span class="text-neutral-500 text-[10px] block mb-1">Data wysyłki lub przekazania</span>
                                  <%# Puste pole znaczy "dzisiaj". Paczka bywa nadana wczoraj,
                                      a zaznaczona dzisiaj, i wtedy termin wygladalby na
                                      przekroczony o dzien. %>
                                  <input name="shippedOn" type="date"
                                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white" />
                                </label>
                                <button data-dymek="Paczka oddana kurierowi albo wydana do rąk. Pozycja ZOSTAJE na liście do potwierdzenia odbioru" class="dymek w-full px-2.5 py-1.5 rounded-lg border border-white/15 text-neutral-200 text-[11px] hover:border-white/35 transition-colors">
                                  Przekazano
                                </button>
                              </form>
                            <% } %>

                            <%# Cofniecie o jeden etap. Stoi przy przystanku,
                                NA KTORYM zlecenie stoi, tak samo jak akcja do
                                przodu, i uzywa tego samego znaku co "zostaw bez
                                zmian": zawinieta strzalka znaczy w tym panelu
                                powrot. Stemple etapow po docelowym znikaja, bo
                                przestaly byc prawda: zlecenie cofniete z
                                "wyslane" traci date wysylki i list przewozowy.
                                Zamowienie zamkniete nie ma wlasnego przystanku
                                na osi, wiec jego powrot stoi przy "wyslane". %>
                            <% if (COFNIJ_DO[o.status] && (k.id === o.status || (o.status === "completed" && k.id === "shipped"))) { %>
                              <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/edit" class="mt-2">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <input type="hidden" name="stage" value="<%= COFNIJ_DO[o.status] %>" />
                                <%# Pytamy przy KAZDEJ zmianie etapu, zamiast wysylac z automatu:
                                    mail przy kazdym ruchu zamienilby skrzynke klienta w dziennik
                                    naszej pracy. Przy cofaniu pole jest puste, bo prostujemy
                                    wtedy wlasna pomylke, o ktorej klient nie zdazyl sie dowiedziec. %>
                                <label class="flex items-center gap-2 cursor-pointer mb-2">
                                  <input type="checkbox" name="notify" value="1"
                                         class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                                  <span class="text-neutral-400 text-[10px]">Powiadom klienta o cofnięciu</span>
                                </label>
                                <button class="dymek flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-amber-400/40 text-amber-300 text-[11px] hover:bg-amber-400/10 transition-colors"
                                        data-dymek="Cofnij do: <%= STAN[COFNIJ_DO[o.status]].label %>"
                                        title="Cofnij do: <%= STAN[COFNIJ_DO[o.status]].label %>">
                                  <%- IKONY.cofnij %> Cofnij etap
                                </button>
                              </form>
                            <% } %>

                            <% if (k.id === "shipped" && o.status === "shipped") { %>
                              <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/stage">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <input type="hidden" name="stage" value="completed" />
                                <%# Pytamy przy KAZDEJ zmianie etapu, zamiast wysylac z automatu:
                                    mail przy kazdym ruchu zamienilby skrzynke klienta w dziennik
                                    naszej pracy. Przy cofaniu pole jest puste, bo prostujemy
                                    wtedy wlasna pomylke, o ktorej klient nie zdazyl sie dowiedziec. %>
                                <label class="flex items-center gap-2 cursor-pointer mb-2">
                                  <input type="checkbox" name="notify" value="1"
                                         class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                                  <span class="text-neutral-400 text-[10px]">Powiadom klienta mailem</span>
                                </label>
                                <%# Prosba o ocene wychodzi trzy dni po odbiorze. Klienci
                                    zaczeli wystawiac opinie sami, jeszcze zanim minely,
                                    a prosba wyslana takiej osobie nie jest uprzejmoscia,
                                    tylko dopominaniem sie o cos, co juz dostalismy.
                                    Domyslnie zaznaczone, bo przy wiekszosci zamowien
                                    prosic warto. Decyzje da sie zmienic do chwili
                                    wyslania, i sluzy do tego przelacznik nizej. %>
                                <label class="flex items-center gap-2 cursor-pointer mb-2">
                                  <input type="checkbox" name="reviewAsk" value="1" checked
                                         class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                                  <span class="text-neutral-400 text-[10px]">Poproś o opinię za 3 dni</span>
                                </label>
                                <%# Odbior potwierdza KLIENT, a my go tu odnotowujemy. Napis
                                    "zamknij i schowaj" mowil o tym, co dzieje sie z wierszem
                                    w tabeli, a nie o tym, co sie stalo ze zleceniem. %>
                                <button data-dymek="Klient potwierdził odbiór. Pozycja schodzi z listy, a trzy dni później wychodzi prośba o opinię" class="dymek px-2.5 py-1.5 rounded-lg border border-white/15 text-neutral-400 text-[11px] hover:border-white/35 transition-colors">
                                  Odebrano
                                </button>
                              </form>
                            <% } %>

                            <%# Termin w dniach przychodzi z oplaconej oferty.
                                Zmiana po zaplacie jest ustaleniem z klientem,
                                wiec API zada daty, kiedy zapadlo. %>
                            <% if (k.termin) { %>
                              <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/edit" class="space-y-1.5">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <label class="block">
                                  <span class="text-neutral-500 text-[10px] block mb-1">Termin w dniach</span>
                                  <input name="leadDays" type="number" min="1" max="365" value="<%= o.leadDays || '' %>"
                                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white" />
                                </label>
                                <label class="block">
                                  <span class="text-neutral-500 text-[10px] block mb-1">Ustalone z klientem dnia</span>
                                  <input name="leadDaysAgreedAt" type="date" value="<%= o.leadDaysAgreedAt || '' %>"
                                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white" />
                                </label>
                                <button data-dymek="Zapisz liczbę dni i datę ustalenia. Termin przelicza się od startu zegara, nie od dzisiaj" class="dymek w-full flex items-center justify-center gap-1.5 px-2.5 py-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 text-[11px] hover:bg-emerald-400/10 transition-colors">
                                  <%- IKONY.fistaszek %> Zapisz termin
                                </button>
                              </form>
                            <% } %>
                          </div>
                        </div>
                      <% }); %>
                    </div>

                    <%# Zamowienie juz odebrane: widac, czy prosba o ocene czeka,
                        czy zostala wylaczona, czy juz poszla. Trzeci stan jest
                        osobny, bo po wyslaniu nie ma czego przestawiac
                        i udawanie, ze sie da, byloby gorsze od milczenia. %>
                    <% if (o.status === "completed") { %>
                      <div class="mt-3 rounded-lg border border-white/10 bg-white/[0.02] px-3 py-2">
                        <% if (o.reviewAskedAt) { %>
                          <p class="text-neutral-400 text-[11px]">Prośba o opinię wysłana <%= fmtDateShort(o.reviewAskedAt) %>.</p>
                        <% } else { %>
                          <p class="text-[11px] <%= o.reviewAsk ? 'text-emerald-300' : 'text-neutral-500' %>">
                            <%= o.reviewAsk ? "Prośba o opinię wyjdzie 3 dni po odbiorze." : "Nie poprosimy o opinię." %>
                          </p>
                          <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/prosba-o-ocene" class="mt-1.5">
                            <input type="hidden" name="back" value="<%= POWROT %>" />
                            <input type="hidden" name="ask" value="<%= o.reviewAsk ? '0' : '1' %>" />
                            <button class="px-2.5 py-1.5 rounded-lg border border-white/15 text-neutral-300 text-[10px] hover:border-white/35 transition-colors">
                              <%= o.reviewAsk ? "Nie proś o opinię" : "Jednak poproś o opinię" %>
                            </button>
                          </form>
                        <% } %>
                      </div>
                    <% } %>

                    <% if (o.trackingNumber) { %>
                      <p class="text-neutral-500 text-[11px]">
                        <span class="text-neutral-600">List przewozowy:</span>
                        <span class="font-mono text-neutral-300"><%= o.trackingNumber %></span>
                      </p>
                    <% } %>
                    <% if (o.productionNote) { %>
                      <p class="text-neutral-500 text-[11px]">Notatka: <%= o.productionNote %></p>
                    <% } %>

                    <%# ZAMKNIECIE SPRAWY BEZ REALIZACJI. Stoi poza osia etapow,
                        bo nie jest krokiem naprzod: wyjscie zdarza sie na
                        kazdym przystanku i z czterech roznych powodow, ktore
                        regulamin rozroznia. Jeden przycisk "anuluj" sklejalby
                        je w jedno i po pol roku nie dalo by sie powiedziec,
                        czemu przy jednej sprawie wrocily pieniadze, a przy
                        drugiej nie. %>
                    <% if (o.status === "cancelled") { %>
                      <% var droga = (drogiZamkniecia || []).find(function (d) { return d.id === o.cancelKind; }); %>
                      <div class="mt-3 rounded-lg border border-white/10 bg-white/[0.02] px-3 py-2">
                        <p class="text-neutral-300 text-[11px] font-semibold">
                          Zamknięte: <%= droga ? droga.label : (o.cancelKind || "bez podanej drogi") %>
                        </p>
                        <% if (o.cancelReason) { %>
                          <p class="text-neutral-500 text-[10px] mt-0.5">Powód: <%= o.cancelReason %></p>
                        <% } %>
                        <% if (o.refundGrosze > 0) { %>
                          <% if (o.refundedAt) { %>
                            <p class="text-emerald-300 text-[11px] mt-1">Zwrot <%= o.refundPLN %> PLN wysłany <%= fmtDateShort(o.refundedAt) %>.</p>
                          <% } else { %>
                            <%# Sprawa zamknieta z niezwroconymi pieniedzmi jest
                                zobowiazaniem, ktorego nie widac nigdzie indziej.
                                Dlatego czerwono i dlatego z przyciskiem. %>
                            <p class="text-red-300 text-[11px] mt-1 font-semibold">Do zwrotu: <%= o.refundPLN %> PLN</p>
                            <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/refunded" class="mt-1.5"
                                  onsubmit="return confirm('Pieniądze <%= o.refundPLN %> PLN naprawdę poszły do klienta?')">
                              <input type="hidden" name="back" value="<%= POWROT %>" />
                              <button data-dymek="Potwierdź, że pieniądze naprawdę poszły. Sprawa znika z czerwonego paska nad listą" class="dymek px-2.5 py-1.5 rounded-lg border border-emerald-400/40 text-emerald-300 text-[11px] hover:bg-emerald-400/10 transition-colors">
                                Zwrot wysłany
                              </button>
                            </form>
                          <% } %>
                        <% } else { %>
                          <p class="text-neutral-500 text-[10px] mt-0.5">Bez zwrotu.</p>
                        <% } %>
                      </div>
                    <% } else { %>
                      <% var mozliwe = (drogiZamkniecia || []).filter(function (d) { return d.etapy.indexOf(o.status) !== -1; }); %>
                      <% if (mozliwe.length) { %>
                        <details class="mt-3 rounded-lg border border-white/10 bg-white/[0.02]">
                          <summary class="cursor-pointer px-3 py-2 text-neutral-400 text-[11px] hover:text-neutral-200">
                            Zamknij sprawę bez realizacji
                          </summary>
                          <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/close" class="px-3 pb-3 space-y-2"
                                onsubmit="return confirm('Zamknąć <%= o.orderRef %> bez realizacji? Towar i kod wrócą do sprzedaży.')">
                            <input type="hidden" name="back" value="<%= POWROT %>" />
                            <%# Zadnej drogi nie zaznaczamy z gory: wybor ma byc
                                decyzja, a nie skutkiem przeoczenia. %>
                            <% mozliwe.forEach(function (d) { %>
                              <label class="flex gap-2 rounded-lg border border-white/10 px-2 py-1.5 cursor-pointer hover:border-white/25">
                                <input type="radio" name="kind" value="<%= d.id %>" required
                                       data-zwrot="<%= d.zwrot %>"
                                       data-zaplacono="<%= o.paidAt ? o.totalPLN : '0.00' %>"
                                       class="mt-0.5 w-3.5 h-3.5 shrink-0" />
                                <span class="text-[11px]">
                                  <span class="text-neutral-200 font-medium block"><%= d.label %></span>
                                  <span class="text-neutral-500 block leading-snug"><%= d.opis %></span>
                                  <% if (d.ostrzezenieNaZamowienie) { %>
                                    <span class="text-amber-300/90 block leading-snug mt-0.5"><%= d.ostrzezenieNaZamowienie %></span>
                                  <% } %>
                                </span>
                              </label>
                            <% }); %>
                            <label class="block">
                              <span class="text-neutral-500 text-[10px] block mb-1">
                                Do zwrotu w PLN<% if (o.paidAt) { %>, zapłacono <%= o.totalPLN %><% } else { %>, nic nie wpłynęło<% } %>
                              </span>
                              <input name="refund" type="text" inputmode="decimal" placeholder="0,00"
                                     class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white" />
                            </label>
                            <input type="text" name="reason" maxlength="200" placeholder="Powód, dla nas (opcjonalnie)"
                                   class="w-full rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[10px] text-neutral-300" />
                            <label class="flex items-center gap-2 cursor-pointer">
                              <input type="checkbox" name="notify" checked class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                              <span class="text-neutral-400 text-[10px]">Napisz do klienta</span>
                            </label>
                            <button data-dymek="Zamknij bez realizacji wybraną drogą. Towar i kod wracają do sprzedaży, kwota zwrotu zapisuje się do oddania" class="dymek w-full px-2.5 py-1.5 rounded-lg border border-red-400/40 text-red-300 text-[11px] hover:bg-red-400/10 transition-colors">
                              Zamknij sprawę
                            </button>
                          </form>
                        </details>
                      <% } %>
                    <% } %>
                </div>


                  <div>
                    <h3 class="text-white text-xs font-semibold mb-2">Zlecenie</h3>
                    <ul class="space-y-2">
                      <% o.items.forEach(function (it) { %>
                        <li class="rounded-lg border border-white/10 bg-white/[0.02] px-3 py-2">
                          <div class="flex items-start justify-between gap-3">
                            <div class="text-xs text-neutral-200">
                              <%= it.qty %> &times; <%= it.title %>
                              <%# TERMIN TEJ POZYCJI, obok jej nazwy. Zamowienie
                                  niesie termin najdluzszej sztuki, wiec bez tej
                                  liczby pracownia nie widzi, ze druga robi sie
                                  krocej, i trzyma ja razem z wolniejsza. %>
                              <% if (it.leadDays) { %>
                                <span class="ml-1 text-[10px] text-neutral-500"><%= it.leadDays %> dni</span>
                              <% } %>
                              <%# ETAP TEJ SZTUKI, przestawiany osobno. Dwa odlewy
                                  w jednej paczce maja rozny harmonogram, wiec
                                  szybsza sztuka ma dac sie odhaczyc jako gotowa,
                                  nie czekajac na wolniejsza. %>
                              <% var ETYKIETY = { waiting: "czeka", queued: "w kolejce", in_production: "w robocie", ready: "gotowe" }; %>
                              <span class="ml-1 text-[10px] <%= it.stage === "ready" ? "text-emerald-300" : it.stage === "in_production" ? "text-amber-300" : "text-neutral-500" %>">
                                <%= ETYKIETY[it.stage] || "czeka" %>
                              </span>
                            </div>
                            <%# Znacznik pojawia sie WYLACZNIE przy pozycji, ktora
                                wymagala ustalen. Pole zaznaczane przy pozycji,
                                ktora ich nie wymaga, kazaloby pytac, czego
                                dotyczy, a odpowiedz brzmialaby "niczego".
                                Zaznaczenie znaczy: mamy komplet dla TEJ pozycji.
                                Zegar calego zlecenia rusza, gdy zaznaczone sa
                                wszystkie wymagane. %>
                            <%# Przyciski etapu stoja przy pozycji, po jednym na
                                nastepny krok. Cofniecie o jeden krok tez, bo
                                pomylka w pracowni zdarza sie czesciej niz
                                potrzeba grzebania w bazie. %>
                            <% var NASTEPNY = { waiting: ["queued"], queued: ["in_production"], in_production: ["ready", "queued"], ready: ["in_production"] }; %>
                            <% (NASTEPNY[it.stage] || NASTEPNY.waiting).forEach(function (cel) { %>
                              <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/item/<%= it.id %>/stage" class="shrink-0">
                                <input type="hidden" name="stage" value="<%= cel %>" />
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <button type="submit" class="px-2 py-0.5 rounded border border-white/10 text-[10px] text-neutral-300 hover:border-white/30 hover:text-white">
                                  <%= ETYKIETY[cel] %>
                                </button>
                              </form>
                            <% }); %>
                            <% if (it.requiresDetails) { %>
                              <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/item/<%= it.id %>/details" class="shrink-0 flex items-center gap-3">
                                <input type="hidden" name="back" value="<%= POWROT %>" />
                                <input type="hidden" name="settled" value="<%= it.detailsSettledAt ? '0' : '1' %>" />
                                <%# Domkniecie OSTATNIEJ pozycji przestawia etap,
                                    wiec pytanie stoi takze tutaj. Przy pozycji,
                                    ktora nie jest ostatnia, zaznaczenie nic nie
                                    wysyla: serwer pisze do klienta tylko wtedy,
                                    gdy etap naprawde sie zmienil. %>
                                <label class="flex items-center gap-1.5 cursor-pointer" title="Powiadom klienta, jeśli to domknie wszystkie ustalenia">
                                  <input type="checkbox" name="notify" value="1" checked
                                         class="w-3.5 h-3.5 rounded border-white/20 bg-neutral-900" />
                                  <span class="text-neutral-500 text-[10px]">mail</span>
                                </label>
                                <%# Tresc ustalenia jedzie razem z kwadracikiem, bo
                                    to jedno zdarzenie: rozmowa skonczyla sie
                                    czyms konkretnym. Sama data mowi, ze rozmowa
                                    byla, ale nie mowi, na czym stanelo, a to
                                    widzi takze klient na swojej stronie. %>
                                <input name="note" value="<%= it.detailsNote || '' %>" placeholder="co ustalono"
                                       class="w-48 rounded-lg bg-neutral-900 border border-white/10 px-2 py-1 text-[11px] text-white" />
                                <label class="flex items-center gap-2 cursor-pointer">
                                  <input type="checkbox" data-ustalenia <%= it.detailsSettledAt ? "checked" : "" %>
                                         class="w-4 h-4 rounded border-white/20 bg-neutral-900" />
                                  <%# Napis jest PYTANIEM, dopoki nie ma odpowiedzi.
                                      "Wymaga ustalen" opisywalo pozycje, a nie to,
                                      co masz z nia zrobic, wiec kwadracik obok
                                      wygladal jak informacja, a nie jak przelacznik. %>
                                  <span class="text-[10px] <%= it.detailsSettledAt ? "text-emerald-300" : "text-amber-300" %>">
                                    <%= it.detailsSettledAt ? "Ustalone" : "Ustalone?" %>
                                  </span>
                                </label>
                              </form>
                            <% } %>
                          </div>
                          <div class="text-neutral-600 text-[10px] mt-0.5">
                            <%= it.calculator || "pozycja bez kalkulatora" %>
                            <% if (it.fileName) { %>
                              &middot;
                              <% if (it.fileUrl) { %>
                                <a href="<%= it.fileUrl %>" target="_blank" rel="noopener" class="text-amber-300 hover:text-amber-200"><%= it.fileName %></a>
                              <% } else { %><%= it.fileName %><% } %>
                            <% } %>
                          </div>
                          <% if (it.description) { %>
                            <p class="text-neutral-400 text-[11px] mt-1.5 whitespace-pre-wrap"><%= it.description %></p>
                          <% } %>
                        </li>
                      <% }); %>
                    </ul>
                    <p class="text-neutral-500 text-[11px] mt-3 leading-relaxed">
                      <span class="text-neutral-600">Kontakt:</span> <%= o.email || "brak adresu" %><% if (o.phone) { %> &middot; <%= o.phone %><% } %><br />
                      <span class="text-neutral-600">Dostawa:</span>
                      <%= DOSTAWA[o.delivery.method] || o.delivery.method || "nie wybrano" %><% if (o.delivery.point) { %> &middot; <span class="font-mono"><%= o.delivery.point %></span><% } %>
                      <% if (o.delivery.addressLine1) { %>
                        <br /><%= o.delivery.addressLine1 %><% if (o.delivery.addressLine2) { %>, <%= o.delivery.addressLine2 %><% } %>,
                        <%= o.delivery.postalCode %> <%= o.delivery.city %>, <%= o.delivery.country %>
                      <% } %>
                      <br /><span class="text-neutral-600">Opłacone:</span> <%= fmtDateShort(o.paidAt) %><% if (o.waitingDays != null) { %>, czeka <%= o.waitingDays %> dni<% } %>
                      <% if (o.trackingNumber) { %><br /><span class="text-neutral-600">List przewozowy:</span> <span class="font-mono text-neutral-300"><%= o.trackingNumber %></span><% } %>
                    </p>
                  </div>
                </div>

                <%# LINK DLA KLIENTA. Ten sam adres, ktory poszedl mailem po
                    zaplacie. Klient gubi maile, a bez zetonu strona zamowienia
                    pyta go o adres i numer, wiec musimy umiec podac link od
                    reki. Kopiowanie ma zapas na wypadek panelu po http, bo
                    `navigator.clipboard` dziala tylko po https i bez tego
                    przycisk milczalby, wygladajac na zepsuty. %>
                <div class="mt-5 border-t border-white/10 pt-4">
                  <span class="text-neutral-500 text-[10px] block mb-1">Link do zamówienia dla klienta</span>
                  <% if (o.statusUrl) { %>
                    <div class="flex flex-wrap items-center gap-2">
                      <input readonly value="<%= o.statusUrl %>"
                             class="flex-1 min-w-[18rem] rounded-lg bg-neutral-900 border border-white/10 px-3 py-1.5 text-[11px] text-neutral-300 font-mono" />
                      <button type="button" data-kopiuj="<%= o.statusUrl %>"
                              class="dymek px-2.5 py-1.5 rounded-lg border border-white/15 text-neutral-300 text-[11px] hover:border-white/35 transition-colors"
                              data-dymek="Skopiuj link" title="Skopiuj link">Kopiuj link</button>
                      <button type="button" data-kopiuj="<%= o.orderRef %>"
                              class="dymek px-2.5 py-1.5 rounded-lg border border-white/15 text-neutral-300 text-[11px] hover:border-white/35 transition-colors"
                              data-dymek="Skopiuj numer" title="Skopiuj numer">Kopiuj numer</button>
                      <a href="<%= o.statusUrl %>" target="_blank" rel="noopener"
                         class="text-[11px] text-amber-300 hover:text-amber-200 underline underline-offset-2">Otwórz</a>
                    </div>
                  <% } else { %>
                    <p class="text-neutral-600 text-[11px]">
                      To zamówienie nie ma żetonu dostępu. Klient wejdzie po numerze i adresie email.
                    </p>
                  <% } %>
                </div>

                <%# NOTATKA DO PRACOWNI. Nic wiecej: termin ma swoje miejsce na
                    osi czasu, list przewozowy pojawia sie przy wysylce, a etap
                    zmienia sie przyciskiem pod przystankiem. Formularz zbierajacy
                    wszystko naraz kazal zgadywac, ktore pole na co dziala. %>
                <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/edit"
                      id="edycja-<%= o.orderRef %>"
                      class="mt-5 border-t border-white/10 pt-4 flex flex-wrap items-end gap-3">
                  <input type="hidden" name="back" value="<%= POWROT %>" />
                  <label class="block flex-1 min-w-[16rem]">
                    <span class="text-neutral-500 text-[10px] block mb-1">Notatka do pracowni</span>
                    <input name="note" value="<%= o.productionNote || '' %>" placeholder="puste pole kasuje"
                           class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-1.5 text-xs text-white" />
                  </label>
                  <p class="text-neutral-600 text-[10px] leading-relaxed w-full">
                    Zapisuje zielony znak przy wierszu, a żółta strzałka zamyka edycję bez zmian.
                  </p>
                </form>

                <%# USUWANIE. Osobny blok, domyslnie schowany, otwierany
                    krzyzykiem z wiersza. Przepisanie numeru sprawdza takze
                    backend, wiec ominiecie formularza nic nie daje. %>
                <div class="hidden mt-4 border-t border-red-400/15 pt-3" data-kasowanie="<%= o.orderRef %>">
                  <p class="text-red-300/90 text-[11px] leading-relaxed mb-2">
                    <% if (o.paidAt) { %>
                      To zlecenie jest <strong>opłacone</strong> (<%= o.totalPLN %> PLN, <%= fmtDateShort(o.paidAt) %>).
                      Usunięcie wiersza zostawia płatność bez zamówienia, więc księgowość i panel przestają się zgadzać.
                      Zwykłą drogą jest anulowanie: numer zostaje rozwiązywalny, klient wchodzący po nim dostaje
                      odpowiedź, a pozycje oferty wracają do puli świadomie.
                    <% } else { %>
                      Usunięcie jest bez cofnięcia.
                    <% } %>
                    Znikają pozycje, pliki do pobrania i rezerwacje, wycena wraca do stanu sprzed konwersji,
                    a jednorazowy kod rabatowy wraca do puli. Podpisane komunikaty płatnicze zostają, bo wiążą się
                    z numerem, nie z wierszem. Towar nie wraca na stan.
                  </p>
                  <form method="post" action="/queue/<%= encodeURIComponent(o.orderRef) %>/delete"
                        class="flex flex-wrap items-end gap-3">
                    <input type="hidden" name="back" value="<%= POWROT %>" />
                    <label class="block">
                      <span class="text-red-300/80 text-[10px] block mb-1">Przepisz numer, żeby potwierdzić</span>
                      <input name="confirmRef" placeholder="<%= o.orderRef %>" autocomplete="off"
                             class="w-56 rounded-lg bg-neutral-900 border border-red-400/25 px-3 py-1.5 text-xs text-white font-mono" />
                    </label>
                    <button class="flex items-center gap-2 px-3 py-1.5 rounded-lg border border-red-400/30 text-red-300 text-xs hover:border-red-400/60 transition-colors">
                      <%- IKONY.krzyzyk %> Usuń trwale
                    </button>
                    <button type="button" data-zamknij-kasowanie="<%= o.orderRef %>"
                            class="p-2 rounded-lg border border-white/15 text-neutral-400 hover:border-white/35 transition-colors"
                            title="Zostaw bez zmian" aria-label="Zamknij usuwanie <%= o.orderRef %>">
                      <%- IKONY.cofnij %>
                    </button>
                  </form>
                </div>

              </td>
            </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <% } %>

  </main>

<script>
  // Rozwijanie wiersza i szukanie. Wszystko na gotowym drzewie: kazdy panel
  // edycji stoi w HTML od poczatku, wiec przy wylaczonym skrypcie widac cala
  // liste, a nie pusta strone.
  (function () {
    var pokaz = function (ref, czy) {
      var wiersz = document.querySelector('[data-edycja="' + ref + '"]');
      if (wiersz) wiersz.classList.toggle("hidden", !czy);
      // Zapis i wycofanie stoja w wierszu, ale znacza cos wylacznie przy
      // otwartej edycji. Przycisk "zapisz" nad zamknietym wierszem nie ma
      // czego zapisac i pytanie, co wtedy robi, jest uzasadnione.
      document.querySelectorAll('[data-akcja-edycji="' + ref + '"]').forEach(function (b) {
        b.classList.toggle("hidden", !czy);
      });
      return wiersz;
    };
    var kasowanie = function (ref, czy) {
      var blok = document.querySelector('[data-kasowanie="' + ref + '"]');
      if (blok) blok.classList.toggle("hidden", !czy);
    };

    // Po KAZDEJ akcji wracamy do tego samego wiersza, otwartego. Przyciski
    // wysylaja formularz, wiec przegladarka laduje liste od nowa i bez tego
    // zlecenie zamykalo sie za kazdym razem, a przy dluzszej liscie znikalo
    // takze z ekranu. Numer przychodzi w adresie, bo serwer wie, czego dotyczyla
    // akcja, a strona po przeladowaniu juz nie.
    var doOtwarcia = new URLSearchParams(location.search).get("otwarte");
    if (doOtwarcia) {
      var wiersz = pokaz(doOtwarcia, true);
      var kotwica = document.querySelector('[data-wiersz="' + doOtwarcia + '"]');
      // Zamowienie skasowane albo odsiane filtrem nie ma juz wiersza i to jest
      // w porzadku: nie przewijamy wtedy donikad.
      if (kotwica) kotwica.scrollIntoView({ block: "center" });
    }

    // Wybor drogi zamkniecia podpowiada kwote zwrotu. Podpowiedz, a nie
    // przymus: pole zostaje do reki, bo ile materialu poszlo, wie czlowiek.
    // Przy drodze, w ktorej zwrot jest obowiazkiem, wpisuje sie cala wplate;
    // przy rezygnacji z rzeczy na zamowienie zero, bo nic sie nie nalezy.
    document.addEventListener("change", function (e) {
      var wybor = e.target.closest('input[type="radio"][name="kind"]');
      if (!wybor) return;
      var pole = wybor.form && wybor.form.querySelector('input[name="refund"]');
      if (!pole) return;
      pole.value = wybor.getAttribute("data-zwrot") === "pelny"
        ? wybor.getAttribute("data-zaplacono")
        : "0.00";
    });

    document.addEventListener("click", function (e) {
      var otworz = e.target.closest("[data-otworz]");
      if (otworz) {
        var ref = otworz.getAttribute("data-otworz");
        var wiersz = document.querySelector('[data-edycja="' + ref + '"]');
        pokaz(ref, wiersz && wiersz.classList.contains("hidden"));
        return;
      }
      var usun = e.target.closest("[data-usun]");
      if (usun) {
        // Krzyzyk otwiera wiersz razem z ostrzezeniem, a nie kasuje od razu.
        // Kasowanie jest jedyna akcja bez cofniecia, a wiersze wygladaja
        // identycznie, wiec musi kosztowac wiecej niz jedno klikniecie.
        var refU = usun.getAttribute("data-usun");
        pokaz(refU, true);
        kasowanie(refU, true);
        return;
      }
      var zamknijK = e.target.closest("[data-zamknij-kasowanie]");
      if (zamknijK) { kasowanie(zamknijK.getAttribute("data-zamknij-kasowanie"), false); return; }
      var zamknij = e.target.closest("[data-zamknij]");
      if (zamknij) {
        // `type="reset"` przywraca pola, a my domykamy wiersz. Kolejnosc ma
        // znaczenie: schowanie przed resetem zostawiloby w polach zmiany,
        // ktore wroca przy nastepnym otwarciu i beda wygladac na zapisane.
        var refZ = zamknij.getAttribute("data-zamknij");
        setTimeout(function () { kasowanie(refZ, false); pokaz(refZ, false); }, 0);
      }
    });

    // Pole zaznaczane przy pozycji wysyla formularz od razu. Osobny przycisk
    // "zapisz" przy kazdej pozycji zamienilby trzy pozycje w sześć klikniec,
    // a stan i tak jest binarny.
    document.addEventListener("change", function (e) {
      var ustal = e.target.closest("[data-ustalenia]");
      if (ustal && ustal.form) { ustal.form.submit(); return; }
      // Odbior osobisty nie ma listu przewozowego, wiec pole znika razem
      // z pytaniem, co w nim wpisac.
      var osobiscie = e.target.closest("[data-osobiscie]");
      if (osobiscie) {
        var ref = osobiscie.getAttribute("data-osobiscie");
        // Bloków przesylkowych jest dwa, numer i przewoznik, wiec chowamy
        // WSZYSTKIE. `querySelector` brał pierwszy i przewoznik zostawal na
        // ekranie przy przekazaniu osobistym, czyli tam, gdzie nikt nie wiezie.
        var bloki = document.querySelectorAll('[data-przesylka="' + ref + '"]');
        for (var b = 0; b < bloki.length; b++) {
          bloki[b].classList.toggle("hidden", osobiscie.checked);
          var pole = bloki[b].querySelector("input, select");
          if (pole && osobiscie.checked) pole.value = "";
        }
      }
    });

    // Kopiowanie linku. `navigator.clipboard` istnieje tylko w kontekscie
    // bezpiecznym, wiec przy panelu po http schodzimy do starej drogi zamiast
    // milczec.
    document.addEventListener("click", function (e) {
      var kop = e.target.closest("[data-kopiuj]");
      if (!kop) return;
      var tekst = kop.getAttribute("data-kopiuj");
      var potwierdz = function () {
        var stary = kop.textContent;
        kop.textContent = "Skopiowane";
        setTimeout(function () { kop.textContent = stary; }, 1200);
      };
      if (navigator.clipboard && window.isSecureContext) {
        navigator.clipboard.writeText(tekst).then(potwierdz);
      } else {
        var pom = document.createElement("textarea");
        pom.value = tekst;
        document.body.appendChild(pom);
        pom.select();
        try { document.execCommand("copy"); potwierdz(); } finally { pom.remove(); }
      }
    });

    var pole = document.getElementById("szukaj");
    if (pole) {
      pole.addEventListener("input", function () {
        var szukane = pole.value.trim().toLowerCase();
        document.querySelectorAll("[data-wiersz]").forEach(function (w) {
          var pasuje = !szukane || (w.getAttribute("data-szukaj") || "").indexOf(szukane) >= 0;
          w.classList.toggle("hidden", !pasuje);
          if (!pasuje) pokaz(w.getAttribute("data-wiersz"), false);
        });
      });
    }
  })();
</script>
</body>
</html>
