<%- include('partials/header', { user: user, title: 'Przelewy', active: 'transfers' }) %>

  <main class="max-w-4xl mx-auto px-6 py-8">

    <div class="mb-6">
      <h1 class="text-2xl font-bold text-white mb-2">Przelewy do potwierdzenia</h1>
      <p class="text-neutral-500 text-xs leading-relaxed max-w-2xl">
        Przelew nie ma powiadomienia z bramki, więc jedynym dowodem wpływu jest wyciąg bankowy. Potwierdzenie
        ustawia zamówienie jako opłacone, wysyła klientowi potwierdzenie przyjęcia należności wraz z informacją
        o rozpoczęciu prac i przenosi pliki do folderu Zamówienia. Wykonuje się raz.
      </p>
    </div>

    <% if (err) { %>
      <div class="rounded-lg border border-red-400/30 bg-red-400/10 p-3 mb-5 text-red-300 text-xs leading-relaxed"><%= err %></div>
    <% } %>
    <% if (msg) { %>
      <div class="rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-3 mb-5 text-emerald-300 text-xs"><%= msg %></div>
    <% } %>

    <% if (!orders.length) { %>
      <div class="rounded-xl border border-dashed border-white/15 bg-white/[0.02] px-6 py-10 text-center">
        <p class="text-neutral-500 text-sm">Żadne zamówienie nie czeka na przelew</p>
      </div>
    <% } else { %>
      <div class="space-y-3">
        <% orders.forEach(function (o) { %>
          <div class="rounded-xl border border-white/10 bg-white/[0.02] p-4">
            <div class="flex flex-wrap items-start justify-between gap-3 mb-3">
              <div>
                <div class="text-white font-mono text-sm"><%= o.orderRef %></div>
                <div class="text-neutral-500 text-[11px] mt-0.5">
                  <% if (o.name) { %><%= o.name %>, <% } %><%= o.email %> &middot; <%= o.lang %>
                </div>
              </div>
              <div class="text-right">
                <div class="text-white font-bold"><%= o.amountEur %> EUR</div>
                <div class="text-neutral-600 text-[10px]">
                  <%= o.totalPLN %> PLN<% if (o.eurRate) { %>, kurs <%= o.eurRate %><% } %>
                </div>
              </div>
            </div>

            <form method="post" action="/transfers/<%= encodeURIComponent(o.orderRef) %>/confirm" class="flex flex-wrap items-center gap-2">
              <input type="number" step="0.01" name="receivedEur"
                     placeholder="Wpłynęło (EUR), domyślnie <%= o.amountEur %>"
                     class="flex-1 min-w-[220px] bg-neutral-900 border border-white/10 rounded-lg px-3 py-2 text-sm text-white" />
              <button name="force" value="false"
                      class="px-4 py-2 rounded-lg bg-emerald-500 hover:bg-emerald-400 text-white text-sm font-medium">
                Potwierdzam wpływ
              </button>
              <!-- Niedoplata nie jest bledem, tylko decyzja. Backend odmawia,
                   podaje roznice, a ten przycisk pozwala przyjac ja swiadomie. -->
              <button name="force" value="true"
                      class="px-3 py-2 rounded-lg border border-amber-400/40 text-amber-300 text-xs hover:border-amber-400/70 transition-colors">
                Potwierdzam mimo różnicy
              </button>
            </form>

            <div class="text-neutral-600 text-[10px] mt-2">
              Złożone <%= fmtDate(o.createdAt) %><% if (o.expiresAt) { %>, kwota ważna do <%= fmtDate(o.expiresAt) %><% } %>
            </div>
          </div>
        <% }); %>
      </div>
    <% } %>

  </main>
</body>
</html>
