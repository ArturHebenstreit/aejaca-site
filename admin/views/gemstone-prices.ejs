<%- include('partials/header', { user: user, title: 'Gemstone Prices', active: 'gems' }) %>

  <main class="max-w-7xl mx-auto px-6 py-8">

    <div class="flex items-center justify-between mb-6">
      <h2 class="text-xl font-semibold text-white">Gemstone Prices</h2>
      <p class="text-xs text-neutral-500">Prices in EUR - frontend converts to PLN using live NBP rate</p>
    </div>

    <% if (flash === 'saved') { %>
    <div class="mb-5 px-4 py-3 bg-emerald-950/50 border border-emerald-500/30 text-emerald-300 rounded-lg text-sm">
      &#10003; Cena zapisana
    </div>
    <% } else if (flash === 'deleted') { %>
    <div class="mb-5 px-4 py-3 bg-neutral-800 border border-white/10 text-neutral-400 rounded-lg text-sm">
      &#128465; Nadpisanie usunięte. Kalkulator liczy ten kamień z ceny wpisanej w cenniku.
    </div>
    <% } %>

    <%# TA TABELA NADPISUJE SAMA CENE, i to jest jedyna rzecz, ktora trzeba
        o niej wiedziec. Lista kamieni, ich nazwy i to, czy sa szlachetne,
        mieszkaja w cenniku (src/pricing/jewelryConfig.js) i kalkulator czyta
        je stamtad. Stad brak przycisku "dodaj": wiersz o identyfikatorze,
        ktorego cennik nie zna, bylby martwy i nikt by tego nie zauwazyl. -%>
    <div class="mb-5 px-4 py-3 rounded-lg border border-white/10 bg-neutral-900 text-xs text-neutral-400 leading-relaxed">
      Ta tabela nadpisuje <strong class="text-neutral-300">wyłącznie cenę</strong>, po identyfikatorze kamienia.
      Lista kamieni i ich nazwy stoją w cenniku, więc usunięcie wiersza nie usuwa kamienia z oferty:
      kalkulator wraca wtedy do ceny wpisanej w kodzie. Z tego samego powodu nie ma tu przycisku
      &bdquo;dodaj&rdquo;: wiersz o identyfikatorze, którego cennik nie zna, nigdzie by się nie pokazał.
    </div>

    <div class="bg-neutral-900 border border-white/10 rounded-xl overflow-hidden">
      <div class="overflow-x-auto">
        <table class="w-full text-sm tabela-akcje">
          <thead>
            <tr class="border-b border-white/10 text-neutral-500 text-xs uppercase tracking-wider">
              <th class="px-4 py-3 text-left">Gem ID</th>
              <th class="px-4 py-3 text-left">Name PL</th>
              <th class="px-4 py-3 text-left">Name EN / DE</th>
              <th class="px-4 py-3 text-right">Base EUR</th>
              <th class="px-4 py-3 text-center">Precious</th>
              <th class="px-4 py-3 text-center">Lab</th>
              <th class="px-4 py-3 text-left">Notes</th>
              <th class="px-4 py-3 text-left">Updated</th>
              <th class="px-4 py-3 text-left">Akcje</th>
            </tr>
          </thead>
          <tbody>
            <% if (gems && gems.length > 0) { %>
              <% gems.forEach(function(gem, i) { %>
              <tr class="border-b border-white/5 hover:bg-white/[0.03] transition-colors group <%= i % 2 === 1 ? 'bg-white/[0.015]' : '' %>">
                <td class="px-4 py-3 font-mono text-xs text-neutral-500"><%= gem.gem_id %></td>
                <td class="px-4 py-3 text-neutral-200 font-medium"><%= gem.name_pl %></td>
                <td class="px-4 py-3 text-neutral-400 text-xs">
                  <div><%= gem.name_en %></div>
                  <div class="text-neutral-600"><%= gem.name_de %></div>
                </td>
                <td class="px-4 py-3 text-right">
                  <% if (gem.base_eur != null) { %>
                    <span class="text-amber-400 font-semibold"><%= parseFloat(gem.base_eur).toFixed(2) %></span>
                    <span class="text-neutral-600 text-xs ml-0.5">€</span>
                  <% } else { %>
                    <span class="text-neutral-600"> - </span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-center">
                  <% if (gem.precious) { %>
                    <span class="text-amber-400 text-xs font-medium">YES</span>
                  <% } else { %>
                    <span class="text-neutral-700 text-xs"> - </span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-center">
                  <% if (gem.lab) { %>
                    <span class="px-1.5 py-0.5 bg-emerald-950 text-emerald-400 rounded text-[10px] font-medium">LAB</span>
                  <% } else { %>
                    <span class="text-neutral-700 text-xs"> - </span>
                  <% } %>
                </td>
                <td class="px-4 py-3 text-neutral-500 text-xs max-w-[160px] truncate" title="<%= gem.notes || '' %>">
                  <%= gem.notes || ' - ' %>
                </td>
                <td class="px-4 py-3 text-neutral-600 text-xs whitespace-nowrap">
                  <%= fmtDate(gem.updated_at) %>
                  <% if (gem.updated_by) { %>
                    <div class="text-neutral-700 truncate max-w-[100px]"><%= gem.updated_by %></div>
                  <% } %>
                </td>
                <td class="px-4 py-3 whitespace-nowrap">
                  <%# Akcje sa widoczne od razu na dotyku, a chowaja sie tylko
                      tam, gdzie jest kursor. Sam `opacity-0` znaczyl na telefonie
                      przycisk, ktorego nie da sie zobaczyc ani trafic. -%>
                  <div class="flex items-center gap-2 sm:opacity-0 sm:group-hover:opacity-100 transition-opacity">
                    <a href="/gemstone-prices/<%= gem.id %>/edit"
                      class="px-3 py-1 bg-amber-950 border border-amber-800/50 text-amber-400 hover:text-amber-300 text-xs rounded transition-colors">
                      Edit
                    </a>
                    <form method="POST" action="/gemstone-prices/<%= gem.id %>/delete"
                          onsubmit="return confirm('Usunąć nadpisanie ceny dla <%= gem.gem_id %>? Kamień zostaje w ofercie, ale kalkulator wróci do ceny wpisanej w cenniku.')">
                      <button type="submit" title="Usuń nadpisanie ceny"
                        class="px-2 py-1 border border-white/10 text-neutral-600 hover:border-red-400/50 hover:text-red-300 text-xs rounded transition-colors">
                        &#128465;
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
              <% }); %>
            <% } else { %>
            <tr>
              <td colspan="9" class="px-4 py-12 text-center text-neutral-600">No gemstone prices found.</td>
            </tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </div>

    <p class="mt-4 text-xs text-neutral-600">
      Changes take effect on the frontend within 24 hours (localStorage cache). Cache is invalidated automatically on save.
    </p>

  </main>

</body>
</html>
