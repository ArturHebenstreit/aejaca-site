<%- include('partials/header', { user: user, title: 'Wycena ' + quote.quoteRef, active: 'quotes' }) %>

<%
  const ZRODLO = { email: "e-mail", phone: "telefon", chat: "czat", quote: "formularz", contact: "kontakt" };
  const zl = (g) => (g == null ? "-" : (g / 100).toFixed(2) + " zł");
  const wyslana = ["sent", "accepted", "converted"].includes(quote.status);
  const pln = (g) => (g == null ? "" : (g / 100).toFixed(2));

  // Grupa wyboru to jedna ramka u klienta: warianty, ktore sie wzajemnie
  // wykluczaja, i dodatki, ktore da sie do nich dolozyc. Numer grupy wchodzi
  // do nazwy przelacznika, bo przegladarka laczy przelaczniki w jeden wybor
  // WYLACZNIE po nazwie pola.
  const KARTY = [];
  items.forEach(function (it) {
    const klucz = (it.groupKey || "").trim() || (it.kind === "fixed" ? "" : "wybor");
    if (klucz && KARTY.indexOf(klucz) < 0) KARTY.push(klucz);
  });
  const nrKarty = (it) => Math.max(0, KARTY.indexOf((it.groupKey || "").trim() || "wybor"));

  const RODZAJE = [
    ["fixed", "składnik rachunku"],
    ["variant", "wariant do wyboru"],
    ["option", "dodatek opcjonalny"],
  ];
  const ETYKIETA_RODZAJU = { fixed: "składnik", variant: "wariant", option: "dodatek" };

  // Ile dni zostalo do konca waznosci. Pole "w dniach" jest puste z zalozenia,
  // wiec bez tej liczby ekran nie mowil, jak dlugo oferta jeszcze obowiazuje;
  // podpowiedz "14" w pustym polu wygladala jak zapisany termin i wracala po
  // kazdym zapisie, cokolwiek by sie wpisalo.
  const DNI_DO_KONCA = quote.validUntil
    ? Math.round((new Date(String(quote.validUntil).slice(0, 10)) - new Date(new Date().toISOString().slice(0, 10))) / 86400000)
    : null;
%>

  <main class="max-w-4xl mx-auto px-6 py-8">

    <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
      <div>
        <a href="/quotes" class="text-neutral-500 text-xs hover:text-white transition-colors">&larr; Wyceny</a>
        <h1 class="text-2xl font-bold text-white mt-1 font-mono"><%= quote.quoteRef %></h1>
        <p class="text-neutral-500 text-xs mt-1">
          <%= ZRODLO[quote.source] || quote.source %> &middot; język <%= quote.lang %> &middot; wpłynęło <%= fmtDate(quote.createdAt) %>
          <% if (quote.sentAt) { %> &middot; wysłane <%= fmtDate(quote.sentAt) %><% } %>
        </p>
      </div>
      <span class="px-3 py-1 rounded-lg border border-white/15 text-xs text-neutral-300"><%= quote.status %></span>
    </div>

    <% if (err) { %>
      <div class="rounded-lg border border-red-400/30 bg-red-400/10 p-3 mb-5 text-red-300 text-xs leading-relaxed"><%= err %></div>
    <% } %>
    <% if (msg) { %>
      <div class="rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-3 mb-5 text-emerald-300 text-xs leading-relaxed"><%= msg %></div>
    <% } %>

    <% if (quote.status === "converted") { %>
      <section class="rounded-xl border border-white/10 bg-white/[0.02] p-5 mb-6">
        <h2 class="text-sm font-semibold text-white mb-3">Klient</h2>
        <dl class="grid sm:grid-cols-3 gap-3 text-xs">
          <div><dt class="text-neutral-600">Imię i nazwisko</dt><dd class="text-neutral-200 mt-0.5"><%= quote.name || '-' %></dd></div>
          <div><dt class="text-neutral-600">E-mail</dt><dd class="text-neutral-200 mt-0.5"><%= quote.email || 'brak' %></dd></div>
          <div><dt class="text-neutral-600">Telefon</dt><dd class="text-neutral-200 mt-0.5"><%= quote.phone || 'brak' %></dd></div>
        </dl>
        <% if (quote.message) { %>
          <div class="mt-4">
            <div class="text-neutral-600 text-xs mb-1">Treść zapytania</div>
            <p class="text-neutral-300 text-xs leading-relaxed whitespace-pre-wrap bg-neutral-950 rounded-lg border border-white/10 p-3"><%= quote.message %></p>
          </div>
        <% } %>
        <div class="mt-4">
          <div class="text-neutral-600 text-xs mb-2">Pozycje</div>
          <ul class="space-y-1">
            <% items.forEach(function (it) { %>
              <li class="text-xs text-neutral-300 flex justify-between gap-4">
                <span><%= it.title %> <span class="text-neutral-600"><%= it.qty %> szt.</span></span>
                <span class="text-neutral-400"><%= zl(it.lineGrosze) %></span>
              </li>
            <% }); %>
          </ul>
        </div>
        <p class="text-neutral-500 text-[10px] leading-relaxed mt-4 pt-3 border-t border-white/10">
          Ta wycena stała się zamówieniem, więc jest zamknięta na edycję. Za nią stoi zamówienie z własnymi
          pozycjami i własną kwotą; zmiana tutaj rozjechałaby jedno z drugim bez śladu. Popraw zamówienie
          w kolejce pracowni.
        </p>
      </section>
    <% } else { %>
      <form method="post" action="/quotes/<%= encodeURIComponent(quote.quoteRef) %>/edit"
            class="rounded-xl border border-white/10 bg-white/[0.02] p-5 mb-6">

        <h2 class="text-sm font-semibold text-white mb-2">Klient i zapytanie</h2>
        <p class="text-neutral-500 text-xs leading-relaxed mb-4 max-w-2xl">
          Poprawianie literówki w adresie, złej ilości albo opisu pozycji. Numer oferty zostaje ten sam,
          więc wątek w korespondencji i tytuł płatności się nie zmieniają.
          <% if (wyslana) { %>
            <span class="text-amber-300">Ta oferta została już wysłana: klient widzi na swojej stronie
            to, co tu zapiszesz.</span>
          <% } %>
        </p>

        <div class="grid sm:grid-cols-4 gap-3">
          <label class="block">
            <span class="text-neutral-400 text-xs">Imię i nazwisko</span>
            <input name="name" value="<%= quote.name || '' %>"
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white" />
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">E-mail</span>
            <input name="email" type="email" value="<%= quote.email || '' %>"
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white" />
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">Telefon</span>
            <input name="phone" value="<%= quote.phone || '' %>"
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white" />
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">Język oferty</span>
            <select name="lang" class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white">
              <% ["pl", "en", "de"].forEach(function (j) { %>
                <option value="<%= j %>" <%= quote.lang === j ? "selected" : "" %>><%= j %></option>
              <% }); %>
            </select>
          </label>
        </div>

        <div class="grid sm:grid-cols-4 gap-3 mt-3">
          <label class="block">
            <span class="text-neutral-400 text-xs">Waluta oferty</span>
            <select name="currency" class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white">
              <% [["PLN", "PLN, złotówki"], ["EUR", "EUR, euro"]].forEach(function (w) { %>
                <option value="<%= w[0] %>" <%= (quote.currency || "PLN") === w[0] ? "selected" : "" %>><%= w[1] %></option>
              <% }); %>
            </select>
          </label>
          <p class="sm:col-span-3 text-neutral-600 text-[10px] leading-relaxed self-end pb-2">
            Waluta dotyczy całej oferty i rozstrzyga o drodze zapłaty:
            <span class="text-neutral-400">złotówki</span> idą bramką, czyli BLIK-iem albo przelewem online,
            <span class="text-neutral-400">euro</span> przelewem na nasz rachunek walutowy, z ręcznym księgowaniem
            i pięcioma dniami roboczymi na wpłatę. Kwota pozycji zostaje w złotówkach; euro liczy się z niej
            po kursie NBP z dnia, w którym klient składa zamówienie, razem z narzutem walutowym.
            Klient może to zmienić u siebie, bo waluta wynika z tego, gdzie ma konto.
          </p>
        </div>

        <p class="text-neutral-600 text-[10px] mt-2">
          Zostaw adres e-mail albo telefon. Bez żadnego z nich nie ma jak przekazać oferty.
          Język decyduje o treści maila, a przy zakładaniu wyceny podpowiada walutę:
          polski to złotówki, angielski i niemiecki to euro.
        </p>

        <label class="block mt-4">
          <span class="text-neutral-400 text-xs">Treść zapytania</span>
          <textarea name="message" rows="3"
                    class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white"><%= quote.message || '' %></textarea>
        </label>

        <h2 class="text-sm font-semibold text-white mt-8 mb-2">Pozycje, kwoty i wybór</h2>
        <p class="text-neutral-500 text-xs leading-relaxed mb-4 max-w-2xl">
          Kwota jednostkowa brutto, w złotych, wpisuje się przy pozycji. Wpisanie pierwszej kwoty zmienia
          zapytanie w ofertę i ustawia termin ważności. Ołówek otwiera resztę pól, czerwony krzyżyk
          usuwa pozycję.
        </p>
        <div class="rounded-lg border border-white/10 bg-neutral-950 p-4 mb-4 max-w-3xl">
          <div class="text-neutral-300 text-xs font-medium mb-2">Rodzaj pozycji i grupa wyboru</div>
          <ul class="text-neutral-500 text-[11px] leading-relaxed space-y-1">
            <li><span class="text-neutral-300">Składnik rachunku</span> jest w kwocie zawsze. Grupa go nie dotyczy.</li>
            <li><span class="text-neutral-300">Wariant do wyboru</span> stoi w grupie i klient bierze z niej
              <span class="text-neutral-300">dokładnie jeden</span>. Wariantów jednej grupy nie da się kupić razem.</li>
            <li><span class="text-neutral-300">Dodatek opcjonalny</span> stoi obok wariantów i klient dokłada go albo nie.</li>
          </ul>
          <p class="text-neutral-500 text-[11px] leading-relaxed mt-3">
            <span class="text-neutral-300">Grupa wyboru</span> to nazwa, którą sam wpisujesz, na przykład
            <span class="font-mono text-neutral-400">klucz</span>. Pozycje z tą samą nazwą stoją u klienta
            w jednej ramce i wykluczają się wzajemnie. Wpisz <span class="font-mono text-neutral-400">odlew</span>
            przy trzech innych pozycjach, a powstanie druga, niezależna ramka: klient wybierze jedną rzecz
            z pierwszej i jedną z drugiej. Grup może być tyle, ile potrzebujesz.
          </p>
          <p class="text-neutral-500 text-[11px] leading-relaxed mt-2">
            Kółko po lewej stronie pozycji ustawia to, co klient zobaczy jako zaznaczone, kiedy otworzy
            ofertę. W grupie wariantów zaznaczony jest zawsze jeden, dodatek zaznaczasz i odznaczasz dowolnie.
            Klient zmieni ten układ u siebie.
          </p>
        </div>

        <datalist id="karty">
          <% KARTY.forEach(function (k) { %><option value="<%= k %>"></option><% }); %>
        </datalist>

        <div class="space-y-3">
          <% items.forEach(function (it, i) { %>
            <div data-pozycja class="rounded-lg border <%= it.selected ? 'border-white/10' : 'border-white/5' %> bg-neutral-950 p-4">
              <input type="hidden" name="itemId" value="<%= it.id %>" />

              <div class="flex items-start gap-3">
                <div class="pt-1 w-4 shrink-0">
                  <% if (it.kind === "variant") { %>
                    <input type="radio" name="pickGroup_<%= nrKarty(it) %>" value="<%= i %>"
                           class="accent-amber-400" <%= it.selected ? "checked" : "" %> />
                  <% } else if (it.kind === "option") { %>
                    <input type="checkbox" name="optionOn" value="<%= i %>"
                           class="accent-amber-400" <%= it.selected ? "checked" : "" %> />
                  <% } else { %>
                    <span class="block w-3 h-3 rounded-full border border-white/20"></span>
                  <% } %>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="text-sm text-white"><%= it.title %></div>
                  <div class="text-neutral-600 text-[10px] mt-0.5">
                    <%= it.qty %> szt.<% if (it.calculator) { %>
                      &middot; <%= it.calculator %><% } %><% if (it.fileName) { %>
                      &middot; <%= it.fileName %><% } %>
                  </div>
                  <% if (it.description) { %>
                    <p class="text-neutral-400 text-xs mt-2 whitespace-pre-wrap"><%= it.description %></p>
                  <% } %>

                  <div class="flex flex-wrap items-end gap-2 mt-2">
                    <label class="block">
                      <span class="text-neutral-500 text-[10px] block mb-1">Rodzaj</span>
                      <select name="itemKind" class="rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white">
                        <% RODZAJE.forEach(function (r) { %>
                          <option value="<%= r[0] %>" <%= (it.kind || "fixed") === r[0] ? "selected" : "" %>><%= r[1] %></option>
                        <% }); %>
                      </select>
                    </label>
                    <label class="block">
                      <span class="text-neutral-500 text-[10px] block mb-1">Grupa wyboru</span>
                      <input name="itemGroup" list="karty" value="<%= it.groupKey || '' %>" placeholder="np. klucz"
                             class="w-36 rounded-lg bg-neutral-900 border border-white/10 px-2 py-1.5 text-[11px] text-white" />
                    </label>
                    <span class="text-neutral-600 text-[10px] pb-2">
                      <% if (it.kind === "variant") { %>
                        jeden z grupy <span class="text-neutral-400 font-mono"><%= it.groupKey || "wybor" %></span><%= it.selected ? ", teraz zaznaczony" : "" %>
                      <% } else if (it.kind === "option") { %>
                        dodatek do grupy <span class="text-neutral-400 font-mono"><%= it.groupKey || "wybor" %></span><%= it.selected ? ", teraz zaznaczony" : ", teraz odznaczony" %>
                      <% } else { %>
                        zawsze w kwocie, grupa bez znaczenia
                      <% } %>
                    </span>
                  </div>
                </div>

                <label class="shrink-0">
                  <span class="text-neutral-500 text-[10px] block mb-1">za sztukę, zł</span>
                  <input name="itemUnitPln" inputmode="decimal" value="<%= pln(it.unitGrosze) %>"
                         class="w-28 rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white text-right" />
                  <% if (it.qty > 1 && it.lineGrosze != null) { %>
                    <span class="text-neutral-600 text-[10px] block mt-1 text-right">razem <%= zl(it.lineGrosze) %></span>
                  <% } %>
                </label>

                <div class="shrink-0 flex items-start gap-1 pt-5">
                  <button type="button" data-edytuj title="Edytuj pozycję"
                          class="p-2 rounded-lg border border-white/10 text-neutral-400 hover:text-white hover:border-white/30 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                    </svg>
                  </button>
                  <button type="submit" name="removeId" value="<%= it.id %>" formnovalidate
                          data-usun="Usunąć pozycję &bdquo;<%= it.title.replace(/"/g, "&quot;") %>&rdquo;? Tego nie da się cofnąć."
                          title="Usuń pozycję"
                          class="p-2 rounded-lg border border-red-400/25 text-red-300 hover:border-red-400/60 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 6 6 18" /><path d="m6 6 12 12" />
                    </svg>
                  </button>
                </div>
              </div>

              <div data-edycja hidden class="mt-4 pt-4 border-t border-white/10 grid sm:grid-cols-6 gap-3">
                <label class="sm:col-span-3 block">
                  <span class="text-neutral-500 text-[10px] block mb-1">Nazwa</span>
                  <input name="itemTitle" value="<%= it.title %>"
                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                </label>
                <label class="block">
                  <span class="text-neutral-500 text-[10px] block mb-1">Ilość</span>
                  <input name="itemQty" type="number" min="1" value="<%= it.qty %>"
                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                </label>
                <label class="sm:col-span-6 block">
                  <span class="text-neutral-500 text-[10px] block mb-1">Opis: to, czego nie widać w nazwie</span>
                  <textarea name="itemDescription" rows="2"
                            class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white"><%= it.description || '' %></textarea>
                </label>
                <% if (it.params && Object.keys(it.params).length) { %>
                  <details class="sm:col-span-6">
                    <summary class="cursor-pointer text-neutral-600 text-[10px]">Parametry z kalkulatora</summary>
                    <pre class="mt-2 text-[10px] text-neutral-500 overflow-x-auto"><%= JSON.stringify(it.params, null, 2) %></pre>
                  </details>
                <% } %>
              </div>
            </div>
          <% }); %>
        </div>

        <div class="rounded-lg border border-dashed border-white/15 p-4 mt-3">
          <div class="text-neutral-500 text-[10px] mb-2">Dodaj pozycję</div>
          <div class="grid sm:grid-cols-6 gap-3">
            <label class="sm:col-span-3 block">
              <span class="text-neutral-500 text-[10px] block mb-1">Nazwa</span>
              <input name="newTitle" placeholder="np. Grawer wewnątrz obrączki"
                     class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
            </label>
            <label class="block">
              <span class="text-neutral-500 text-[10px] block mb-1">Ilość</span>
              <input name="newQty" type="number" min="1" value="1"
                     class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
            </label>
            <label class="block">
              <span class="text-neutral-500 text-[10px] block mb-1">za sztukę, zł</span>
              <input name="newUnitPln" inputmode="decimal" placeholder="np. 40.00"
                     class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white text-right" />
            </label>
            <label class="block">
              <span class="text-neutral-500 text-[10px] block mb-1">Rodzaj</span>
              <select name="newKind" class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white">
                <% RODZAJE.forEach(function (r) { %>
                  <option value="<%= r[0] %>"><%= r[1] %></option>
                <% }); %>
              </select>
            </label>
            <label class="sm:col-span-2 block">
              <span class="text-neutral-500 text-[10px] block mb-1">Grupa wyboru</span>
              <input name="newGroup" list="karty" placeholder="np. klucz"
                     class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
            </label>
            <label class="sm:col-span-4 block">
              <span class="text-neutral-500 text-[10px] block mb-1">Opis, opcjonalnie</span>
              <textarea name="newDescription" rows="2"
                        class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white"></textarea>
            </label>
          </div>
          <p class="text-neutral-600 text-[10px] mt-2">
            Nowy wariant staje się wybrany, gdy jest pierwszy na swojej karcie; nowy dodatek jest
            zaznaczony. Jedno i drugie przestawisz po zapisie.
          </p>
        </div>

        <div class="grid sm:grid-cols-4 gap-3 mt-6">
          <label class="sm:col-span-2 block">
            <span class="text-neutral-400 text-xs">Notatka do oferty: co wchodzi, czego nie ma</span>
            <textarea name="note" rows="3"
                      class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white"><%= quote.priceNote || '' %></textarea>
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">Ważna do dnia</span>
            <input name="validUntil" type="date" value="<%= quote.validUntil ? String(quote.validUntil).slice(0, 10) : '' %>"
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white" />
            <span class="text-neutral-600 text-[10px] block mt-1">
              <% if (quote.validUntil) { %>
                Teraz do <%= fmtDateShort(quote.validUntil) %><%= DNI_DO_KONCA != null ? `, czyli jeszcze ${DNI_DO_KONCA} dni` : "" %>.
              <% } else { %>
                Termin nieustawiony.
              <% } %>
              Puste pole zdejmuje termin.
            </span>
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">Ważna przez, dni</span>
            <input name="validDays" type="number" min="1" max="365" placeholder="np. 30"
                   value="<%= DNI_DO_KONCA != null && DNI_DO_KONCA >= 1 ? DNI_DO_KONCA : '' %>"
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white" />
            <span class="text-neutral-600 text-[10px] block mt-1">
              <% if (DNI_DO_KONCA != null && DNI_DO_KONCA >= 1) { %>
                Tyle dni oferta obowiązuje jeszcze od dzisiaj. Zapisana bez zmiany nie przesuwa terminu,
                bo liczy się do tej samej daty.
              <% } else if (quote.validUntil) { %>
                Termin już minął, wpisz nową liczbę dni albo popraw datę obok.
              <% } else { %>
                Liczy się od dzisiaj. Wpisana liczba wygrywa z datą obok.
              <% } %>
            </span>
          </label>
        </div>
        <p class="text-neutral-600 text-[10px] leading-relaxed mt-2 max-w-2xl">
          Notatka idzie do klienta razem z kwotą, więc to w niej piszesz, co wchodzi w cenę, a czego w niej
          nie ma. Przy wyrobie, w którym kruszec jest główną składową ceny, warto dać termin krótszy niż
          zwykle: przez dwa tygodnie złoto potrafi ruszyć się o kilka procent, a kwotę trzymamy stałą
          do tej daty.
        </p>

        <div class="flex flex-wrap items-center justify-between gap-3 mt-5 pt-4 border-t border-white/10">
          <div class="text-sm text-neutral-300">
            Do zapłaty za zaznaczony układ:
            <span class="text-white font-semibold"><%= zl(quote.totalGrosze) %></span>
            <span class="text-neutral-600 text-[10px] block mt-1 max-w-md leading-relaxed">
              Jeżeli po zapisie żadna zaznaczona pozycja nie ma kwoty, oferta wraca do stanu „nowa"
              i traci termin ważności.
            </span>
          </div>
          <button class="px-4 py-2 rounded-lg bg-amber-400 text-neutral-950 text-sm font-medium hover:bg-amber-300 transition-colors">
            Zapisz ofertę
          </button>
        </div>
      </form>
    <% } %>

    <section class="rounded-xl border border-white/10 bg-white/[0.02] p-5">
      <h2 class="text-sm font-semibold text-white mb-2">Przekazanie oferty</h2>
      <p class="text-neutral-500 text-xs leading-relaxed mb-4 max-w-2xl">
        Wysłanie oznacza, że kwota wyszła na zewnątrz i od tej chwili obowiązuje. Klient bez adresu e-mail
        listu nie dostanie, więc link poniżej przekazujesz sam. Ten sam adres prowadzi do zapłaty,
        a tytułem przelewu jest numer wyceny.
      </p>

      <label class="block mb-4">
        <span class="text-neutral-400 text-xs">Link dla klienta</span>
        <input readonly value="<%= offerUrl %>" onclick="this.select()"
               class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-neutral-300 font-mono" />
      </label>

      <% if (quote.pickupCode) { %>
        <div class="rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 mb-4">
          <div class="text-amber-300 text-xs font-medium mb-1">Kod odbioru: <span class="font-mono text-sm"><%= quote.pickupCode %></span></div>
          <p class="text-amber-300/80 text-[11px] leading-relaxed">
            Ten klient nie ma adresu e-mail, więc oferty nie potwierdzi adresem. Podyktuj mu numer wyceny i ten kod:
            wpisze je na stronie <span class="font-mono">aejaca.com/oferta</span> i przejdzie do zapłaty bez linku.
          </p>
        </div>
      <% } else { %>
        <p class="text-neutral-500 text-xs leading-relaxed mb-4">
          Klient może też wejść na <span class="font-mono text-neutral-400">aejaca.com/oferta</span> i podać numer wyceny
          razem z adresem e-mail, na który poszła oferta. Link nie jest do tego potrzebny.
        </p>
      <% } %>

      <div class="flex flex-wrap items-center gap-3">
        <form method="post" action="/quotes/<%= encodeURIComponent(quote.quoteRef) %>/send">
          <button class="px-4 py-2 rounded-lg border border-white/15 text-neutral-200 text-sm hover:border-white/35 transition-colors"
                  <%= quote.totalGrosze ? '' : 'disabled' %>>
            <%= wyslana ? 'Wyślij ponownie' : 'Wyślij ofertę' %>
          </button>
        </form>
        <% if (!quote.totalGrosze) { %>
          <span class="text-amber-300/80 text-xs">Najpierw wpisz kwoty pozycji.</span>
        <% } %>
      </div>
    </section>

    <form id="usun" method="post" action="/quotes/<%= encodeURIComponent(quote.quoteRef) %>/delete"
          class="rounded-xl border border-red-400/20 bg-red-400/[0.03] p-5 mt-6 scroll-mt-8">
      <h2 class="text-sm font-semibold text-red-300 mb-2">Usuń wycenę trwale</h2>
      <p class="text-neutral-500 text-xs leading-relaxed mb-4 max-w-2xl">
        Bez cofnięcia. Znikają pozycje wyceny, zostają wgrane pliki klienta i numer przestaje istnieć,
        więc link, który klient ma w mailu, przestanie działać.
        <% if (quote.status === "converted") { %>
          <span class="text-red-300">Ta wycena stała się zamówieniem. Samo zamówienie zostanie, ale zniknie
          ślad, skąd pochodzi, dlatego wymaga osobnego potwierdzenia.</span>
        <% } %>
      </p>
      <div class="flex flex-wrap items-end gap-3">
        <label class="block">
          <span class="text-red-300/80 text-[10px] block mb-1">Przepisz numer wyceny</span>
          <input name="confirmRef" placeholder="<%= quote.quoteRef %>" autocomplete="off"
                 class="w-64 rounded-lg bg-neutral-900 border border-red-400/25 px-3 py-2 text-xs text-white font-mono" />
        </label>
        <% if (quote.status === "converted") { %>
          <label class="flex items-center gap-2 text-xs text-neutral-300 pb-2">
            <input type="checkbox" name="force" class="accent-red-400" />
            Wiem, że stoi za nią zamówienie
          </label>
        <% } %>
        <button class="px-4 py-2 rounded-lg border border-red-400/30 text-red-300 text-sm hover:border-red-400/60 transition-colors">
          Usuń wycenę
        </button>
      </div>
    </form>

  </main>

  <script>
    // Olowek otwiera reszte pol pozycji. Pola zostaja w formularzu takze
    // zamkniete, wiec zapis niesie je zawsze i nic nie gubi sie po drodze.
    document.querySelectorAll("[data-edytuj]").forEach(function (b) {
      b.addEventListener("click", function () {
        var karta = b.closest("[data-pozycja]");
        var pola = karta && karta.querySelector("[data-edycja]");
        if (!pola) return;
        pola.hidden = !pola.hidden;
        var pierwsze = pola.querySelector("input, textarea, select");
        if (!pola.hidden && pierwsze) pierwsze.focus();
      });
    });

    // Krzyzyk pyta, zanim usunie. Bez tego jedno omylkowe klikniecie kasuje
    // pozycje oferty, ktora klient juz widzial.
    document.querySelectorAll("[data-usun]").forEach(function (b) {
      b.addEventListener("click", function (e) {
        if (!window.confirm(b.dataset.usun)) e.preventDefault();
      });
    });
  </script>
</body>
</html>
