<%- include('partials/header', { user: user, title: 'Wycena ' + quote.quoteRef, active: 'quotes' }) %>

<%
  const ZRODLO = { email: "e-mail", phone: "telefon", chat: "czat", quote: "formularz", contact: "kontakt" };
  const zl = (g) => (g == null ? "-" : (g / 100).toFixed(2) + " zł");
  const pln = (g) => (g == null ? "" : (g / 100).toFixed(2));
  const wyslana = ["sent", "accepted", "converted"].includes(quote.status);

  // Grupa wyboru to jedna ramka u klienta: warianty, ktore sie wzajemnie
  // wykluczaja, i dodatki, ktore da sie do nich dolozyc. Numer grupy wchodzi
  // do nazwy przelacznika, bo przegladarka laczy przelaczniki w jeden wybor
  // WYLACZNIE po nazwie pola.
  const KARTY = [];
  items.forEach(function (it) {
    const klucz = (it.groupKey || "").trim() || (it.kind === "fixed" ? "" : "wybor");
    if (klucz && KARTY.indexOf(klucz) < 0) KARTY.push(klucz);
  });
  // Nazwa przelacznika bierze sie z NAZWY GRUPY, tak samo tutaj i w skrypcie
  // ponizej. Gdyby serwer numerowal grupy, a skrypt je slugowal, po pierwszym
  // zapisie polowa wierszy miala by stara nazwe, a polowa nowa i przelaczniki
  // przestalyby sie wykluczac.
  const nazwaGrupy = (it) => "pickGroup_" + ((it.groupKey || "").trim() || "wybor").replace(/[^A-Za-z0-9_-]/g, "_");

  const RODZAJE = [
    ["fixed", "składnik rachunku"],
    ["variant", "wariant do wyboru"],
    ["option", "dodatek opcjonalny"],
  ];
  const ETYKIETA_RODZAJU = { fixed: "składnik", variant: "wariant", option: "dodatek" };

  // Ile dni zostalo do konca waznosci. Pole "w dniach" pokazuje te liczbe,
  // a nie podpowiedz: wczesniej stalo w nim na sztywno "14" i wygladalo to
  // jak zapisany termin, ktory wraca po kazdym zapisie.
  const DNI_DO_KONCA = quote.validUntil
    ? Math.round((new Date(String(quote.validUntil).slice(0, 10)) - new Date(new Date().toISOString().slice(0, 10))) / 86400000)
    : null;
%>

  <main class="max-w-4xl mx-auto px-6 py-8" data-wycena="<%= quote.quoteRef %>">

    <div class="mb-6 flex flex-wrap items-start justify-between gap-3">
      <div>
        <a href="/quotes" class="text-neutral-500 text-xs hover:text-white transition-colors">&larr; Wyceny</a>
        <h1 class="text-2xl font-bold text-white mt-1 font-mono"><%= quote.quoteRef %></h1>
        <p class="text-neutral-500 text-xs mt-1">
          <%= ZRODLO[quote.source] || quote.source %> &middot; język <%= quote.lang %> &middot; wpłynęło <%= fmtDate(quote.createdAt) %>
          <% if (quote.sentAt) { %> &middot; wysłane <%= fmtDate(quote.sentAt) %><% } %>
        </p>
      </div>
      <div class="text-right">
        <span data-stan class="px-3 py-1 rounded-lg border border-white/15 text-xs text-neutral-300"><%= quote.status %></span>
        <div class="text-neutral-500 text-[10px] mt-2">
          Do zapłaty: <span data-suma class="text-white font-semibold"><%= zl(quote.totalGrosze) %></span>
          <span data-waluta><%= quote.currency || "PLN" %></span>
        </div>
      </div>
    </div>

    <% if (err) { %>
      <div class="rounded-lg border border-red-400/30 bg-red-400/10 p-3 mb-5 text-red-300 text-xs leading-relaxed"><%= err %></div>
    <% } %>
    <% if (msg) { %>
      <div class="rounded-lg border border-emerald-400/30 bg-emerald-400/10 p-3 mb-5 text-emerald-300 text-xs leading-relaxed"><%= msg %></div>
    <% } %>

    <noscript>
      <div class="rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 mb-5 text-amber-200 text-xs leading-relaxed">
        Edytor wycen zapisuje zmiany bez przycisku, więc potrzebuje JavaScriptu. Bez niego zobaczysz treść oferty,
        ale jej nie poprawisz.
      </div>
    </noscript>

    <% if (quote.status === "converted") { %>
      <section class="rounded-xl border border-white/10 bg-white/[0.02] p-5 mb-6">
        <h2 class="text-sm font-semibold text-white mb-3">Klient</h2>
        <dl class="grid sm:grid-cols-3 gap-3 text-xs">
          <div><dt class="text-neutral-600">Imię i nazwisko</dt><dd class="text-neutral-200 mt-0.5"><%= quote.name || '-' %></dd></div>
          <div><dt class="text-neutral-600">E-mail</dt><dd class="text-neutral-200 mt-0.5"><%= quote.email || 'brak' %></dd></div>
          <div><dt class="text-neutral-600">Telefon</dt><dd class="text-neutral-200 mt-0.5"><%= quote.phone || 'brak' %></dd></div>
        </dl>
        <% if (quote.message) { %>
          <div class="mt-4">
            <div class="text-neutral-600 text-xs mb-1">Treść zapytania</div>
            <p class="text-neutral-300 text-xs leading-relaxed whitespace-pre-wrap bg-neutral-950 rounded-lg border border-white/10 p-3"><%= quote.message %></p>
          </div>
        <% } %>
        <div class="mt-4">
          <div class="text-neutral-600 text-xs mb-2">Pozycje</div>
          <ul class="space-y-1">
            <% items.forEach(function (it) { %>
              <li class="text-xs text-neutral-300 flex justify-between gap-4">
                <span><%= it.title %> <span class="text-neutral-600"><%= it.qty %> szt.</span></span>
                <span class="text-neutral-400"><%= zl(it.lineGrosze) %></span>
              </li>
            <% }); %>
          </ul>
        </div>
        <p class="text-neutral-500 text-[10px] leading-relaxed mt-4 pt-3 border-t border-white/10">
          Ta wycena stała się zamówieniem, więc jest zamknięta na edycję. Za nią stoi zamówienie z własnymi
          pozycjami i własną kwotą; zmiana tutaj rozjechałaby jedno z drugim bez śladu. Popraw zamówienie
          w kolejce pracowni.
        </p>
      </section>
    <% } else { %>

      <!-- ===================== REKORD: NAGLOWEK OFERTY ===================== -->
      <!-- Dane klienta, jezyk, waluta, termin i notatka to JEDEN rekord: zmieniaja
           sie razem i razem ida do bazy. Olowek otwiera, zielony ptaszek zapisuje. -->
      <section data-rekord="naglowek" class="rounded-xl border border-white/10 bg-white/[0.02] p-5 mb-6">
        <div class="flex items-start justify-between gap-3 mb-4">
          <div>
            <h2 class="text-sm font-semibold text-white">Oferta: klient, waluta i termin</h2>
            <p class="text-neutral-500 text-xs leading-relaxed mt-1 max-w-2xl">
              Numer oferty zostaje ten sam, więc wątek w korespondencji i tytuł płatności się nie zmieniają.
              <% if (wyslana) { %>
                <span class="text-amber-300">Ta oferta została już wysłana: klient widzi na swojej stronie
                to, co tu zapiszesz.</span>
              <% } %>
            </p>
          </div>
          <div class="shrink-0 flex items-start gap-1">
            <span data-stan-zapisu class="text-neutral-600 text-[10px] pt-2 pr-1"></span>
            <button type="button" data-edytuj title="Edytuj dane oferty"
                    class="p-2 rounded-lg border border-white/10 text-neutral-400 hover:text-white hover:border-white/30 transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
              </svg>
            </button>
            <button type="button" data-zapisz disabled title="Zapisz zmiany"
                    class="p-2 rounded-lg border border-emerald-400/25 text-emerald-300 hover:border-emerald-400/60 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20 6 9 17l-5-5" />
              </svg>
            </button>
            <button type="button" data-anuluj hidden title="Odrzuć zmiany"
                    class="p-2 rounded-lg border border-white/10 text-neutral-400 hover:text-white hover:border-white/30 transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
              </svg>
            </button>
          </div>
        </div>

        <div class="grid sm:grid-cols-4 gap-3">
          <label class="block">
            <span class="text-neutral-400 text-xs">Imię i nazwisko</span>
            <input data-pole="name" value="<%= quote.name || '' %>" disabled
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70" />
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">E-mail</span>
            <input data-pole="email" type="email" value="<%= quote.email || '' %>" disabled
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70" />
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">Telefon</span>
            <input data-pole="phone" value="<%= quote.phone || '' %>" disabled
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70" />
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">Język oferty</span>
            <select data-pole="lang" disabled
                    class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70">
              <% ["pl", "en", "de"].forEach(function (j) { %>
                <option value="<%= j %>" <%= quote.lang === j ? "selected" : "" %>><%= j %></option>
              <% }); %>
            </select>
          </label>
        </div>

        <div class="grid sm:grid-cols-4 gap-3 mt-3">
          <label class="block">
            <span class="text-neutral-400 text-xs">Waluta oferty</span>
            <select data-pole="currency" disabled
                    class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70">
              <% [["PLN", "PLN, złotówki"], ["EUR", "EUR, euro"]].forEach(function (w) { %>
                <option value="<%= w[0] %>" <%= (quote.currency || "PLN") === w[0] ? "selected" : "" %>><%= w[1] %></option>
              <% }); %>
            </select>
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">Ważna do dnia</span>
            <input data-pole="validUntil" type="date" disabled
                   value="<%= quote.validUntil ? String(quote.validUntil).slice(0, 10) : '' %>"
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70" />
          </label>
          <label class="block">
            <span class="text-neutral-400 text-xs">Ważna przez, dni</span>
            <input data-pole="validDays" type="number" min="1" max="365" placeholder="np. 30" disabled
                   value="<%= DNI_DO_KONCA != null && DNI_DO_KONCA >= 1 ? DNI_DO_KONCA : '' %>"
                   class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70" />
          </label>
          <p class="text-neutral-600 text-[10px] leading-relaxed self-end pb-2">
            <% if (DNI_DO_KONCA != null && DNI_DO_KONCA >= 1) { %>
              Oferta obowiązuje jeszcze <%= DNI_DO_KONCA %> dni, do <%= fmtDateShort(quote.validUntil) %>.
              Zapisana bez zmiany nie przesuwa terminu.
            <% } else if (quote.validUntil) { %>
              Termin minął <%= fmtDateShort(quote.validUntil) %>. Wpisz nową liczbę dni albo popraw datę.
            <% } else { %>
              Termin nieustawiony. Liczba dni liczy się od dzisiaj i wygrywa z datą obok.
            <% } %>
          </p>
        </div>

        <label class="block mt-3">
          <span class="text-neutral-400 text-xs">Treść zapytania</span>
          <textarea data-pole="message" rows="2" disabled
                    class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70"><%= quote.message || '' %></textarea>
        </label>

        <label class="block mt-3">
          <span class="text-neutral-400 text-xs">Notatka do oferty: co wchodzi, czego nie ma</span>
          <textarea data-pole="note" rows="2" disabled
                    class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-sm text-white disabled:opacity-70"><%= quote.priceNote || '' %></textarea>
        </label>

        <p class="text-neutral-600 text-[10px] leading-relaxed mt-3">
          Notatka idzie do klienta razem z kwotą. Waluta dotyczy całej oferty i rozstrzyga o drodze zapłaty:
          złotówki idą bramką, euro przelewem na rachunek walutowy. Zostaw adres e-mail albo telefon, bez
          żadnego z nich nie ma jak przekazać oferty.
        </p>
        <p data-blad class="text-red-300 text-xs mt-2" hidden></p>
      </section>

      <!-- ===================== REKORDY: POZYCJE ===================== -->
      <section class="rounded-xl border border-white/10 bg-white/[0.02] p-5 mb-6">
        <h2 class="text-sm font-semibold text-white mb-2">Pozycje, kwoty i wybór</h2>
        <p class="text-neutral-500 text-xs leading-relaxed mb-4 max-w-2xl">
          Nie ma przycisku „zapisz ofertę”. Każda pozycja jest osobnym rekordem: ołówek otwiera ją do
          edycji, zielony ptaszek zapisuje ją w bazie, strzałka odrzuca zmiany. Kółko i kwadracik po lewej
          zapisują się od razu po kliknięciu, bo kliknięcie jest całą decyzją.
        </p>

        <div class="rounded-lg border border-white/10 bg-neutral-950 p-4 mb-4 max-w-3xl">
          <div class="text-neutral-300 text-xs font-medium mb-2">Rodzaj pozycji i grupa wyboru</div>
          <ul class="text-neutral-500 text-[11px] leading-relaxed space-y-1">
            <li><span class="text-neutral-300">Składnik rachunku</span> jest w kwocie zawsze. Grupa go nie dotyczy.</li>
            <li><span class="text-neutral-300">Wariant do wyboru</span> stoi w grupie i klient bierze z niej
              <span class="text-neutral-300">dokładnie jeden</span>.</li>
            <li><span class="text-neutral-300">Dodatek opcjonalny</span> stoi obok wariantów i klient dokłada go albo nie.</li>
          </ul>
          <p class="text-neutral-500 text-[11px] leading-relaxed mt-3">
            <span class="text-neutral-300">Grupa wyboru</span> to nazwa, którą sam wpisujesz, na przykład
            <span class="font-mono text-neutral-400">klucz</span>. Pozycje z tą samą nazwą stoją u klienta
            w jednej ramce i wykluczają się wzajemnie. Wpisz <span class="font-mono text-neutral-400">odlew</span>
            przy trzech innych, a powstanie druga, niezależna ramka: klient wybierze jedną rzecz z pierwszej
            i jedną z drugiej.
          </p>
        </div>

        <datalist id="karty">
          <% KARTY.forEach(function (k) { %><option value="<%= k %>"></option><% }); %>
        </datalist>

        <div data-lista class="space-y-3">
          <% items.forEach(function (it, i) { %>
            <div data-rekord="pozycja" data-id="<%= it.id %>"
                 class="rounded-lg border <%= it.selected ? 'border-white/10' : 'border-white/5' %> bg-neutral-950 p-4">

              <div class="flex items-start gap-3">
                <!-- Kontrolka wyboru zmienia sie razem z rodzajem pozycji: wariant
                     ma przelacznik, dodatek pole zaznaczane, skladnik nic. Dlatego
                     stoi w osobnym miejscu, ktore skrypt wymienia po zapisie.
                     Wczesniej zostawal przelacznik po starym rodzaju az do F5. -->
                <div data-wybor-miejsce class="pt-1 w-4 shrink-0">
                  <% if (it.kind === "variant") { %>
                    <input type="radio" data-wybor name="<%= nazwaGrupy(it) %>"
                           class="accent-amber-400" <%= it.selected ? "checked" : "" %> />
                  <% } else if (it.kind === "option") { %>
                    <input type="checkbox" data-wybor class="accent-amber-400" <%= it.selected ? "checked" : "" %> />
                  <% } else { %>
                    <span class="block w-3 h-3 rounded-full border border-white/20"></span>
                  <% } %>
                </div>

                <div class="min-w-0 flex-1">
                  <div class="text-sm text-white" data-podglad="title"><%= it.title %></div>
                  <div class="text-neutral-600 text-[10px] mt-0.5">
                    <span data-podglad="qty"><%= it.qty %></span> szt.
                    &middot; <span data-podglad="kind"><%= ETYKIETA_RODZAJU[it.kind] || "składnik" %></span><span
                      data-meta="grupa" <%= it.kind === "fixed" ? 'style="display:none"' : "" %>>
                      &middot; grupa <span data-podglad="groupKey" class="font-mono"><%= it.groupKey || "wybor" %></span></span><% if (it.calculator) { %>
                      &middot; <%= it.calculator %><% } %><% if (it.fileName) { %>
                      &middot; <%= it.fileName %><% } %>
                  </div>
                  <p class="text-neutral-400 text-xs mt-2 whitespace-pre-wrap" data-podglad="description" <%= it.description ? "" : "hidden" %>><%= it.description || '' %></p>
                </div>

                <div class="shrink-0 text-right">
                  <div class="text-neutral-500 text-[10px]">za sztukę, zł</div>
                  <div class="text-sm text-white" data-podglad="unitPln"><%= it.unitGrosze != null ? pln(it.unitGrosze) : "-" %></div>
                  <% if (it.qty > 1 && it.lineGrosze != null) { %>
                    <div class="text-neutral-600 text-[10px]" data-podglad="line">razem <%= zl(it.lineGrosze) %></div>
                  <% } %>
                </div>

                <div class="shrink-0 flex items-start gap-1">
                  <span data-stan-zapisu class="text-neutral-600 text-[10px] pt-2 pr-1"></span>
                  <button type="button" data-edytuj title="Edytuj pozycję"
                          class="p-2 rounded-lg border border-white/10 text-neutral-400 hover:text-white hover:border-white/30 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 20h9" /><path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L7 19l-4 1 1-4Z" />
                    </svg>
                  </button>
                  <button type="button" data-zapisz disabled title="Zapisz pozycję"
                          class="p-2 rounded-lg border border-emerald-400/25 text-emerald-300 hover:border-emerald-400/60 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M20 6 9 17l-5-5" />
                    </svg>
                  </button>
                  <button type="button" data-anuluj hidden title="Odrzuć zmiany"
                          class="p-2 rounded-lg border border-white/10 text-neutral-400 hover:text-white hover:border-white/30 transition-colors">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />
                    </svg>
                  </button>
                  <button type="button" data-usun title="Usuń pozycję"
                          class="p-2 rounded-lg border border-red-400/25 text-red-300 hover:border-red-400/60 transition-colors disabled:opacity-30 disabled:cursor-not-allowed">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M18 6 6 18" /><path d="m6 6 12 12" />
                    </svg>
                  </button>
                </div>
              </div>

              <!-- Chowamy stylem, a nie atrybutem `hidden`: klasa `grid` ustawia
                   `display:grid` z ta sama moc co `[hidden]{display:none}`,
                   a stoi w arkuszu nizej, wiec wygrywa i blok zostawal widoczny. -->
              <div data-edycja style="display:none" class="mt-4 pt-4 border-t border-white/10 grid sm:grid-cols-6 gap-3">
                <label class="sm:col-span-3 block">
                  <span class="text-neutral-500 text-[10px] block mb-1">Nazwa</span>
                  <input data-pole="title" value="<%= it.title %>"
                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                </label>
                <label class="block">
                  <span class="text-neutral-500 text-[10px] block mb-1">Ilość</span>
                  <input data-pole="qty" type="number" min="1" value="<%= it.qty %>"
                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                </label>
                <label class="block">
                  <span class="text-neutral-500 text-[10px] block mb-1">za sztukę, zł</span>
                  <input data-pole="unitPln" inputmode="decimal" value="<%= pln(it.unitGrosze) %>"
                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white text-right" />
                </label>
                <label class="block">
                  <span class="text-neutral-500 text-[10px] block mb-1">Rodzaj</span>
                  <select data-pole="kind" class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white">
                    <% RODZAJE.forEach(function (r) { %>
                      <option value="<%= r[0] %>" <%= (it.kind || "fixed") === r[0] ? "selected" : "" %>><%= r[1] %></option>
                    <% }); %>
                  </select>
                </label>
                <label class="block">
                  <span class="text-neutral-500 text-[10px] block mb-1">Grupa wyboru</span>
                  <input data-pole="groupKey" list="karty" value="<%= it.groupKey || '' %>" placeholder="np. klucz"
                         class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white" />
                  <!-- Lista rozwijalna pokazuje sie dopiero po kliknieciu w strzalke,
                       wiec grupy z innych pozycji stoja tez tutaj, do klikniecia.
                       O to chodzi w grupowaniu: nazwa musi byc DOKLADNIE ta sama. -->
                  <span data-podpowiedzi-grup class="flex flex-wrap gap-1 mt-1"></span>
                </label>
                <label class="sm:col-span-6 block">
                  <span class="text-neutral-500 text-[10px] block mb-1">Opis: to, czego nie widać w nazwie</span>
                  <textarea data-pole="description" rows="2"
                            class="w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-white"><%= it.description || '' %></textarea>
                </label>
                <% if (it.params && Object.keys(it.params).length) { %>
                  <details class="sm:col-span-6">
                    <summary class="cursor-pointer text-neutral-600 text-[10px]">Parametry z kalkulatora</summary>
                    <pre class="mt-2 text-[10px] text-neutral-500 overflow-x-auto"><%= JSON.stringify(it.params, null, 2) %></pre>
                  </details>
                <% } %>
              </div>
              <p data-blad class="text-red-300 text-xs mt-2" hidden></p>
            </div>
          <% }); %>
        </div>

        <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
          <button type="button" data-dodaj
                  class="px-4 py-2 rounded-lg border border-white/15 text-neutral-200 text-sm hover:border-white/35 transition-colors">
            + Dodaj pozycję
          </button>
          <p class="text-neutral-600 text-[10px] max-w-md leading-relaxed">
            Nowa pozycja otwiera się od razu do wpisania. Zapisz ją ptaszkiem, a pojawi się miejsce na kolejną.
            Jeżeli żadna zaznaczona pozycja nie ma kwoty, oferta wraca do stanu „nowa” i traci termin ważności.
          </p>
        </div>
      </section>
    <% } %>

    <section class="rounded-xl border border-white/10 bg-white/[0.02] p-5">
      <h2 class="text-sm font-semibold text-white mb-2">Przekazanie oferty</h2>
      <p class="text-neutral-500 text-xs leading-relaxed mb-4 max-w-2xl">
        Wysłanie oznacza, że kwota wyszła na zewnątrz i od tej chwili obowiązuje. Klient bez adresu e-mail
        listu nie dostanie, więc link poniżej przekazujesz sam. Ten sam adres prowadzi do zapłaty,
        a tytułem przelewu jest numer wyceny.
      </p>

      <label class="block mb-4">
        <span class="text-neutral-400 text-xs">Link dla klienta</span>
        <input readonly value="<%= offerUrl %>" onclick="this.select()"
               class="mt-1 w-full rounded-lg bg-neutral-900 border border-white/10 px-3 py-2 text-xs text-neutral-300 font-mono" />
      </label>

      <% if (quote.pickupCode) { %>
        <div class="rounded-lg border border-amber-400/30 bg-amber-400/10 p-3 mb-4">
          <div class="text-amber-300 text-xs font-medium mb-1">Kod odbioru: <span class="font-mono text-sm"><%= quote.pickupCode %></span></div>
          <p class="text-amber-300/80 text-[11px] leading-relaxed">
            Ten klient nie ma adresu e-mail, więc oferty nie potwierdzi adresem. Podyktuj mu numer wyceny i ten kod:
            wpisze je na stronie <span class="font-mono">aejaca.com/oferta</span> i przejdzie do zapłaty bez linku.
          </p>
        </div>
      <% } else { %>
        <p class="text-neutral-500 text-xs leading-relaxed mb-4">
          Klient może też wejść na <span class="font-mono text-neutral-400">aejaca.com/oferta</span> i podać numer wyceny
          razem z adresem e-mail, na który poszła oferta. Link nie jest do tego potrzebny.
        </p>
      <% } %>

      <div class="flex flex-wrap items-center gap-3">
        <form method="post" action="/quotes/<%= encodeURIComponent(quote.quoteRef) %>/send">
          <button class="px-4 py-2 rounded-lg border border-white/15 text-neutral-200 text-sm hover:border-white/35 transition-colors"
                  <%= quote.totalGrosze ? '' : 'disabled' %>>
            <%= wyslana ? 'Wyślij ponownie' : 'Wyślij ofertę' %>
          </button>
        </form>
        <% if (!quote.totalGrosze) { %>
          <span class="text-amber-300/80 text-xs">Najpierw wpisz kwoty pozycji.</span>
        <% } %>
      </div>
    </section>

    <form id="usun" method="post" action="/quotes/<%= encodeURIComponent(quote.quoteRef) %>/delete"
          class="rounded-xl border border-red-400/20 bg-red-400/[0.03] p-5 mt-6 scroll-mt-8">
      <h2 class="text-sm font-semibold text-red-300 mb-2">Usuń wycenę trwale</h2>
      <p class="text-neutral-500 text-xs leading-relaxed mb-4 max-w-2xl">
        Bez cofnięcia. Znikają pozycje wyceny, zostają wgrane pliki klienta i numer przestaje istnieć,
        więc link, który klient ma w mailu, przestanie działać.
        <% if (quote.status === "converted") { %>
          <span class="text-red-300">Ta wycena stała się zamówieniem. Samo zamówienie zostanie, ale zniknie
          ślad, skąd pochodzi, dlatego wymaga osobnego potwierdzenia.</span>
        <% } %>
      </p>
      <div class="flex flex-wrap items-end gap-3">
        <label class="block">
          <span class="text-red-300/80 text-[10px] block mb-1">Przepisz numer wyceny</span>
          <input name="confirmRef" placeholder="<%= quote.quoteRef %>" autocomplete="off"
                 class="w-64 rounded-lg bg-neutral-900 border border-red-400/25 px-3 py-2 text-xs text-white font-mono" />
        </label>
        <% if (quote.status === "converted") { %>
          <label class="flex items-center gap-2 text-xs text-neutral-300 pb-2">
            <input type="checkbox" name="force" class="accent-red-400" />
            Wiem, że stoi za nią zamówienie
          </label>
        <% } %>
        <button class="px-4 py-2 rounded-lg border border-red-400/30 text-red-300 text-sm hover:border-red-400/60 transition-colors">
          Usuń wycenę
        </button>
      </div>
    </form>

  </main>

  <script>
  // ============================================================
  // EDYTOR WYCEN: ZAPIS NA POZIOMIE REKORDU
  // ============================================================
  // Przycisku "zapisz" nie ma, ale zapis nie idzie po kazdym znaku. Rekord to
  // jedna pozycja albo naglowek oferty; olowek go otwiera, zielony ptaszek
  // wysyla go do bazy jednym zadaniem.
  //
  // Dlaczego nie po kazdym znaku:
  //   - w bazie ladowalyby stany niedokonczone ("Wydruk klu", cena 4 grosze),
  //     a przy ofercie juz wyslanej widzi je klient na swojej stronie;
  //   - kazdy zapis to transakcja, ktora przelicza sume, pilnuje reguly "jeden
  //     wariant w grupie" i potrafi zmienic stan oferty. Kilkaset takich
  //     transakcji na sesje edycji to koszt bez pokrycia.
  //
  // Klikniecie w kolko albo kwadracik zapisuje sie OD RAZU: nie ma tam stanu
  // posredniego, wiec nie ma czego zatwierdzac.
  (function () {
    var ref = document.querySelector("[data-wycena]").dataset.wycena;
    var lista = document.querySelector("[data-lista]");
    if (!lista) return;   // wycena przekuta w zamowienie: tylko do ogladania

    function pola(rekord) {
      return Array.prototype.slice.call(rekord.querySelectorAll("[data-pole]"));
    }

    function stan(rekord, tekst, kolor) {
      var s = rekord.querySelector("[data-stan-zapisu]");
      if (!s) return;
      s.textContent = tekst || "";
      s.className = "text-[10px] pt-2 pr-1 " + (kolor || "text-neutral-600");
    }

    function blad(rekord, tekst) {
      var p = rekord.querySelector("[data-blad]");
      if (!p) return;
      p.textContent = tekst || "";
      p.hidden = !tekst;
    }

    function tryb(rekord, edycja) {
      pola(rekord).forEach(function (p) { p.disabled = !edycja; });
      var edycjaBlok = rekord.querySelector("[data-edycja]");
      if (edycjaBlok) edycjaBlok.style.display = edycja ? "" : "none";
      var przyciski = {
        edytuj: rekord.querySelector("[data-edytuj]"),
        zapisz: rekord.querySelector("[data-zapisz]"),
        anuluj: rekord.querySelector("[data-anuluj]"),
        usun: rekord.querySelector("[data-usun]"),
      };
      // W trakcie edycji dziala WYLACZNIE ptaszek i odrzucenie zmian. Olowek
      // i krzyzyk gasna, zeby nie dalo sie skasowac wiersza w polowie wpisywania.
      if (przyciski.edytuj) przyciski.edytuj.disabled = edycja;
      if (przyciski.zapisz) przyciski.zapisz.disabled = !edycja;
      if (przyciski.anuluj) przyciski.anuluj.hidden = !edycja;
      if (przyciski.usun) przyciski.usun.disabled = edycja;
      rekord.dataset.edycja = edycja ? "1" : "";
      if (edycja) {
        var pierwsze = pola(rekord)[0];
        if (pierwsze) pierwsze.focus();
      }
    }

    function zapamietaj(rekord) {
      rekord.dataset.zapisane = JSON.stringify(pola(rekord).map(function (p) { return p.value; }));
    }

    function przywroc(rekord) {
      var stare = rekord.dataset.zapisane ? JSON.parse(rekord.dataset.zapisane) : null;
      if (!stare) return;
      pola(rekord).forEach(function (p, i) { p.value = stare[i]; });
    }

    var ETYKIETA = { fixed: "składnik", variant: "wariant", option: "dodatek" };

    /** Podglad wiersza przepisujemy z pol, zeby nie trzymac dwoch prawd naraz. */
    function odswiezPodglad(rekord) {
      pola(rekord).forEach(function (p) {
        var cel = rekord.querySelector('[data-podglad="' + p.dataset.pole + '"]');
        if (!cel) return;
        var wartosc = p.value;
        if (p.dataset.pole === "kind") wartosc = ETYKIETA[p.value] || p.value;
        if (p.dataset.pole === "groupKey") wartosc = p.value || "wybor";
        if (p.dataset.pole === "unitPln") wartosc = p.value || "-";
        cel.textContent = wartosc;
        if (p.dataset.pole === "description") cel.hidden = !p.value;
      });
    }

    /** Nazwa przelacznika bierze sie z nazwy grupy: przegladarka laczy przelaczniki
     *  w jeden wybor WYLACZNIE po nazwie pola. */
    function nazwaGrupy(klucz) {
      return "pickGroup_" + String(klucz || "wybor").replace(/[^A-Za-z0-9_-]/g, "_");
    }

    /**
     * Kontrolka wyboru zgodna z rodzajem pozycji. Wymieniamy caly element, bo
     * przelacznika nie da sie zamienic w pole zaznaczane inaczej; po zmianie
     * rodzaju trzeba tez podpiac nasluch od nowa.
     */
    function ustawKontrolke(rekord, poz) {
      var miejsce = rekord.querySelector("[data-wybor-miejsce]");
      if (!miejsce) return;
      var rodzaj = poz.kind || "fixed";
      var teraz = miejsce.querySelector("[data-wybor]");
      var typ = rodzaj === "variant" ? "radio" : rodzaj === "option" ? "checkbox" : null;

      if (!typ) {
        miejsce.innerHTML = '<span class="block w-3 h-3 rounded-full border border-white/20"></span>';
        return;
      }
      if (teraz && teraz.type === typ) {
        teraz.checked = Boolean(poz.selected);
        if (typ === "radio") teraz.name = nazwaGrupy(poz.groupKey);
        return;
      }
      var nowa = document.createElement("input");
      nowa.type = typ;
      nowa.setAttribute("data-wybor", "");
      nowa.className = "accent-amber-400";
      nowa.checked = Boolean(poz.selected);
      if (typ === "radio") nowa.name = nazwaGrupy(poz.groupKey);
      miejsce.innerHTML = "";
      miejsce.appendChild(nowa);
      nowa.addEventListener("change", function () { zapiszWybor(nowa); });
    }

    /** Lista podpowiedzi grup: to, co juz stoi przy innych pozycjach. */
    function odswiezGrupy(pozycje) {
      var lista = document.getElementById("karty");
      if (!lista) return;
      var nazwy = [];
      (pozycje || []).forEach(function (p) {
        var k = (p.groupKey || "").trim();
        if (k && nazwy.indexOf(k) < 0) nazwy.push(k);
      });
      lista.innerHTML = nazwy.map(function (k) {
        return '<option value="' + k.replace(/"/g, "&quot;") + '"></option>';
      }).join("");

      // Te same nazwy jako przyciski przy kazdym polu grupy. Klikniecie wpisuje
      // nazwe jeden do jednego, wiec grupa nie rozpada sie na dwie przez
      // literowke albo wielka litere.
      document.querySelectorAll("[data-podpowiedzi-grup]").forEach(function (miejsce) {
        var wlasne = miejsce.parentElement.querySelector('[data-pole="groupKey"]');
        miejsce.innerHTML = "";
        nazwy.forEach(function (k) {
          var b = document.createElement("button");
          b.type = "button";
          b.textContent = k;
          b.className = "px-1.5 py-0.5 rounded border border-white/10 text-neutral-400 text-[10px] hover:text-white hover:border-white/30 transition-colors";
          b.addEventListener("click", function () {
            if (wlasne && !wlasne.disabled) wlasne.value = k;
          });
          miejsce.appendChild(b);
        });
      });
    }

    /**
     * Przerysowanie wierszy z odpowiedzi serwera.
     *
     * Zapis jednej pozycji potrafi przestawic inne: wybor wariantu gasi
     * pozostale w grupie, zmiana rodzaju odbiera pozycji prawo do zaznaczenia,
     * a swiezy dodatek wchodzi zaznaczony. Bez tego kroku ekran pokazywal stan
     * sprzed zapisu az do odswiezenia strony.
     */
    function odswiezWiersze(pozycje) {
      (pozycje || []).forEach(function (poz) {
        var rekord = lista.querySelector('[data-rekord="pozycja"][data-id="' + poz.id + '"]');
        if (!rekord) return;

        ustawKontrolke(rekord, poz);
        var grupaMeta = rekord.querySelector('[data-meta="grupa"]');
        if (grupaMeta) grupaMeta.style.display = (poz.kind || "fixed") === "fixed" ? "none" : "";
        rekord.className = rekord.className.replace(/border-white\/(10|5)/, poz.selected ? "border-white/10" : "border-white/5");

        var podglady = {
          title: poz.title,
          qty: String(poz.qty),
          kind: ETYKIETA[poz.kind] || "składnik",
          groupKey: poz.groupKey || "wybor",
          description: poz.description || "",
          unitPln: poz.unitGrosze != null ? (poz.unitGrosze / 100).toFixed(2) : "-",
          line: poz.lineGrosze != null && poz.qty > 1 ? "razem " + (poz.lineGrosze / 100).toFixed(2) + " zł" : "",
        };
        Object.keys(podglady).forEach(function (klucz) {
          var cel = rekord.querySelector('[data-podglad="' + klucz + '"]');
          if (!cel) return;
          cel.textContent = podglady[klucz];
          if (klucz === "description") cel.hidden = !poz.description;
        });

        // Pola edycji tez, ale WYLACZNIE gdy rekord jest zamkniety: inaczej
        // zapis sasiedniego wiersza nadpisalby to, co ktos wlasnie wpisuje.
        if (!rekord.dataset.edycja) {
          var wartosci = {
            title: poz.title, qty: String(poz.qty), description: poz.description || "",
            unitPln: poz.unitGrosze != null ? (poz.unitGrosze / 100).toFixed(2) : "",
            kind: poz.kind || "fixed", groupKey: poz.groupKey || "",
          };
          pola(rekord).forEach(function (p) {
            if (wartosci[p.dataset.pole] !== undefined) p.value = wartosci[p.dataset.pole];
          });
          zapamietaj(rekord);
        }
      });
      odswiezGrupy(pozycje);
    }

    function odswiezNaglowek(dane) {
      if (!dane || !dane.quote) return;
      var suma = document.querySelector("[data-suma]");
      var stanOferty = document.querySelector("[data-stan]");
      var waluta = document.querySelector("[data-waluta]");
      if (suma) suma.textContent = dane.quote.totalGrosze != null
        ? (dane.quote.totalGrosze / 100).toFixed(2) + " zł" : "-";
      if (stanOferty) stanOferty.textContent = dane.quote.status;
      if (waluta) waluta.textContent = dane.quote.currency || "PLN";
    }

    async function wyslij(sciezka, tresc) {
      var odp = await fetch("/quotes/" + encodeURIComponent(ref) + sciezka, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(tresc),
      });
      var dane = await odp.json().catch(function () { return {}; });
      if (!odp.ok || !dane.ok) throw new Error(dane.error || ("Serwer odpowiedzial " + odp.status));
      return dane;
    }

    function czas() {
      var d = new Date();
      return ("0" + d.getHours()).slice(-2) + ":" + ("0" + d.getMinutes()).slice(-2);
    }

    async function zapiszRekord(rekord) {
      // Dwuklik w ptaszka przy NOWEJ pozycji zalozylby dwie pozycje, bo drugie
      // zadanie wyszloby, zanim pierwsze odda identyfikator. Blokada na czas
      // zapisu kosztuje nic i zamyka to na wszystkich rekordach naraz.
      if (rekord.dataset.zapisywanie) return;
      rekord.dataset.zapisywanie = "1";
      var naglowek = rekord.dataset.rekord === "naglowek";
      var tresc = {};
      pola(rekord).forEach(function (p) { tresc[p.dataset.pole] = p.value; });
      if (!naglowek && rekord.dataset.id) tresc.id = rekord.dataset.id;

      stan(rekord, "zapisuję...", "text-neutral-400");
      blad(rekord, "");
      try {
        var dane = await wyslij(naglowek ? "/header" : "/item", tresc);
        odswiezNaglowek(dane);
        if (!naglowek) {
          // Nowa pozycja dostaje identyfikator dopiero teraz. Bez przepisania
          // go kolejny zapis zalozylby druga pozycje zamiast poprawic te.
          if (!rekord.dataset.id && dane.items && dane.items.length) {
            rekord.dataset.id = dane.items[dane.items.length - 1].id;
          }
          odswiezPodglad(rekord);
        }
        zapamietaj(rekord);
        tryb(rekord, false);
        // Dopiero teraz, gdy rekord jest zamkniety: rodzaj pozycji, zaznaczenie
        // i kwoty przychodza z serwera i moga dotyczyc TAKZE innych wierszy.
        if (!naglowek) odswiezWiersze(dane.items);
        stan(rekord, "zapisano " + czas(), "text-emerald-400/70");
      } catch (e) {
        stan(rekord, "", "text-neutral-600");
        blad(rekord, e.message);
      } finally {
        rekord.dataset.zapisywanie = "";
      }
    }

    async function usunRekord(rekord) {
      var nazwa = rekord.querySelector('[data-podglad="title"]');
      if (!window.confirm("Usunąć pozycję „" + (nazwa ? nazwa.textContent : "") + "”? Tego nie da się cofnąć.")) return;
      if (!rekord.dataset.id) { rekord.remove(); return; }
      stan(rekord, "usuwam...", "text-neutral-400");
      try {
        var dane = await wyslij("/item", { id: rekord.dataset.id, remove: true });
        odswiezNaglowek(dane);
        rekord.remove();
        // Po usunieciu wariantu regula "jeden w grupie" wskazuje inny, wiec
        // reszta wierszy tez moze wygladac inaczej niz przed chwila.
        odswiezWiersze(dane.items);
      } catch (e) {
        stan(rekord, "", "text-neutral-600");
        blad(rekord, e.message);
      }
    }

    /** Kolko i kwadracik: klikniecie JEST decyzja, wiec idzie do bazy od razu. */
    async function zapiszWybor(input) {
      var rekord = input.closest("[data-rekord]");
      stan(rekord, "zapisuję...", "text-neutral-400");
      blad(rekord, "");
      try {
        var dane = await wyslij("/item", { id: rekord.dataset.id, selected: input.checked });
        odswiezNaglowek(dane);
        // Wybor wariantu gasi pozostale w grupie po stronie serwera, wiec stan
        // wszystkich wierszy bierzemy z odpowiedzi, a nie z klikniecia.
        odswiezWiersze(dane.items);
        stan(rekord, "zapisano " + czas(), "text-emerald-400/70");
      } catch (e) {
        stan(rekord, "", "text-neutral-600");
        blad(rekord, e.message);
        input.checked = !input.checked;
      }
    }

    function podepnij(rekord) {
      var edytuj = rekord.querySelector("[data-edytuj]");
      var zapisz = rekord.querySelector("[data-zapisz]");
      var anuluj = rekord.querySelector("[data-anuluj]");
      var usun = rekord.querySelector("[data-usun]");
      var wybor = rekord.querySelector("[data-wybor]");

      zapamietaj(rekord);
      if (!rekord.dataset.edycja) tryb(rekord, false);
      if (edytuj) edytuj.addEventListener("click", function () { tryb(rekord, true); });
      if (zapisz) zapisz.addEventListener("click", function () { zapiszRekord(rekord); });
      if (anuluj) anuluj.addEventListener("click", function () {
        przywroc(rekord);
        blad(rekord, "");
        tryb(rekord, false);
        stan(rekord, "");
      });
      if (usun) usun.addEventListener("click", function () { usunRekord(rekord); });
      if (wybor) wybor.addEventListener("change", function () { zapiszWybor(wybor); });

      // Enter w polu tekstowym zatwierdza rekord, Escape odrzuca zmiany.
      rekord.addEventListener("keydown", function (e) {
        if (!rekord.dataset.edycja) return;
        if (e.key === "Enter" && e.target.tagName !== "TEXTAREA") { e.preventDefault(); zapiszRekord(rekord); }
        if (e.key === "Escape") { przywroc(rekord); tryb(rekord, false); }
      });
    }

    document.querySelectorAll("[data-rekord]").forEach(podepnij);

    // Podpowiedzi grup buduje ta sama funkcja co po zapisie, zeby istnialo
    // jedno miejsce, ktore wie, jak wygladaja.
    odswiezGrupy(Array.prototype.map.call(lista.querySelectorAll('[data-rekord="pozycja"]'), function (r) {
      var pole = r.querySelector('[data-pole="groupKey"]');
      return { groupKey: pole ? pole.value : "" };
    }));

    // --- Nowa pozycja ---------------------------------------------------
    // Wiersz powstaje w przegladarce i trafia do bazy dopiero po zatwierdzeniu.
    // Zapis pustej pozycji od razu przy kliknieciu zostawialby po kazdej
    // pomylce wiersz bez nazwy i bez kwoty.
    var dodaj = document.querySelector("[data-dodaj]");
    if (dodaj) dodaj.addEventListener("click", function () {
      var wzor = lista.querySelector('[data-rekord="pozycja"]');
      if (!wzor) { window.location.reload(); return; }
      var nowy = wzor.cloneNode(true);
      nowy.removeAttribute("data-id");
      nowy.dataset.zapisane = "";
      nowy.querySelectorAll("[data-pole]").forEach(function (p) {
        if (p.dataset.pole === "qty") p.value = "1";
        else if (p.tagName === "SELECT") p.selectedIndex = 0;
        else p.value = "";
      });
      var w = nowy.querySelector("[data-wybor]");
      if (w) { w.checked = false; w.parentElement.innerHTML = '<span class="block w-3 h-3 rounded-full border border-white/20"></span>'; }
      nowy.querySelectorAll("[data-podglad]").forEach(function (el) { el.textContent = ""; });
      var podgladTytulu = nowy.querySelector('[data-podglad="title"]');
      if (podgladTytulu) podgladTytulu.textContent = "Nowa pozycja";
      var szczegoly = nowy.querySelector("details");
      if (szczegoly) szczegoly.remove();
      blad(nowy, "");
      stan(nowy, "niezapisana", "text-amber-300/80");
      lista.appendChild(nowy);
      podepnij(nowy);
      tryb(nowy, true);
    });

    // Wyjscie ze strony w trakcie edycji gubi to, co wpisane. Ostrzegamy,
    // bo bez przycisku "zapisz" latwo uznac, ze wszystko juz poszlo do bazy.
    window.addEventListener("beforeunload", function (e) {
      if (document.querySelector('[data-rekord][data-edycja="1"]')) { e.preventDefault(); e.returnValue = ""; }
    });
  })();
  </script>
</body>
</html>
