      "typeVersion": 3,
      "position": [220, 0],
      "notes": "Tworzy podfolder o nazwie numeru zamowienia wewnatrz AEJaCA / Zamowienia."
    },
    {
      "parameters": {
        "fieldToSplitOut": "body.files",
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Rozbij na pliki",
