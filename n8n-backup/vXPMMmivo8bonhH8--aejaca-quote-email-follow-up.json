      "name": "Prepare Attachment",
      "parameters": {
        "jsCode": "const body = $('Webhook — Quote Received').item.json.body;\nconst output = { json: { body, hasFile: !!(body.file && body.file.data) }, binary: {} };\nif (body.file && body.file.data) {\n  const base64 = body.file.data.replace(/^data:[^;]+;base64,/, '');\n  output.binary.attachment = await this.helpers.prepareBinaryData(\n    Buffer.from(base64, 'base64'),\n    body.file.name || 'attachment',\n    body.file.type || 'application/octet-stream'\n  );\n}\nreturn [output];"
      },
