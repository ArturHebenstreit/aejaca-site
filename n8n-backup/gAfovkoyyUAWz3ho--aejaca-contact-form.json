    {
      "id": "54049ef8-07d6-4d2b-ab29-516c62739075",
      "name": "Prepare Attachment",
      "parameters": {
        "jsCode": "const body = $('Webhook — Contact Form').item.json.body;\n\n// Formularz kalkulatora wysyla liste pod `files`, starsze karty jedno pole\n// `file`. Czytanie samego `file` znaczylo, ze zalacznik drugi i dalsze nie\n// trafialy do folderu na Dysku. Wlasciciel widzial folder z jednym plikiem\n// i nie mial jak sie domyslic, ze klient przyslal wiecej.\nconst pliki = (Array.isArray(body.files) && body.files.length\n  ? body.files\n  : (body.file ? [body.file] : [])).filter((f) => f && f.data);\n\n// Binarki tu nie budujemy: nikt jej dalej nie czyta, a przy szesciu plikach\n// trzymalibysmy caly komplet drugi raz w pamieci.\nreturn [{\n  json: {\n    name: body.name || '',\n    email: body.email || '',\n    subject: body.subject || '',\n    message: body.message || '',\n    lang: body.lang || 'pl',\n    source: body.source || 'contact',\n    hasFile: pliki.length > 0,\n    fileCount: pliki.length,\n    fileName: pliki.map((f) => f.name || 'attachment').join(', '),\n    ts: new Date().toISOString(),\n  },\n}];",
        "mode": "runOnceForAllItems"
      },
      "position": [
        448,
        192
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
