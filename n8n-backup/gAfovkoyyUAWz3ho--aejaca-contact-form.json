    {
      "id": "f73c9d74-41f8-4d53-a299-605a17b6c1dd",
      "name": "Strip Binary",
      "parameters": {
        "jsCode": "// Wezel Dysku oddaje jedna pozycje na wgrany plik. Bez zwiniecia do jednej\n// wlasciciel dostalby tyle osobnych powiadomien, ile zalacznikow.\n// `uploadName` zostaje tutaj, bo dotyczy pojedynczego pliku, a mail mowi\n// o calym zapytaniu.\nconst { uploadName, ...reszta } = $('Prepare File for Upload').first().json;\nreturn [{ json: reszta }];"
      },
