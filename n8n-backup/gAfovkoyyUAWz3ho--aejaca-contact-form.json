    {
      "id": "7cbc1e70-7b9d-4208-9134-9f44eb0cea8e",
      "name": "Prepare File for Upload",
      "parameters": {
        "jsCode": "const body = $('Webhook — Contact Form').item.json.body;\nconst wspolne = $('Prepare Attachment').first().json;\nconst folderId = $json.id;\nconst folderName = $json.name;\n\nconst pliki = (Array.isArray(body.files) && body.files.length\n  ? body.files\n  : (body.file ? [body.file] : [])).filter((f) => f && f.data);\n\n// JEDNA POZYCJA NA PLIK. Wezel Dysku wysyla tyle plikow, ile dostanie\n// pozycji, wiec to jest cale miejsce, w ktorym rozstrzyga sie, czy komplet\n// wyladuje w folderze.\nconst wynik = [];\nfor (const f of pliki) {\n  const base64 = String(f.data).replace(/^data:[^;]+;base64,/, '');\n  const binarka = await this.helpers.prepareBinaryData(\n    Buffer.from(base64, 'base64'),\n    f.name || 'attachment',\n    f.type || 'application/octet-stream'\n  );\n  wynik.push({\n    json: {\n      folderId,\n      folderName,\n      name: wspolne.name,\n      email: wspolne.email,\n      subject: wspolne.subject,\n      message: wspolne.message,\n      lang: wspolne.lang,\n      source: wspolne.source,\n      fileName: wspolne.fileName,\n      fileCount: wspolne.fileCount,\n      uploadName: f.name || 'attachment',\n    },\n    binary: { data: binarka },\n  });\n}\nreturn wynik;"
      },
      "position": [
        1120,
        0
      ],
      "type": "n8n-nodes-base.code",
      "typeVersion": 2
    },
